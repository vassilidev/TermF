{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermF",
  "version": "0.6.3",
  "identifier": "dev.termf.app",
  "build": {
    "beforeDevCommand": "cargo build -p termf-cli && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TermF",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TermF",
    "copyright": "Copyright © 2026 TermF contributors",
    "category": "DeveloperTool",
    "shortDescription": "The cockpit for Claude Code across all your repositories",
    "longDescription": "Talk to the CTO, and a team of agents takes your tickets to pull requests, each run in its own worktree, stopping for your approval at every gate. Every Claude Code stays in view, in terminal tabs and splits. Local-first, built with Rust and Tauri.",
    "homepage": "https://vassilidev.github.io/TermF/",
    "license": "MIT",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": [
          "English",
          "French"
        ],
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "language": [
          "en-US",
          "fr-FR"
        ],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "section": "devel",
        "recommends": [
          "git"
        ],
        "desktopTemplate": "installer/termf.desktop",
        "files": {
          "/usr/share/metainfo/dev.termf.app.metainfo.xml": "installer/dev.termf.app.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "git"
        ],
        "desktopTemplate": "installer/termf.desktop",
        "files": {
          "/usr/share/metainfo/dev.termf.app.metainfo.xml": "installer/dev.termf.app.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/dev.termf.app.metainfo.xml": "installer/dev.termf.app.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NDU2RUEwQjNDODcyOEEKUldTS2NzaXpvRzVGZDdsaDhjTjY3ZHlDL3BTTThxU2VOSmU2cXZQdTZKNTlCZ0FLc2RmZ1QwVXoK"
    }
  }
}
