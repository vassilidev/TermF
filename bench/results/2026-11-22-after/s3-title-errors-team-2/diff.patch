@@ -69,5 +73,116 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+async function raw(method: string, path: string, text: string) {
+  const res = await fetch(base + path, { method, headers: { "content-type": "application/json" }, body: text });
+  return { status: res.status, body: await res.json() };
+}
+
+const count = async () => (await call("GET", "/api/tasks")).body.length;
+const REQUIRED = { error: "title is required" };
+const TOO_LONG = { error: "title must be at most 200 characters" };
+
+for (const [name, body] of [
+  ["missing title", {}],
+  ["empty title", { title: "" }],
+  ["blank title", { title: "   " }],
+  ["numeric title", { title: 123 }],
+  ["null title", { title: null }],
+  ["null body", null],
+  ["array body", []],
+] as const) {
+  test(`POST with ${name} is a 400 and creates nothing`, async () => {
+    const before = await count();
+    const res = await raw("POST", "/api/tasks", JSON.stringify(body));
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, REQUIRED);
+    assert.equal(await count(), before);
+  });
+}
+
+test("POST with a title over 200 characters is a 400 and creates nothing", async () => {
+  const before = await count();
+  const res = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(res.status, 400);
+  assert.deepEqual(res.body, TOO_LONG);
+  assert.equal(await count(), before);
+});
+
+test("POST accepts exactly 200 characters, also with surrounding spaces, saved trimmed", async () => {
+  const res = await call("POST", "/api/tasks", { title: `  ${"a".repeat(200)}  ` });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.title, "a".repeat(200));
+});
+
+test("POST saves the title trimmed", async () => {
+  const res = await call("POST", "/api/tasks", { title: " padded " });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.title, "padded");
+});
+
+for (const [name, title] of [["empty", ""], ["blank", "  "], ["numeric", 5], ["null", null]] as const) {
+  test(`PATCH with a ${name} title is a 400 and leaves the task unchanged`, async () => {
+    const task = (await call("POST", "/api/tasks", { title: "Keep me" })).body;
+    const res = await call("PATCH", `/api/tasks/${task.id}`, { title, done: true });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, REQUIRED);
+    assert.deepEqual((await call("GET", `/api/tasks/${task.id}`)).body, task);
+  });
+}
+
+test("PATCH with a title over 200 characters is a 400 and leaves the task unchanged", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Keep me" })).body;
+  const res = await call("PATCH", `/api/tasks/${task.id}`, { title: "a".repeat(201) });
+  assert.equal(res.status, 400);
+  assert.deepEqual(res.body, TOO_LONG);
+  assert.deepEqual((await call("GET", `/api/tasks/${task.id}`)).body, task);
+});
+
+test("PATCH saves a valid title trimmed", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Old" })).body;
+  const res = await call("PATCH", `/api/tasks/${task.id}`, { title: "  New  " });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.title, "New");
+});
+
+test("PATCH with only done still works and keeps the title", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Only done" })).body;
+  const res = await call("PATCH", `/api/tasks/${task.id}`, { done: true });
