+  for (const [method, path] of [["POST", "/api/tasks"], ["PATCH", `/api/tasks/${task.id}`]]) {
+    const res = await raw(method, path, "{not json");
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "invalid JSON body" });
+  }
+});
+
+test("an unexpected error is a 500 'internal error' without the internal message, and is logged", async (t) => {
+  const logged = t.mock.method(console, "error", () => {});
+  const dir = mkdtempSync(join(tmpdir(), "tasks-test-"));
+  const path = join(dir, "db.sqlite");
+  const broken = createServer(path);
+  await new Promise<void>((resolve) => broken.listen(0, "127.0.0.1", resolve));
+  t.after(() => {
+    broken.close();
+    rmSync(dir, { recursive: true, force: true });
+  });
+  // another connection drops the table: the next query fails inside the database
+  const other = new DatabaseSync(path);
+  other.exec("DROP TABLE tasks");
+  other.close();
+  const res = await fetch(`http://127.0.0.1:${(broken.address() as any).port}/api/tasks`);
+  const text = await res.text();
+  assert.equal(res.status, 500);
+  assert.deepEqual(JSON.parse(text), { error: "internal error" });
+  assert.doesNotMatch(text, /no such table/);
+  assert.equal(logged.mock.callCount(), 1);
+});
