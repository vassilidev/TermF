+  return { status: res.status, body: await res.json() };
+}
+
+const REQUIRED = { error: "title is required" };
+const TOO_LONG = { error: "title must be at most 200 characters" };
+const BAD_JSON = { error: "invalid JSON body" };
+const badTitles: unknown[] = [undefined, "", "   ", null, 123, ["a"]];
+
+test("POST without a usable title is a 400 and creates nothing", async () => {
+  const before = (await call("GET", "/api/tasks")).body.length;
+  for (const title of badTitles) {
+    const res = await call("POST", "/api/tasks", title === undefined ? {} : { title });
+    assert.equal(res.status, 400, JSON.stringify(title));
+    assert.deepEqual(res.body, REQUIRED);
