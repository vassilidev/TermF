+  assert.equal((await call("GET", "/api/tasks")).body.length, before);
+});
+
+test("POST title length: 201 is refused, 200 is accepted, titles are trimmed", async () => {
+  const long = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, TOO_LONG);
+  assert.equal((await call("POST", "/api/tasks", { title: "a".repeat(200) })).status, 201);
+  const spaced = await call("POST", "/api/tasks", { title: `  ${"b".repeat(200)}  ` });
+  assert.equal(spaced.status, 201);
+  assert.equal(spaced.body.title, "b".repeat(200));
+  const padded = await call("POST", "/api/tasks", { title: "  padded  " });
+  assert.equal(padded.body.title, "padded");
+  const list = await call("GET", "/api/tasks");
+  assert.ok(list.body.some((t: any) => t.title === "padded"));
+});
+
+test("PATCH with a bad title is a 400 and changes nothing", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Keep me" });
+  const path = `/api/tasks/${created.body.id}`;
+  for (const title of badTitles.filter((t) => t !== undefined)) {
+    const res = await call("PATCH", path, { title });
+    assert.equal(res.status, 400, JSON.stringify(title));
+    assert.deepEqual(res.body, REQUIRED);
+  }
+  const long = await call("PATCH", path, { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, TOO_LONG);
