+export class ValidationError extends Error {}
+
+const DUE_DATE_MESSAGE = "due_date must be a date in YYYY-MM-DD format";
+
+/** undefined (absent) and null (none) pass through; a string must be a real YYYY-MM-DD date; anything else throws. */
+export function parseDueDate(value: unknown): string | null | undefined {
+  if (value === undefined || value === null) return value;
+  if (typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [y, m, d] = value.split("-").map(Number);
+    const date = new Date(Date.UTC(y, m - 1, d));
+    if (date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d) return value;
+  }
+  throw new ValidationError(DUE_DATE_MESSAGE);
+}
+
+const toTask = (row: Row): Task => ({ ...row, done: row.done === 1, due_date: row.due_date ?? null });
 
 export function listTasks(db: Db, filter: { done?: string } = {}): Task[] {
   if (filter.done === undefined) {
     return (db.prepare("SELECT * FROM tasks ORDER BY id").all() as Row[]).map(toTask);
   }
