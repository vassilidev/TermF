+export class ValidationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ValidationError";
+  }
+}
+
+const MAX_TITLE = 200;
+
+/** The trimmed title, or a ValidationError when it is not a non-empty string of at most 200 characters. */
+export function parseTitle(value: unknown): string {
+  if (typeof value !== "string" || value.trim() === "") throw new ValidationError("title is required");
+  const title = value.trim();
+  if (title.length > MAX_TITLE) throw new ValidationError("title must be at most 200 characters");
+  return title;
+}
+
+export function createTask(db: Db, rawTitle: unknown): Task {
+  const title = parseTitle(rawTitle);
