diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 1fa1bd8..19fa164 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -69,5 +69,96 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+async function raw(method: string, path: string, body: string) {
+  const res = await fetch(base + path, { method, headers: { "content-type": "application/json" }, body });
+  return { status: res.status, body: await res.json() };
+}
+
+const count = async () => (await call("GET", "/api/tasks")).body.length;
+
+test("POST with a missing, empty, blank or non-string title is a 400 and creates nothing", async () => {
+  const before = await count();
+  for (const body of [{}, { title: "" }, { title: "   " }, { title: 123 }, { title: null }]) {
+    const res = await call("POST", "/api/tasks", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  const empty = await raw("POST", "/api/tasks", "");
+  assert.equal(empty.status, 400);
+  assert.deepEqual(empty.body, { error: "title is required" });
+  assert.equal(await count(), before);
+});
+
+test("title length: 201 is refused, 200 is accepted, titles are saved trimmed", async () => {
+  const before = await count();
+  const long = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, { error: "title must be at most 200 characters" });
+  assert.equal(await count(), before);
+  assert.equal((await call("POST", "/api/tasks", { title: "a".repeat(200) })).status, 201);
+  const padded = await call("POST", "/api/tasks", { title: `  ${"b".repeat(200)}  ` });
+  assert.equal(padded.status, 201);
+  assert.equal(padded.body.title, "b".repeat(200));
+  assert.equal((await call("POST", "/api/tasks", { title: "  x  " })).body.title, "x");
+});
+
+test("PATCH with a bad title is a 400 and leaves the task unchanged", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Keep me" })).body;
+  for (const title of ["", "   ", null, 5]) {
+    const res = await call("PATCH", `/api/tasks/${task.id}`, { title, done: true });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  const long = await call("PATCH", `/api/tasks/${task.id}`, { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, { error: "title must be at most 200 characters" });
+  assert.deepEqual((await call("GET", `/api/tasks/${task.id}`)).body, task);
+});
+
+test("PATCH without a title still works, and a valid title is saved trimmed", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Stay" })).body;
+  const done = await call("PATCH", `/api/tasks/${task.id}`, { done: true });
+  assert.equal(done.status, 200);
+  assert.equal(done.body.title, "Stay");
+  assert.equal(done.body.done, true);
+  const renamed = await call("PATCH", `/api/tasks/${task.id}`, { title: "  New  " });
+  assert.equal(renamed.body.title, "New");
+});
+
+test("a body that is not a JSON object is a 400 on POST and PATCH", async () => {
+  const task = (await call("POST", "/api/tasks", { title: "Target" })).body;
+  const before = await count();
+  for (const text of ["{bad", "null", "[]", "5", '"x"']) {
+    for (const [method, path] of [["POST", "/api/tasks"], ["PATCH", `/api/tasks/${task.id}`]]) {
+      const res = await raw(method, path, text);
+      assert.equal(res.status, 400, `${method} ${text}`);
+      assert.deepEqual(res.body, { error: "invalid JSON body" });
+    }
+  }
+  assert.equal(await count(), before);
+});
+
+test("an unexpected error is a 500 'internal error' that hides the real message and is logged", async (t) => {
+  const broken = createServer();
+  await new Promise<void>((resolve) => broken.listen(0, "127.0.0.1", resolve));
+  const url = `http://127.0.0.1:${(broken.address() as any).port}/api/tasks`;
+  const logged: unknown[] = [];
+  t.mock.method(console, "error", (...args: unknown[]) => logged.push(...args));
+  broken.emit("close"); // closes the database behind the running server
+  broken.removeAllListeners("close");
+  try {
+    const res = await fetch(url);
+    const text = await res.text();
+    assert.equal(res.status, 500);
+    assert.deepEqual(JSON.parse(text), { error: "internal error" });
+    assert.equal(logged.length, 1);
+    const internal = (logged[0] as Error).message;
+    assert.ok(internal.length > 0);
+    assert.ok(!text.includes(internal));
+  } finally {
+    broken.close();
+  }
+});
