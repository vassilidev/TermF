+export function normalizeTag(name: unknown): string | undefined {
+  if (typeof name !== "string") return undefined;
+  const tag = name.trim().toLowerCase();
+  return TAG_PATTERN.test(tag) ? tag : undefined;
+}
+
+/** A list of tags, normalized, deduplicated and sorted; undefined when the input is invalid. */
+export function normalizeTags(input: unknown): string[] | undefined {
+  if (!Array.isArray(input)) return undefined;
+  const tags = new Set<string>();
+  for (const item of input) {
+    const tag = normalizeTag(item);
+    if (tag === undefined) return undefined;
+    tags.add(tag);
+  }
+  if (tags.size > MAX_TAGS) return undefined;
+  return [...tags].sort();
