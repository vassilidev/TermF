+test("deleting a task removes its rows from task_tags in the database", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "tags-qa-"));
+  const path = join(dir, "tasks.db");
+  const db = openDb(path);
+  try {
+    const kept = createTask(db, "Kept", ["home", "work"]);
+    const gone = createTask(db, "Gone", ["home"]);
+    assert.ok(deleteTask(db, gone.id));
+    const links = db.prepare("SELECT task_id FROM task_tags").all() as { task_id: number }[];
+    assert.deepEqual(links.map((l) => l.task_id), [kept.id, kept.id]);
+  } finally {
+    db.close();
+    rmSync(dir, { recursive: true });
+  }
+});
