+test("a tag disappears from /api/tags once untagged or its last task is deleted", async () => {
+  const a = await call("POST", "/api/tasks", { title: "a", tags: ["gone-1", "gone-2"] });
+  const b = await call("POST", "/api/tasks", { title: "b", tags: ["gone-2"] });
+  const gone = async () => (await call("GET", "/api/tags")).body.filter((t: any) => t.name.startsWith("gone-"));
+  assert.deepEqual(await gone(), [{ name: "gone-1", count: 1 }, { name: "gone-2", count: 2 }]);
+  await call("PATCH", `/api/tasks/${a.body.id}`, { tags: ["gone-2"] });
+  assert.deepEqual(await gone(), [{ name: "gone-2", count: 2 }]);
+  await call("DELETE", `/api/tasks/${b.body.id}`);
+  assert.deepEqual(await gone(), [{ name: "gone-2", count: 1 }]);
+  await call("DELETE", `/api/tasks/${a.body.id}`);
+  assert.deepEqual(await gone(), []);
+});
