diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..63b93e5
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,91 @@
+import { createHash, randomBytes, scrypt, timingSafeEqual } from "node:crypto";
+import type { Db } from "./db.ts";
+
+const KEY_LENGTH = 64;
+const USERNAME = /^[a-z0-9_]{3,32}$/;
+export const MIN_PASSWORD_LENGTH = 10;
+
+export interface User {
+  id: number;
+  username: string;
+}
+
+export class ValidationError extends Error {}
+export class UsernameTakenError extends Error {}
+
+const deriveKey = (password: string, salt: Buffer): Promise<Buffer> =>
+  new Promise((resolve, reject) => {
+    scrypt(password.normalize("NFKC"), salt, KEY_LENGTH, (err: Error | null, key: Buffer) =>
+      err ? reject(err) : resolve(key),
+    );
+  });
+
+/** "salt:hash", both hex. The salt is random per password. */
+async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  return `${salt.toString("hex")}:${(await deriveKey(password, salt)).toString("hex")}`;
+}
+
+async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const [salt, hash] = stored.split(":");
+  const expected = Buffer.from(hash, "hex");
+  const actual = await deriveKey(password, Buffer.from(salt, "hex"));
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+// Checked against when the username is unknown, so that an unknown user costs as much time as a wrong password.
+const dummyHash = hashPassword("not-a-real-password");
+
+const hashToken = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+export async function createUser(db: Db, username: unknown, password: unknown): Promise<User> {
+  const name = typeof username === "string" ? username.toLowerCase() : "";
+  if (!USERNAME.test(name)) throw new ValidationError("invalid username");
+  if (typeof password !== "string" || password.length < MIN_PASSWORD_LENGTH) {
+    throw new ValidationError("password too short");
+  }
+  if (db.prepare("SELECT 1 FROM users WHERE username = ?").get(name)) throw new UsernameTakenError();
+  const hash = await hashPassword(password);
+  try {
+    const { lastInsertRowid } = db.prepare("INSERT INTO users (username, password_hash) VALUES (?, ?)").run(name, hash);
+    return { id: Number(lastInsertRowid), username: name };
+  } catch (err: any) {
+    // Lost a race with another sign-up of the same name (the column is UNIQUE).
+    if (/UNIQUE/i.test(String(err?.message))) throw new UsernameTakenError();
+    throw err;
+  }
+}
+
+/** Signs in: returns a new session token, or undefined for a wrong username or password. */
+export async function login(db: Db, username: unknown, password: unknown): Promise<string | undefined> {
+  const name = typeof username === "string" ? username.toLowerCase() : "";
+  const pass = typeof password === "string" ? password : "";
+  const row = USERNAME.test(name)
+    ? (db.prepare("SELECT id, password_hash FROM users WHERE username = ?").get(name) as
+        | { id: number; password_hash: string }
+        | undefined)
+    : undefined;
+  const ok = await verifyPassword(pass, row?.password_hash ?? (await dummyHash));
+  if (!row || !ok) return undefined;
+  const token = randomBytes(32).toString("base64url");
+  db.prepare("INSERT INTO sessions (token_hash, user_id) VALUES (?, ?)").run(hashToken(token), row.id);
+  return token;
+}
+
+/** The token of an `Authorization: Bearer <token>` header, if well formed. */
+export function bearerToken(header: unknown): string | undefined {
+  if (typeof header !== "string") return undefined;
+  return /^Bearer ([A-Za-z0-9_-]{1,512})$/.exec(header)?.[1];
+}
+
+export function userForToken(db: Db, token: string): User | undefined {
+  return db
+    .prepare(
+      "SELECT users.id AS id, users.username AS username FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.token_hash = ?",
+    )
+    .get(hashToken(token)) as User | undefined;
+}
+
+export function logout(db: Db, token: string): void {
+  db.prepare("DELETE FROM sessions WHERE token_hash = ?").run(hashToken(token));
+}
