diff --git a/src/tasks.ts b/src/tasks.ts
index 4fd5acb..3ab8d62 100644
--- a/src/tasks.ts
+++ b/src/tasks.ts
@@ -14,11 +14,11 @@ interface Row {
   created_at: string;
 }
 
 const toTask = (row: Row): Task => ({ ...row, done: row.done === 1 });
 
-export function listTasks(db: Db, filter: { done?: string } = {}): Task[] {
+export function listTasks(db: Db, filter: { done?: boolean } = {}): Task[] {
   if (filter.done === undefined) {
     return (db.prepare("SELECT * FROM tasks ORDER BY id").all() as Row[]).map(toTask);
   }
   const rows = db.prepare("SELECT * FROM tasks WHERE done = ? ORDER BY id").all(filter.done ? 1 : 0) as Row[];
   return rows.map(toTask);
diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 1fa1bd8..d0b56d5 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -69,5 +69,45 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+async function makeOpenAndDone() {
+  const open = await call("POST", "/api/tasks", { title: "Open one" });
+  const done = await call("POST", "/api/tasks", { title: "Done one" });
+  await call("PATCH", `/api/tasks/${done.body.id}`, { done: true });
+  return { openId: open.body.id, doneId: done.body.id };
+}
+
+test("done=false lists only open tasks", async () => {
+  const { openId, doneId } = await makeOpenAndDone();
+  const list = await call("GET", "/api/tasks?done=false");
+  assert.equal(list.status, 200);
+  assert.ok(list.body.some((t: any) => t.id === openId));
+  assert.ok(!list.body.some((t: any) => t.id === doneId));
+  assert.ok(list.body.every((t: any) => t.done === false));
+});
+
+test("done=true lists only done tasks", async () => {
+  const { openId, doneId } = await makeOpenAndDone();
+  const list = await call("GET", "/api/tasks?done=true");
+  assert.equal(list.status, 200);
+  assert.ok(list.body.some((t: any) => t.id === doneId));
+  assert.ok(!list.body.some((t: any) => t.id === openId));
+  assert.ok(list.body.every((t: any) => t.done === true));
+});
+
+test("without done, every task is listed", async () => {
+  const { openId, doneId } = await makeOpenAndDone();
+  const list = await call("GET", "/api/tasks");
+  assert.ok(list.body.some((t: any) => t.id === openId));
+  assert.ok(list.body.some((t: any) => t.id === doneId));
+});
+
+for (const value of ["yes", "", "TRUE"]) {
+  test(`done=${JSON.stringify(value)} answers 400`, async () => {
+    const res = await call("GET", `/api/tasks?done=${value}`);
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "done must be true or false" });
+  });
+}
