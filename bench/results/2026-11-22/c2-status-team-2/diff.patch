+  const { body } = await call("POST", "/api/tasks", { title: "Bool" });
+  for (const done of ["true", 1, null]) {
+    const res = await call("PATCH", `/api/tasks/${body.id}`, { done });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "done must be a boolean" });
+  }
+});
+
+test("PATCH of the title alone keeps the status", async () => {
+  const { body } = await call("POST", "/api/tasks", { title: "Keep", status: "doing" });
+  const res = await call("PATCH", `/api/tasks/${body.id}`, { title: "Kept" });
+  assert.equal(res.body.status, "doing");
+  assert.equal(res.body.title, "Kept");
+});
+
+test("GET ?status= lists only that status, and an unknown value is a 400", async () => {
+  await call("POST", "/api/tasks", { title: "A", status: "todo" });
+  await call("POST", "/api/tasks", { title: "B", status: "doing" });
+  await call("POST", "/api/tasks", { title: "C", status: "done" });
+  for (const status of ["todo", "doing", "done"]) {
+    const list = await call("GET", `/api/tasks?status=${status}`);
+    assert.equal(list.status, 200);
+    assert.ok(list.body.length > 0);
+    assert.ok(list.body.every((t: any) => t.status === status));
+  }
+  for (const q of ["status=nope", "status="]) {
+    const bad = await call("GET", `/api/tasks?${q}`);
+    assert.equal(bad.status, 400);
+    assert.deepEqual(bad.body, BAD_STATUS);
+  }
+});
+
+test("?done=false lists todo and doing tasks, ?done=true only done ones", async () => {
+  await call("POST", "/api/tasks", { title: "T", status: "todo" });
+  await call("POST", "/api/tasks", { title: "D", status: "doing" });
+  await call("POST", "/api/tasks", { title: "X", status: "done" });
+  const open = await call("GET", "/api/tasks?done=false");
+  const statuses = new Set(open.body.map((t: any) => t.status));
+  assert.deepEqual([...statuses].sort(), ["doing", "todo"]);
+  assert.ok(open.body.every((t: any) => t.done === false));
+  const closed = await call("GET", "/api/tasks?done=true");
+  assert.ok(closed.body.length > 0);
+  assert.ok(closed.body.every((t: any) => t.status === "done" && t.done === true));
+});
+
+test("?done= other than true or false is a 400; ?status= wins over ?done=", async () => {
+  const bad = await call("GET", "/api/tasks?done=maybe");
+  assert.equal(bad.status, 400);
+  assert.deepEqual(bad.body, { error: "done must be true or false" });
+  const both = await call("GET", "/api/tasks?status=doing&done=true");
+  assert.equal(both.status, 200);
+  assert.ok(both.body.every((t: any) => t.status === "doing"));
+});
+
+test("every task in a list has both status and done", async () => {
+  const list = await call("GET", "/api/tasks");
+  assert.ok(list.body.every((t: any) => ["todo", "doing", "done"].includes(t.status) && typeof t.done === "boolean"));
+});
+
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
