+++ b/test/migration.test.ts
@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { migrate, openDb } from "../src/db.ts";
+
+// The schema exactly as migration 1 shipped it.
+function databaseAtVersion1() {
+  const db = new DatabaseSync(":memory:");
+  db.exec(`CREATE TABLE tasks (
+     id INTEGER PRIMARY KEY AUTOINCREMENT,
+     title TEXT NOT NULL,
+     done INTEGER NOT NULL DEFAULT 0,
+     created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+   )`);
+  db.exec("PRAGMA user_version = 1");
+  const insert = db.prepare("INSERT INTO tasks (id, title, done, created_at) VALUES (?, ?, ?, ?)");
+  insert.run(3, "Open task", 0, "2025-01-02T03:04:05.000Z");
+  insert.run(7, "Finished task", 1, "2025-06-07T08:09:10.123Z");
+  insert.run(12, "Another open", 0, "2025-12-31T23:59:59.999Z");
+  return db;
+}
+
+test("migrating a version 1 database turns done into status and keeps everything else", () => {
+  const db = databaseAtVersion1();
+  migrate(db);
+  const rows = db.prepare("SELECT * FROM tasks ORDER BY id").all();
+  assert.deepEqual(
+    rows.map((r) => ({ ...r })),
+    [
+      { id: 3, title: "Open task", status: "todo", created_at: "2025-01-02T03:04:05.000Z" },
+      { id: 7, title: "Finished task", status: "done", created_at: "2025-06-07T08:09:10.123Z" },
+      { id: 12, title: "Another open", status: "todo", created_at: "2025-12-31T23:59:59.999Z" },
+    ],
+  );
+});
+
+test("migrating drops the done column and moves user_version to 2", () => {
+  const db = databaseAtVersion1();
+  migrate(db);
+  const columns = db.prepare("PRAGMA table_info(tasks)").all().map((c: any) => c.name);
+  assert.deepEqual(columns, ["id", "title", "created_at", "status"]);
+  assert.equal((db.prepare("PRAGMA user_version").get() as any).user_version, 2);
+});
+
+test("migrating twice changes nothing", () => {
+  const db = databaseAtVersion1();
+  migrate(db);
+  const before = db.prepare("SELECT * FROM tasks ORDER BY id").all().map((r) => ({ ...r }));
+  migrate(db);
+  assert.deepEqual(db.prepare("SELECT * FROM tasks ORDER BY id").all().map((r) => ({ ...r })), before);
+  assert.equal((db.prepare("PRAGMA user_version").get() as any).user_version, 2);
+});
+
+test("the status column only accepts todo, doing and done", () => {
+  const db = openDb();
+  assert.throws(() => db.exec("INSERT INTO tasks (title, status) VALUES ('x', 'finished')"));
+  db.exec("INSERT INTO tasks (title) VALUES ('default')");
+  assert.equal((db.prepare("SELECT status FROM tasks").get() as any).status, "todo");
+});
+
+test("a task inserted after migrating keeps the autoincrement ids going", () => {
+  const db = databaseAtVersion1();
+  migrate(db);
+  db.exec("INSERT INTO tasks (title) VALUES ('new')");
+  assert.ok((db.prepare("SELECT MAX(id) AS m FROM tasks").get() as any).m > 12);
+});
diff --git a/test/startup-migration.test.ts b/test/startup-migration.test.ts
new file mode 100644
index 0000000..db41f62
--- /dev/null
+++ b/test/startup-migration.test.ts
@@ -0,0 +1,48 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { createServer } from "../src/app.ts";
+
+// AC3 end to end: a real version-1 database FILE, opened by the app as it starts.
+test("starting the app on a version 1 database file migrates it and keeps ids, titles and dates", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "tasks-qa-"));
+  const file = join(dir, "old.sqlite");
+  const old = new DatabaseSync(file);
+  old.exec(`CREATE TABLE tasks (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    title TEXT NOT NULL,
+    done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+  )`);
+  old.exec(`INSERT INTO tasks (id, title, done, created_at) VALUES
+    (5, 'open', 0, '2020-01-01T10:00:00.000Z'), (9, 'closed', 1, '2021-02-02T11:00:00.000Z')`);
+  old.exec("PRAGMA user_version = 1");
+  old.close();
+
+  const server: any = createServer(file);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  try {
+    const list = await (await fetch(`${base}/api/tasks`)).json();
+    assert.deepEqual(list, [
+      { id: 5, title: "open", status: "todo", done: false, created_at: "2020-01-01T10:00:00.000Z" },
+      { id: 9, title: "closed", status: "done", done: true, created_at: "2021-02-02T11:00:00.000Z" },
+    ]);
+    // done:false from "doing" goes back to todo, and ?done=false lists todo and doing together.
+    await fetch(`${base}/api/tasks/5`, { method: "PATCH", headers: { "content-type": "application/json" }, body: '{"status":"doing"}' });
+    const notDone = await (await fetch(`${base}/api/tasks?done=false`)).json();
+    assert.deepEqual(notDone.map((t: any) => t.status), ["doing"]);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+  const check = new DatabaseSync(file);
+  const cols = check.prepare("PRAGMA table_info(tasks)").all().map((c: any) => c.name);
+  assert.equal(cols.includes("done"), false);
+  assert.equal(cols.includes("status"), true);
+  assert.equal((check.prepare("PRAGMA user_version").get() as any).user_version, 2);
+  check.close();
+  rmSync(dir, { recursive: true });
+});
