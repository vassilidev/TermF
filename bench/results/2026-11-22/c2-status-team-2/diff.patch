+class BadRequest extends Error {}
+
+function parseStatus(value: unknown): tasks.Status {
+  if (!tasks.isStatus(value)) throw new BadRequest("status must be todo, doing or done");
+  return value;
+}
+
+function parseDoneParam(value: string): boolean {
+  if (value !== "true" && value !== "false") throw new BadRequest("done must be true or false");
+  return value === "true";
+}
+
+/** The status a body asks for: `status` wins over the deprecated `done`; undefined when neither is sent. */
+function statusFromBody(body: any): tasks.Status | undefined {
+  if (body.status !== undefined) return parseStatus(body.status);
+  if (body.done === undefined) return undefined;
+  if (typeof body.done !== "boolean") throw new BadRequest("done must be a boolean");
+  return body.done ? "done" : "todo";
+}
+
 async function readJson(req: any): Promise<any> {
   let text = "";
   for await (const chunk of req) text += chunk;
   return text ? JSON.parse(text) : {};
 }
