+    method,
+    headers: {
+      ...(body === undefined ? {} : { "content-type": "application/json" }),
+      ...(token ? { authorization: `Bearer ${token}` } : {}),
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const text = await res.text();
+  return { status: res.status, text, body: text ? JSON.parse(text) : null };
+}
+
+async function signIn(username: string) {
+  const res = await call("POST", "/api/sessions", { username, password: PASSWORD });
+  assert.equal(res.status, 201);
+  return res.body.token as string;
+}
+
+// AC8: what the served page offers a signed-out visitor, and how it talks to the API.
+test("the served page has sign-in and sign-up forms, a sign-out button and sends the bearer token", async () => {
+  const html = await (await fetch(base + "/")).text();
+  const js = await (await fetch(base + "/app.js")).text();
+  assert.match(html, /<form id="sign-in"/);
+  assert.match(html, /<form id="sign-up"/);
+  assert.match(html, /type="password"/);
+  assert.match(html, /<button[^>]*id="sign-out"[^>]*>\s*Sign out/);
+  // The task area starts hidden: a signed-out visitor never sees the old page flow.
+  assert.match(html, /<div id="signed-in" hidden>/);
+  assert.match(js, /Bearer \$\{token\}/);
+  assert.match(js, /\/api\/sessions/);
+  assert.match(js, /\/api\/users/);
+  assert.ok(!/innerHTML/.test(js), "server text must not go through innerHTML");
+  assert.equal(readFileSync(new URL("../public/app.js", import.meta.url), "utf8"), js);
+});
+
+// AC5: signing out ends that token only.
+test("signing out one session leaves the same user's other session and other users untouched", async () => {
+  for (const name of ["reg_a", "reg_b"]) {
+    assert.equal((await call("POST", "/api/users", { username: name, password: PASSWORD })).status, 201);
+  }
+  const a1 = await signIn("reg_a");
+  const a2 = await signIn("reg_a");
+  const b = await signIn("reg_b");
+  assert.notEqual(a1, a2);
+  assert.equal((await call("DELETE", "/api/sessions", undefined, a1)).status, 204);
+  assert.equal((await call("GET", "/api/tasks", undefined, a1)).status, 401);
+  assert.equal((await call("GET", "/api/tasks", undefined, a2)).status, 200);
+  assert.equal((await call("GET", "/api/tasks", undefined, b)).status, 200);
+  // The dead token cannot be signed out twice.
+  const again = await call("DELETE", "/api/sessions", undefined, a1);
+  assert.equal(again.status, 401);
+  assert.deepEqual(again.body, { error: "authentication required" });
+});
+
+// AC2/AC6: a signed-in response never carries credentials material.
+test("sign-in and sign-up responses hold only the documented fields", async () => {
+  const up = await call("POST", "/api/users", { username: "reg_c", password: PASSWORD });
+  assert.deepEqual(Object.keys(up.body).sort(), ["id", "username"]);
+  const inn = await call("POST", "/api/sessions", { username: "REG_C", password: PASSWORD });
+  assert.deepEqual(Object.keys(inn.body), ["token"]);
+  assert.ok(!inn.text.includes(PASSWORD));
+});
