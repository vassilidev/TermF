+import { createHash, randomBytes, scrypt, timingSafeEqual } from "node:crypto";
+import type { Db } from "./db.ts";
+
+export const MIN_PASSWORD_LENGTH = 10;
+const USERNAME = /^[a-z0-9_]{3,32}$/;
+const BEARER = /^Bearer ([A-Za-z0-9_-]{43})$/;
+const KEY_LENGTH = 64;
+
+export type CreateUserResult =
+  | { ok: true; user: { id: number; username: string } }
+  | { ok: false; error: "invalid username" | "password too short" | "username taken" };
+
+/** Lowercases the username and checks its shape; undefined when it is invalid. */
+export function normalizeUsername(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const name = value.toLowerCase();
+  return USERNAME.test(name) ? name : undefined;
+}
+
+function derive(password: string, salt: any): Promise<any> {
+  return new Promise((resolve, reject) => {
+    scrypt(password, salt, KEY_LENGTH, (err: Error | null, key: any) => (err ? reject(err) : resolve(key)));
+  });
+}
+
+export async function hashPassword(password: string): Promise<{ salt: string; hash: string }> {
+  const salt = randomBytes(16);
+  const key = await derive(password, salt);
+  return { salt: salt.toString("hex"), hash: key.toString("hex") };
+}
+
+export async function verifyPassword(password: string, salt: string, hash: string): Promise<boolean> {
+  const expected = Buffer.from(hash, "hex");
+  const key = await derive(password, Buffer.from(salt, "hex"));
+  return expected.length === key.length && timingSafeEqual(expected, key);
+}
+
+// Checked when the username is unknown, so that both sign-in failures cost one scrypt.
+const dummy = hashPassword(randomBytes(16).toString("hex"));
+
+export async function createUser(db: Db, username: unknown, password: unknown): Promise<CreateUserResult> {
+  const name = normalizeUsername(username);
+  if (name === undefined) return { ok: false, error: "invalid username" };
+  if (typeof password !== "string" || password.length < MIN_PASSWORD_LENGTH) {
+    return { ok: false, error: "password too short" };
+  }
+  if (db.prepare("SELECT 1 FROM users WHERE username = ?").get(name)) return { ok: false, error: "username taken" };
+  const { salt, hash } = await hashPassword(password);
+  try {
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO users (username, password_salt, password_hash) VALUES (?, ?, ?)")
+      .run(name, salt, hash);
+    return { ok: true, user: { id: Number(lastInsertRowid), username: name } };
+  } catch (err: any) {
+    // A concurrent sign-up of the same name passed the pre-check: the UNIQUE constraint decides.
+    if (/UNIQUE/i.test(String(err?.message))) return { ok: false, error: "username taken" };
+    throw err;
+  }
+}
+
+/** The user id when the credentials are right, undefined otherwise (same cost either way). */
+export async function checkCredentials(db: Db, username: unknown, password: unknown): Promise<number | undefined> {
+  const name = normalizeUsername(username);
+  const pass = typeof password === "string" ? password : "";
+  const row = (name === undefined ? undefined : db.prepare("SELECT id, password_salt, password_hash FROM users WHERE username = ?").get(name)) as
+    | { id: number; password_salt: string; password_hash: string }
+    | undefined;
+  const ref = row ? { salt: row.password_salt, hash: row.password_hash } : await dummy;
+  const ok = await verifyPassword(pass, ref.salt, ref.hash);
+  return row && ok && typeof password === "string" ? row.id : undefined;
+}
+
+const sha256 = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+export function createSession(db: Db, userId: number): string {
+  const token = randomBytes(32).toString("base64url");
+  db.prepare("INSERT INTO sessions (user_id, token_hash) VALUES (?, ?)").run(userId, sha256(token));
+  return token;
+}
+
+/** The user id of a token, undefined when unknown. */
+export function findSession(db: Db, token: string): number | undefined {
+  const row = db.prepare("SELECT user_id FROM sessions WHERE token_hash = ?").get(sha256(token)) as
+    | { user_id: number }
+    | undefined;
+  return row?.user_id;
+}
+
+export function deleteSession(db: Db, token: string): boolean {
+  return db.prepare("DELETE FROM sessions WHERE token_hash = ?").run(sha256(token)).changes > 0;
+}
+
+/** The token of a strict `Bearer <token>` header, undefined for anything else. */
+export function parseBearer(header: unknown): string | undefined {
+  return typeof header === "string" ? BEARER.exec(header)?.[1] : undefined;
+}
