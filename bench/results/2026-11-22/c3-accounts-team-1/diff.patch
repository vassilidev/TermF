@@ -0,0 +1,329 @@
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { createServer } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+
+let server: any;
+let base = "";
+const PASSWORD = "correct horse battery";
+
+before(async () => {
+  server = createServer();
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => server.close());
+
+async function call(method: string, path: string, body?: unknown, headers: Record<string, string> = {}, root = base) {
+  const raw = typeof body === "string";
+  const res = await fetch(root + path, {
+    method,
+    headers: { ...(body === undefined ? {} : { "content-type": "application/json" }), ...headers },
+    body: body === undefined ? undefined : raw ? body : JSON.stringify(body),
+  });
+  const text = await res.text();
+  return { status: res.status, res, text, body: text ? JSON.parse(text) : null };
+}
+
+let n = 0;
+const fresh = () => `acct_${n++}`;
+
+async function account(root = base) {
+  const username = fresh();
+  const created = await call("POST", "/api/users", { username, password: PASSWORD }, {}, root);
+  assert.equal(created.status, 201);
+  const session = await call("POST", "/api/sessions", { username, password: PASSWORD }, {}, root);
+  assert.equal(session.status, 201);
+  return { username, id: created.body.id, token: session.body.token, headers: { authorization: `Bearer ${session.body.token}` } };
+}
+
+// AC1
+test("sign-up answers 201 with the id and the username only", async () => {
+  const res = await call("POST", "/api/users", { username: "alice_1", password: PASSWORD });
+  assert.equal(res.status, 201);
+  assert.deepEqual(Object.keys(res.body).sort(), ["id", "username"]);
+  assert.equal(typeof res.body.id, "number");
+  assert.equal(res.body.username, "alice_1");
+  assert.equal(res.res.headers.get("cache-control"), "no-store");
+});
+
+test("the username is lowercased and a taken name is a 409 in any case", async () => {
+  const first = await call("POST", "/api/users", { username: "MixedCase_9", password: PASSWORD });
+  assert.equal(first.status, 201);
+  assert.equal(first.body.username, "mixedcase_9");
+  for (const name of ["mixedcase_9", "MIXEDCASE_9", "mIxEdCaSe_9"]) {
+    const again = await call("POST", "/api/users", { username: name, password: PASSWORD });
+    assert.equal(again.status, 409);
+    assert.deepEqual(again.body, { error: "username taken" });
+  }
+});
+
+test("a username must be 3 to 32 characters of a-z, 0-9 and _", async () => {
+  const bad = ["ab", "a".repeat(33), "has space", "dash-ed", "dot.ted", "émile", "", "a/b", "名前名前"];
+  for (const username of bad) {
+    const res = await call("POST", "/api/users", { username, password: PASSWORD });
+    assert.equal(res.status, 400, `"${username}"`);
+    assert.deepEqual(res.body, { error: "invalid username" });
+  }
+  for (const username of ["abc", "a".repeat(32)]) {
+    assert.equal((await call("POST", "/api/users", { username, password: PASSWORD })).status, 201, username);
+  }
+});
+
+test("a missing or non-string username is invalid, not a 500", async () => {
+  for (const body of [{ password: PASSWORD }, { username: 123, password: PASSWORD }, { username: ["abc"], password: PASSWORD }, { username: null, password: PASSWORD }]) {
+    const res = await call("POST", "/api/users", body);
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "invalid username" });
+  }
+});
+
+test("a password needs 10 characters", async () => {
+  const short = await call("POST", "/api/users", { username: fresh(), password: "123456789" });
+  assert.equal(short.status, 400);
+  assert.deepEqual(short.body, { error: "password too short" });
+  assert.equal((await call("POST", "/api/users", { username: fresh(), password: "1234567890" })).status, 201);
+  for (const password of [undefined, 1234567890123, ["1234567890"], null]) {
+    const res = await call("POST", "/api/users", { username: fresh(), password });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "password too short" });
+  }
+});
+
+test("the username is checked before the password", async () => {
+  const res = await call("POST", "/api/users", { username: "x", password: "y" });
+  assert.deepEqual(res.body, { error: "invalid username" });
+});
+
+// AC2
+test("sign-in answers 201 with an opaque token", async () => {
+  const username = fresh();
+  await call("POST", "/api/users", { username, password: PASSWORD });
+  const res = await call("POST", "/api/sessions", { username: username.toUpperCase(), password: PASSWORD });
+  assert.equal(res.status, 201);
+  assert.deepEqual(Object.keys(res.body), ["token"]);
+  assert.match(res.body.token, /^[A-Za-z0-9_-]{43}$/);
+  assert.equal(res.res.headers.get("cache-control"), "no-store");
+  const other = await call("POST", "/api/sessions", { username, password: PASSWORD });
+  assert.notEqual(other.body.token, res.body.token);
+});
+
+test("a wrong username and a wrong password give the same 401", async () => {
+  const { username } = await account();
+  const wrongPassword = await call("POST", "/api/sessions", { username, password: "not the password" });
+  const wrongUser = await call("POST", "/api/sessions", { username: "nobody_here", password: PASSWORD });
+  assert.equal(wrongPassword.status, 401);
+  assert.equal(wrongUser.status, 401);
+  assert.deepEqual(wrongPassword.body, { error: "invalid credentials" });
+  assert.equal(wrongPassword.text, wrongUser.text);
+  for (const body of [{}, { username, password: 5 }, { username: 5, password: PASSWORD }, { username }]) {
+    const res = await call("POST", "/api/sessions", body);
+    assert.equal(res.status, 401);
+    assert.deepEqual(res.body, { error: "invalid credentials" });
+  }
+});
+
+// AC3
+test("every tasks route answers 401 without a valid token", async () => {
+  const { token } = await account();
+  const routes: [string, string, unknown?][] = [
+    ["GET", "/api/tasks"],
+    ["POST", "/api/tasks", { title: "x" }],
+    ["GET", "/api/tasks/1"],
+    ["PATCH", "/api/tasks/1", { done: true }],
+    ["DELETE", "/api/tasks/1"],
+    ["PUT", "/api/tasks"],
+    ["PUT", "/api/tasks/1"],
+  ];
+  const headers: Record<string, string>[] = [
+    {},
+    { authorization: "" },
+    { authorization: `Bearer ${"A".repeat(43)}` },
+    { authorization: token },
+    { authorization: `Basic ${token}` },
+    { authorization: `bearer ${token}` },
+    { authorization: `Bearer  ${token}` },
+    { authorization: `Bearer ${token}x` },
+    { authorization: `Bearer ${token.slice(1)}` },
+  ];
+  for (const [method, path, body] of routes) {
+    for (const h of headers) {
+      const res = await call(method, path, body, h);
+      assert.equal(res.status, 401, `${method} ${path} ${h.authorization}`);
+      assert.deepEqual(res.body, { error: "authentication required" });
+    }
+  }
+});
+
+test("authentication comes before body parsing on the tasks routes", async () => {
+  const res = await call("POST", "/api/tasks", "{not json");
+  assert.equal(res.status, 401);
+});
+
+// AC4
+test("a user sees and changes only their own tasks", async () => {
+  const a = await account();
+  const b = await account();
+  const mine = await call("POST", "/api/tasks", { title: "A's task" }, a.headers);
+  assert.equal(mine.status, 201);
+  assert.deepEqual(Object.keys(mine.body).sort(), ["created_at", "done", "id", "title"]);
+
+  const list = await call("GET", "/api/tasks", undefined, b.headers);
+  assert.equal(list.status, 200);
+  assert.deepEqual(list.body, []);
+  assert.deepEqual((await call("GET", "/api/tasks?done=false", undefined, b.headers)).body, []);
+
+  const missing = await call("GET", "/api/tasks/999999", undefined, b.headers);
+  for (const [method, body] of [["GET"], ["PATCH", { title: "hijacked", done: true }], ["DELETE"]] as [string, unknown?][]) {
+    const res = await call(method, `/api/tasks/${mine.body.id}`, body, b.headers);
+    assert.equal(res.status, 404, method);
+    assert.deepEqual(res.body, { error: "task not found" });
+    assert.equal(res.text, missing.text);
+  }
+  assert.deepEqual((await call("GET", `/api/tasks/${mine.body.id}`, undefined, a.headers)).body, mine.body);
+});
+
+test("each user lists their own tasks", async () => {
+  const a = await account();
+  const b = await account();
+  await call("POST", "/api/tasks", { title: "a1" }, a.headers);
+  await call("POST", "/api/tasks", { title: "b1" }, b.headers);
+  assert.deepEqual((await call("GET", "/api/tasks", undefined, a.headers)).body.map((t: any) => t.title), ["a1"]);
+  assert.deepEqual((await call("GET", "/api/tasks", undefined, b.headers)).body.map((t: any) => t.title), ["b1"]);
+});
+
+// AC5
+test("sign-out answers 204 and the token stops working", async () => {
+  const a = await account();
+  const other = await call("POST", "/api/sessions", { username: a.username, password: PASSWORD });
+  const out = await call("DELETE", "/api/sessions", undefined, a.headers);
+  assert.equal(out.status, 204);
+  assert.equal((await call("GET", "/api/tasks", undefined, a.headers)).status, 401);
+  assert.equal((await call("DELETE", "/api/sessions", undefined, a.headers)).status, 401);
+  // another session of the same user stays valid
+  assert.equal((await call("GET", "/api/tasks", undefined, { authorization: `Bearer ${other.body.token}` })).status, 200);
+});
+
+test("sign-out without a valid token is a 401", async () => {
+  for (const h of [{}, { authorization: "Bearer nope" }, { authorization: `Bearer ${"B".repeat(43)}` }]) {
+    const res = await call("DELETE", "/api/sessions", undefined, h);
+    assert.equal(res.status, 401);
+    assert.deepEqual(res.body, { error: "authentication required" });
+  }
+});
+
+// Input hardening
+test("bad bodies are 400 or 413, and a wrong method is 405", async () => {
+  for (const path of ["/api/users", "/api/sessions"]) {
+    for (const body of ["{not json", "[1,2]", "null", '"text"']) {
+      const res = await call("POST", path, body);
+      assert.equal(res.status, 400, `${path} ${body}`);
+      assert.deepEqual(res.body, { error: "invalid json" });
+    }
+  }
+  const big = await call("POST", "/api/users", JSON.stringify({ username: fresh(), password: "x".repeat(20 * 1024) }));
+  assert.equal(big.status, 413);
+  assert.deepEqual(big.body, { error: "payload too large" });
+  const { headers } = await account();
+  assert.equal((await call("POST", "/api/tasks", "{oops", headers)).status, 400);
+  for (const [method, path] of [["GET", "/api/users"], ["PUT", "/api/users"], ["GET", "/api/sessions"], ["PATCH", "/api/sessions"]]) {
+    const res = await call(method, path);
+    assert.equal(res.status, 405, `${method} ${path}`);
+    assert.deepEqual(res.body, { error: "method not allowed" });
+  }
+});
+
+test("an internal failure does not echo the error message", async () => {
+  const { headers } = await account();
+  const res = await call("POST", "/api/tasks", {}, headers); // title NULL breaks NOT NULL
+  assert.equal(res.status, 500);
+  assert.deepEqual(res.body, { error: "internal error" });
+});
+
+// AC6
+test("neither the password nor the token is stored or returned in clear", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "accounts-"));
+  const file = join(dir, "t.db");
+  const own = createServer(file);
+  await new Promise<void>((resolve) => own.listen(0, "127.0.0.1", resolve));
+  const root = `http://127.0.0.1:${own.address().port}`;
+  try {
+    const username = "stored_user";
+    const created = await call("POST", "/api/users", { username, password: PASSWORD }, {}, root);
+    const session = await call("POST", "/api/sessions", { username, password: PASSWORD }, {}, root);
+    const task = await call("POST", "/api/tasks", { title: "t" }, { authorization: `Bearer ${session.body.token}` }, root);
+    for (const r of [created, session, task]) {
+      assert.ok(!r.text.includes(PASSWORD));
+      assert.ok(!/salt|hash|password/i.test(r.text.replace(session.body.token, "")));
+    }
+    const db = new DatabaseSync(file);
+    const user = db.prepare("SELECT * FROM users WHERE username = ?").get(username) as any;
+    assert.match(user.password_salt, /^[0-9a-f]{32}$/);
+    assert.match(user.password_hash, /^[0-9a-f]{128}$/);
+    assert.ok(![user.password_salt, user.password_hash].some((v) => v.includes(PASSWORD)));
+    const rows = db.prepare("SELECT token_hash FROM sessions").all() as any[];
+    assert.equal(rows.length, 1);
+    assert.notEqual(rows[0].token_hash, session.body.token);
+    assert.match(rows[0].token_hash, /^[0-9a-f]{64}$/);
+    // two users with the same password get different salts and hashes
+    await call("POST", "/api/users", { username: "stored_two", password: PASSWORD }, {}, root);
+    const two = db.prepare("SELECT * FROM users WHERE username = 'stored_two'").get() as any;
+    assert.notEqual(two.password_salt, user.password_salt);
+    assert.notEqual(two.password_hash, user.password_hash);
+    db.close();
+  } finally {
+    await new Promise((resolve) => own.close(resolve));
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+// AC7
+test("tasks created before accounts are kept and no user sees them", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "accounts-"));
+  const file = join(dir, "v1.db");
+  const v1 = new DatabaseSync(file);
+  v1.exec(`CREATE TABLE tasks (
+     id INTEGER PRIMARY KEY AUTOINCREMENT,
+     title TEXT NOT NULL,
+     done INTEGER NOT NULL DEFAULT 0,
+     created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+   )`);
+  v1.exec("INSERT INTO tasks (title) VALUES ('legacy task')");
+  v1.exec("PRAGMA user_version = 1");
+  v1.close();
+
+  const own = createServer(file);
+  await new Promise<void>((resolve) => own.listen(0, "127.0.0.1", resolve));
+  const root = `http://127.0.0.1:${own.address().port}`;
+  try {
+    const u = await account(root);
+    assert.deepEqual((await call("GET", "/api/tasks", undefined, u.headers, root)).body, []);
+    assert.deepEqual((await call("GET", "/api/tasks?done=false", undefined, u.headers, root)).body, []);
+    const legacy = await call("GET", "/api/tasks/1", undefined, u.headers, root);
+    assert.equal(legacy.status, 404);
+    assert.equal((await call("PATCH", "/api/tasks/1", { title: "mine" }, u.headers, root)).status, 404);
+    assert.equal((await call("DELETE", "/api/tasks/1", undefined, u.headers, root)).status, 404);
+    const created = await call("POST", "/api/tasks", { title: "new" }, u.headers, root);
+    assert.notEqual(created.body.id, 1);
+  } finally {
+    await new Promise((resolve) => own.close(resolve));
+  }
+  const db = new DatabaseSync(file);
+  const row = db.prepare("SELECT title, user_id FROM tasks WHERE id = 1").get() as any;
+  assert.equal(row.title, "legacy task");
+  assert.equal(row.user_id, null);
+  db.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+test("the migration is idempotent on a migrated database", () => {
+  const db = openDb(":memory:");
+  const { user_version } = db.prepare("PRAGMA user_version").get() as any;
+  assert.equal(user_version, 2);
+  db.close();
+});
