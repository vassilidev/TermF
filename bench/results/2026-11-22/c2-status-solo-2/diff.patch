 import type { Db } from "./db.ts";
 
+export const STATUSES = ["todo", "doing", "done"] as const;
+export type Status = (typeof STATUSES)[number];
+
+export const isStatus = (value: unknown): value is Status => STATUSES.includes(value as Status);
+
 export interface Task {
   id: number;
   title: string;
+  status: Status;
+  /** Deprecated: `status === "done"`. Kept for one release. */
   done: boolean;
   created_at: string;
 }
 
 interface Row {
   id: number;
   title: string;
-  done: number;
+  status: Status;
   created_at: string;
 }
 
-const toTask = (row: Row): Task => ({ ...row, done: row.done === 1 });
+const toTask = (row: Row): Task => ({ ...row, done: row.status === "done" });
 
-export function listTasks(db: Db, filter: { done?: string } = {}): Task[] {
-  if (filter.done === undefined) {
-    return (db.prepare("SELECT * FROM tasks ORDER BY id").all() as Row[]).map(toTask);
+/** `status` keeps only that status; `done` (deprecated) keeps the done tasks (true) or the others (false). */
+export function listTasks(db: Db, filter: { status?: Status; done?: boolean } = {}): Task[] {
+  const where: string[] = [];
+  const params: string[] = [];
+  if (filter.status !== undefined) {
+    where.push("status = ?");
+    params.push(filter.status);
   }
-  const rows = db.prepare("SELECT * FROM tasks WHERE done = ? ORDER BY id").all(filter.done ? 1 : 0) as Row[];
-  return rows.map(toTask);
+  if (filter.done !== undefined) where.push(filter.done ? "status = 'done'" : "status <> 'done'");
+  const sql = `SELECT * FROM tasks${where.length ? " WHERE " + where.join(" AND ") : ""} ORDER BY id`;
+  return (db.prepare(sql).all(...params) as Row[]).map(toTask);
 }
 
 export function getTask(db: Db, id: number): Task | undefined {
   const row = db.prepare("SELECT * FROM tasks WHERE id = ?").get(id) as Row | undefined;
   return row && toTask(row);
 }
 
-export function createTask(db: Db, title: string): Task {
-  const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title) VALUES (?)").run(title);
+export function createTask(db: Db, title: string, status: Status = "todo"): Task {
+  const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title, status) VALUES (?, ?)").run(title, status);
   return getTask(db, Number(lastInsertRowid))!;
 }
 
-export function updateTask(db: Db, id: number, changes: { title?: string; done?: boolean }): Task | undefined {
+export function updateTask(db: Db, id: number, changes: { title?: string; status?: Status }): Task | undefined {
   const task = getTask(db, id);
   if (!task) return undefined;
   const title = changes.title ?? task.title;
-  const done = changes.done ?? task.done;
-  db.prepare("UPDATE tasks SET title = ?, done = ? WHERE id = ?").run(title, done ? 1 : 0, id);
+  const status = changes.status ?? task.status;
+  db.prepare("UPDATE tasks SET title = ?, status = ? WHERE id = ?").run(title, status, id);
   return getTask(db, id);
 }
 
 export function deleteTask(db: Db, id: number): boolean {
   return db.prepare("DELETE FROM tasks WHERE id = ?").run(id).changes > 0;
