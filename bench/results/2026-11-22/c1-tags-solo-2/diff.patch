+/** A `tags` change replaces the whole list; without it the tags stay. Throws InvalidTagsError before any write. */
+export function updateTask(
+  db: Db,
+  id: number,
+  changes: { title?: string; done?: boolean; tags?: unknown },
+): Task | undefined {
+  const names = changes.tags === undefined ? undefined : parseTags(changes.tags);
+  return inTransaction(db, () => {
+    const task = getTask(db, id);
+    if (!task) return undefined;
+    const title = changes.title ?? task.title;
+    const done = changes.done ?? task.done;
+    db.prepare("UPDATE tasks SET title = ?, done = ? WHERE id = ?").run(title, done ? 1 : 0, id);
+    if (names) setTags(db, id, names);
+    return getTask(db, id);
+  });
