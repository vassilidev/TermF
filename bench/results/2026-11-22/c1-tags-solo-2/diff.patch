+/** Thrown when a `tags` value is not acceptable; the HTTP layer answers 400. */
+export class InvalidTagsError extends Error {
+  constructor() {
+    super("invalid tags");
+  }
+}
+
+const MAX_TAGS = 10;
+const TAG = /^[a-z0-9-]{1,30}$/;
+
+export const normalizeTag = (tag: string): string => tag.trim().toLowerCase();
+
+/** Trims, lowercases and de-duplicates the tags, then checks them. Returns them sorted. */
+export function parseTags(value: unknown): string[] {
+  if (!Array.isArray(value) || value.some((tag) => typeof tag !== "string")) throw new InvalidTagsError();
+  const tags = [...new Set(value.map(normalizeTag))].sort();
+  if (tags.length > MAX_TAGS || !tags.every((tag) => TAG.test(tag))) throw new InvalidTagsError();
+  return tags;
+}
+
+function withTags(db: Db, rows: Row[]): Task[] {
+  const byTask = new Map<number, string[]>();
+  const links = db
+    .prepare("SELECT tt.task_id, t.name FROM task_tags tt JOIN tags t ON t.id = tt.tag_id ORDER BY t.name")
+    .all() as { task_id: number; name: string }[];
+  for (const { task_id, name } of links) {
+    const names = byTask.get(task_id);
+    if (names) names.push(name);
+    else byTask.set(task_id, [name]);
+  }
+  return rows.map((row) => ({ ...row, done: row.done === 1, tags: byTask.get(row.id) ?? [] }));
+}
 
