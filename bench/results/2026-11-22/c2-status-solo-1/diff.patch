+const STATUS_ERROR = "status must be todo, doing or done";
+
+/** The status a body asks for: `status`, else the deprecated `done` flag; undefined if neither; null if invalid. */
+function statusOf(body: any): tasks.Status | undefined | null {
+  if (body.status !== undefined) return tasks.isStatus(body.status) ? body.status : null;
+  if (body.done !== undefined) return body.done ? "done" : "todo";
+  return undefined;
+}
+
 async function readJson(req: any): Promise<any> {
   let text = "";
   for await (const chunk of req) text += chunk;
   return text ? JSON.parse(text) : {};
 }
