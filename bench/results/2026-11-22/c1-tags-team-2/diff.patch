+/** Trims, lowercases and deduplicates the tags; undefined when the input or one of its tags is invalid. */
+export function normalizeTag(input: unknown): string | undefined {
+  if (typeof input !== "string") return undefined;
+  const tag = input.trim().toLowerCase();
+  return TAG_PATTERN.test(tag) ? tag : undefined;
