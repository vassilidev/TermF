+test("a database made with only the first migration upgrades and keeps its tasks", async () => {
+  const { mkdtempSync, rmSync } = await import("node:fs");
+  const { tmpdir } = await import("node:os");
+  const { join } = await import("node:path");
+  const { DatabaseSync } = await import("node:sqlite");
+  const dir = mkdtempSync(join(tmpdir(), "tasks-v1-"));
+  const file = join(dir, "tasks.db");
+  const old = new DatabaseSync(file);
+  old.exec(`CREATE TABLE tasks (
+    id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')))`);
+  old.exec("INSERT INTO tasks (title) VALUES ('old task')");
+  old.exec("PRAGMA user_version = 1");
+  old.close();
+  const srv: any = createServer(file);
+  await new Promise<void>((resolve) => srv.listen(0, "127.0.0.1", resolve));
+  try {
+    const url = `http://127.0.0.1:${srv.address().port}`;
+    const list = await (await fetch(`${url}/api/tasks`)).json();
+    assert.equal(list.length, 1);
+    assert.equal(list[0].title, "old task");
+    assert.deepEqual(list[0].tags, []);
+    const res = await fetch(`${url}/api/tasks/${list[0].id}`, {
+      method: "PATCH",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ tags: ["home"] }),
+    });
+    assert.deepEqual((await res.json()).tags, ["home"]);
+  } finally {
+    await new Promise((resolve) => srv.close(resolve));
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
