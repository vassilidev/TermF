diff --git a/test/migration.test.ts b/test/migration.test.ts
new file mode 100644
index 0000000..b57cf44
--- /dev/null
+++ b/test/migration.test.ts
@@ -0,0 +1,63 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { migrate } from "../src/db.ts";
+
+// The schema as migration 1 shipped it, written by hand: the test must not depend on the migrations array.
+function oldDatabase() {
+  const db = new DatabaseSync(":memory:");
+  db.exec(`CREATE TABLE tasks (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    title TEXT NOT NULL,
+    done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+  )`);
+  db.exec("PRAGMA user_version = 1");
+  const insert = db.prepare("INSERT INTO tasks (id, title, done, created_at) VALUES (?, ?, ?, ?)");
+  insert.run(3, "Finished", 1, "2025-01-02T03:04:05.000Z");
+  insert.run(7, "Open", 0, "2025-02-03T04:05:06.000Z");
+  insert.run(9, "Also finished", 1, "2025-03-04T05:06:07.000Z");
+  return db;
+}
+
+const version = (db: DatabaseSync) => (db.prepare("PRAGMA user_version").get() as { user_version: number }).user_version;
+const rows = (db: DatabaseSync) => db.prepare("SELECT * FROM tasks ORDER BY id").all();
+
+test("migration 2 replaces done with status and keeps the data", () => {
+  const db = oldDatabase();
+  migrate(db);
+  const columns = (db.prepare("PRAGMA table_info(tasks)").all() as { name: string }[]).map((c) => c.name);
+  assert.ok(columns.includes("status"));
+  assert.ok(!columns.includes("done"));
+  assert.deepEqual(rows(db).map((r) => ({ ...r })), [
+    { id: 3, title: "Finished", status: "done", created_at: "2025-01-02T03:04:05.000Z" },
+    { id: 7, title: "Open", status: "todo", created_at: "2025-02-03T04:05:06.000Z" },
+    { id: 9, title: "Also finished", status: "done", created_at: "2025-03-04T05:06:07.000Z" },
+  ]);
+  assert.equal(version(db), 2);
+});
+
+test("migrating again changes nothing", () => {
+  const db = oldDatabase();
+  migrate(db);
+  const first = rows(db).map((r) => ({ ...r }));
+  migrate(db);
+  assert.deepEqual(rows(db).map((r) => ({ ...r })), first);
+  assert.equal(version(db), 2);
+});
+
+test("the status column defaults to todo and refuses other values", () => {
+  const db = oldDatabase();
+  migrate(db);
+  db.prepare("INSERT INTO tasks (title) VALUES ('New')").run();
+  assert.equal((db.prepare("SELECT status FROM tasks WHERE title = 'New'").get() as any).status, "todo");
+  assert.throws(() => db.prepare("INSERT INTO tasks (title, status) VALUES ('Bad', 'bogus')").run());
+});
+
+test("a fresh database ends at version 2 with the same schema", () => {
+  const db = new DatabaseSync(":memory:");
+  migrate(db);
+  assert.equal(version(db), 2);
+  const columns = (db.prepare("PRAGMA table_info(tasks)").all() as { name: string }[]).map((c) => c.name);
+  assert.deepEqual(columns, ["id", "title", "created_at", "status"]);
+});
