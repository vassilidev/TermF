+  assert.ok(!ids.includes(done.body.id));
+  assert.ok(openList.every((t: any) => t.done === false));
+});
+
+test("?status wins over ?done", async () => {
+  const doing = await call("POST", "/api/tasks", { title: "Status beats done", status: "doing" });
+  const list = (await call("GET", "/api/tasks?status=doing&done=true")).body;
+  assert.ok(list.some((t: any) => t.id === doing.body.id));
+  assert.ok(list.every((t: any) => t.status === "doing"));
+});
+
+test("an unknown task with an invalid status is a 400, a valid one a 404", async () => {
+  assert.equal((await call("PATCH", "/api/tasks/9999", { status: "bogus" })).status, 400);
+  assert.equal((await call("PATCH", "/api/tasks/9999", { status: "done" })).status, 404);
+});
