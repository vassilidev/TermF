index 0000000..d8092c8
--- /dev/null
+++ b/src/users.ts
@@ -0,0 +1,62 @@
+import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto";
+import type { Db } from "./db.ts";
+
+/** An error that carries the HTTP status and the message sent to the client. */
+export class HttpError extends Error {
+  status: number;
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export interface User {
+  id: number;
+  username: string;
+}
+
+const KEY_LENGTH = 64;
+const MAX_PASSWORD = 1024;
+const MIN_PASSWORD = 10;
+
+// Compared against when the username is unknown, so that a sign-in costs the same either way.
+const DUMMY_SALT = randomBytes(16);
+const DUMMY_HASH = scryptSync("dummy-password", DUMMY_SALT, KEY_LENGTH);
+
+export function createUser(db: Db, username: unknown, password: unknown): User {
+  const name = typeof username === "string" ? username.toLowerCase() : "";
+  if (!/^[a-z0-9_]{3,32}$/.test(name)) throw new HttpError(400, "invalid username");
+  if (typeof password !== "string" || password.length < MIN_PASSWORD) throw new HttpError(400, "password too short");
+  if (password.length > MAX_PASSWORD) throw new HttpError(400, "password too long");
+
+  const salt = randomBytes(16);
+  const hash = scryptSync(password, salt, KEY_LENGTH);
+  try {
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO users (username, password_salt, password_hash) VALUES (?, ?, ?)")
+      .run(name, salt.toString("hex"), hash.toString("hex"));
+    return { id: Number(lastInsertRowid), username: name };
+  } catch (err) {
+    if (err instanceof Error && /UNIQUE constraint failed/.test(err.message)) throw new HttpError(409, "username taken");
+    throw err;
+  }
+}
+
+/** The user id when the credentials are right, else undefined. A scrypt compare always runs. */
+export function verifyCredentials(db: Db, username: unknown, password: unknown): number | undefined {
+  const name = typeof username === "string" ? username.toLowerCase() : "";
+  const row =
+    name.length <= 32
+      ? (db.prepare("SELECT id, password_salt, password_hash FROM users WHERE username = ?").get(name) as
+          | { id: number; password_salt: string; password_hash: string }
+          | undefined)
+      : undefined;
+  // A password that cannot have been stored (not a string, too long) is compared as empty: same cost, never valid.
+  const usable = typeof password === "string" && password.length <= MAX_PASSWORD;
+  const candidate = usable ? password : "";
+  const salt = row ? Buffer.from(row.password_salt, "hex") : DUMMY_SALT;
+  const expected = row ? Buffer.from(row.password_hash, "hex") : DUMMY_HASH;
+  const actual = scryptSync(candidate, salt, KEY_LENGTH);
+  const same = timingSafeEqual(actual, expected);
+  return row && same && usable ? row.id : undefined;
+}
