index 0000000..a2ca004
--- /dev/null
+++ b/src/sessions.ts
@@ -0,0 +1,33 @@
+import { createHash, randomBytes } from "node:crypto";
+import type { Db } from "./db.ts";
+
+// 32 random bytes, base64url: 43 characters.
+const BEARER = /^Bearer ([A-Za-z0-9_-]{43})$/;
+
+const hashToken = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+/** Opens a session and returns its token; only the token's hash is stored. */
+export function createSession(db: Db, userId: number): string {
+  const token = randomBytes(32).toString("base64url");
+  db.prepare("INSERT INTO sessions (user_id, token_hash) VALUES (?, ?)").run(userId, hashToken(token));
+  return token;
+}
+
+/** The token of an `Authorization: Bearer <token>` header, or undefined when it is missing or malformed. */
+export function tokenFromHeader(header: unknown): string | undefined {
+  return typeof header === "string" ? BEARER.exec(header)?.[1] : undefined;
+}
+
+/** The id of the user the header's token belongs to, or undefined. */
+export function userForToken(db: Db, header: unknown): number | undefined {
+  const token = tokenFromHeader(header);
+  if (!token) return undefined;
+  const row = db.prepare("SELECT user_id FROM sessions WHERE token_hash = ?").get(hashToken(token)) as
+    | { user_id: number }
+    | undefined;
+  return row?.user_id;
+}
+
+export function deleteSession(db: Db, token: string): boolean {
+  return db.prepare("DELETE FROM sessions WHERE token_hash = ?").run(hashToken(token)).changes > 0;
+}
