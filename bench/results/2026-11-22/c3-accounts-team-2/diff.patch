--- /dev/null
+++ b/test/accounts.test.ts
@@ -0,0 +1,354 @@
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { createServer } from "../src/app.ts";
+
+let server: any;
+let base = "";
+let dir = "";
+let dbPath = "";
+
+before(async () => {
+  dir = mkdtempSync(join(tmpdir(), "accounts-test-"));
+  dbPath = join(dir, "test.db");
+  server = createServer(dbPath);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+async function call(method: string, path: string, opts: { body?: unknown; raw?: string; token?: string; auth?: string } = {}) {
+  const headers: Record<string, string> = {};
+  if (opts.body !== undefined || opts.raw !== undefined) headers["content-type"] = "application/json";
+  if (opts.token !== undefined) headers.authorization = `Bearer ${opts.token}`;
+  if (opts.auth !== undefined) headers.authorization = opts.auth;
+  const res = await fetch(base + path, {
+    method,
+    headers,
+    body: opts.raw ?? (opts.body === undefined ? undefined : JSON.stringify(opts.body)),
+  });
+  const text = await res.text();
+  return { status: res.status, text, body: text ? JSON.parse(text) : null };
+}
+
+const PASSWORD = "correct horse battery";
+
+async function signUp(username: string, password = PASSWORD) {
+  return call("POST", "/api/users", { body: { username, password } });
+}
+
+async function signIn(username: string, password = PASSWORD): Promise<string> {
+  const res = await call("POST", "/api/sessions", { body: { username, password } });
+  assert.equal(res.status, 201);
+  return res.body.token;
+}
+
+async function newUser(username: string): Promise<string> {
+  assert.equal((await signUp(username)).status, 201);
+  return signIn(username);
+}
+
+// AC1
+test("sign-up answers 201 with the id and the username only", async () => {
+  const res = await signUp("alice_1");
+  assert.equal(res.status, 201);
+  assert.deepEqual(Object.keys(res.body).sort(), ["id", "username"]);
+  assert.equal(typeof res.body.id, "number");
+  assert.equal(res.body.username, "alice_1");
+});
+
+test("sign-up lowercases the username", async () => {
+  const res = await signUp("Bob_Smith");
+  assert.equal(res.status, 201);
+  assert.equal(res.body.username, "bob_smith");
+  await signIn("BOB_SMITH");
+});
+
+test("sign-up refuses a username that is taken in any case", async () => {
+  await signUp("carol");
+  for (const name of ["carol", "CAROL", "Carol"]) {
+    const res = await signUp(name);
+    assert.equal(res.status, 409);
+    assert.deepEqual(res.body, { error: "username taken" });
+  }
+});
+
+test("sign-up refuses invalid usernames", async () => {
+  const bad: unknown[] = ["ab", "a".repeat(33), "has space", "dash-ed", "émile", "", "a/b", 42, null, undefined, ["alice"], {}];
+  for (const username of bad) {
+    const res = await call("POST", "/api/users", { body: { username, password: PASSWORD } });
+    assert.equal(res.status, 400, `username ${JSON.stringify(username)}`);
+    assert.deepEqual(res.body, { error: "invalid username" });
+  }
+  assert.equal((await signUp("abc")).status, 201);
+  assert.equal((await signUp("b".repeat(32))).status, 201);
+});
+
+test("sign-up refuses a password under 10 characters, or not a string", async () => {
+  for (const password of ["123456789", "", 1234567890, null, undefined]) {
+    const res = await call("POST", "/api/users", { body: { username: "shortpw", password } });
+    assert.equal(res.status, 400, `password ${JSON.stringify(password)}`);
+    assert.deepEqual(res.body, { error: "password too short" });
+  }
+  assert.equal((await signUp("shortpw", "1234567890")).status, 201);
+});
+
+test("sign-up refuses a password over 1024 characters", async () => {
+  const tooLong = await signUp("longpw", "x".repeat(1025));
+  assert.equal(tooLong.status, 400);
+  assert.deepEqual(tooLong.body, { error: "password too long" });
+  assert.equal((await signUp("longpw", "x".repeat(1024))).status, 201);
+});
+
+test("a refused sign-up does not create the account", async () => {
+  await signUp("nopw", "short");
+  const res = await call("POST", "/api/sessions", { body: { username: "nopw", password: "short" } });
+  assert.equal(res.status, 401);
+});
+
+test("malformed JSON, a non-object body and an oversized body are refused", async () => {
+  for (const raw of ["{not json", "[]", "42", "null", '"text"']) {
+    const res = await call("POST", "/api/users", { raw });
+    assert.equal(res.status, 400, raw);
+    assert.deepEqual(res.body, { error: "invalid json" });
+  }
+  const big = await call("POST", "/api/users", { raw: JSON.stringify({ username: "bigbody", password: "x".repeat(70 * 1024) }) });
+  assert.equal(big.status, 413);
+});
+
+// AC2
+test("sign-in answers 201 with an opaque token that differs on each sign-in", async () => {
+  await signUp("dave");
+  const first = await call("POST", "/api/sessions", { body: { username: "dave", password: PASSWORD } });
+  const second = await call("POST", "/api/sessions", { body: { username: "dave", password: PASSWORD } });
+  assert.equal(first.status, 201);
+  assert.deepEqual(Object.keys(first.body), ["token"]);
+  assert.equal(typeof first.body.token, "string");
+  assert.ok(Buffer.from(first.body.token, "base64url").length >= 32);
+  assert.notEqual(first.body.token, second.body.token);
+});
+
+test("an unknown username and a wrong password give the same 401", async () => {
+  await signUp("erin");
+  const wrongPassword = await call("POST", "/api/sessions", { body: { username: "erin", password: "not the password" } });
+  const unknownUser = await call("POST", "/api/sessions", { body: { username: "nobody_here", password: PASSWORD } });
+  assert.equal(wrongPassword.status, 401);
+  assert.deepEqual(wrongPassword.body, { error: "invalid credentials" });
+  assert.equal(unknownUser.status, 401);
+  assert.equal(unknownUser.text, wrongPassword.text);
+  for (const body of [{}, { username: "erin" }, { username: 1, password: 2 }, { username: "erin", password: "x".repeat(5000) }]) {
+    const res = await call("POST", "/api/sessions", { body });
+    assert.equal(res.status, 401);
+    assert.deepEqual(res.body, { error: "invalid credentials" });
+  }
+});
+
+// AC3
+test("every task route answers 401 without a valid token", async () => {
+  const token = await newUser("frank");
+  const created = await call("POST", "/api/tasks", { token, body: { title: "frank's task" } });
+  const id = created.body.id;
+  const routes: [string, string, unknown?][] = [
+    ["GET", "/api/tasks"],
+    ["POST", "/api/tasks", { title: "x" }],
+    ["GET", `/api/tasks/${id}`],
+    ["PATCH", `/api/tasks/${id}`, { done: true }],
+    ["DELETE", `/api/tasks/${id}`],
+    ["GET", "/api/tasks/999999"],
+  ];
+  const wrongTokens: (string | undefined)[] = [
+    undefined, // no header
+    "Bearer ",
+    "Bearer abc",
+    `Bearer ${"A".repeat(43)}`, // well formed, unknown
+    `Basic ${token}`,
+    `bearer ${token}`,
+    `Bearer  ${token}`,
+    `Bearer ${token} extra`,
+    token, // no scheme
+  ];
+  for (const [method, path, body] of routes) {
+    for (const auth of wrongTokens) {
+      const res = await call(method, path, { body, auth });
+      assert.equal(res.status, 401, `${method} ${path} with ${auth}`);
+      assert.deepEqual(res.body, { error: "authentication required" });
+    }
+    // The token is checked before the body is read.
+    if (method !== "GET") {
+      const res = await call(method, path, { raw: "{not json" });
+      assert.equal(res.status, 401);
+    }
+  }
+  // The task was not touched by any of it.
+  const still = await call("GET", `/api/tasks/${id}`, { token });
+  assert.equal(still.status, 200);
+  assert.equal(still.body.done, false);
+});
+
+// AC4
+test("a user sees and changes only their own tasks", async () => {
+  const alice = await newUser("owner_a");
+  const bob = await newUser("owner_b");
+  const aliceTask = (await call("POST", "/api/tasks", { token: alice, body: { title: "Alice only" } })).body;
+  const bobTask = (await call("POST", "/api/tasks", { token: bob, body: { title: "Bob only" } })).body;
+
+  const aliceList = await call("GET", "/api/tasks", { token: alice });
+  assert.deepEqual(aliceList.body.map((t: any) => t.title), ["Alice only"]);
+  const bobList = await call("GET", "/api/tasks", { token: bob });
+  assert.deepEqual(bobList.body.map((t: any) => t.title), ["Bob only"]);
+
+  const missing = await call("GET", "/api/tasks/987654", { token: bob });
+  assert.equal(missing.status, 404);
+  assert.deepEqual(missing.body, { error: "task not found" });
+
+  const read = await call("GET", `/api/tasks/${aliceTask.id}`, { token: bob });
+  assert.equal(read.status, 404);
+  assert.equal(read.text, missing.text);
+  const patch = await call("PATCH", `/api/tasks/${aliceTask.id}`, { token: bob, body: { title: "hacked", done: true } });
+  assert.equal(patch.status, 404);
+  assert.equal(patch.text, missing.text);
+  const del = await call("DELETE", `/api/tasks/${aliceTask.id}`, { token: bob });
+  assert.equal(del.status, 404);
+  assert.equal(del.text, missing.text);
+
+  // Alice's task is untouched, and so is Bob's.
+  const after = await call("GET", `/api/tasks/${aliceTask.id}`, { token: alice });
+  assert.equal(after.status, 200);
+  assert.equal(after.body.title, "Alice only");
+  assert.equal(after.body.done, false);
+  assert.equal((await call("GET", `/api/tasks/${bobTask.id}`, { token: bob })).status, 200);
+  assert.equal((await call("GET", `/api/tasks/${bobTask.id}`, { token: alice })).status, 404);
+});
+
+test("the ?done filter stays within the user's own tasks", async () => {
+  const alice = await newUser("filter_a");
+  const bob = await newUser("filter_b");
+  const open = (await call("POST", "/api/tasks", { token: alice, body: { title: "open" } })).body;
+  const done = (await call("POST", "/api/tasks", { token: alice, body: { title: "done" } })).body;
+  await call("PATCH", `/api/tasks/${done.id}`, { token: alice, body: { done: true } });
+  const bobDone = (await call("POST", "/api/tasks", { token: bob, body: { title: "bob done" } })).body;
+  await call("PATCH", `/api/tasks/${bobDone.id}`, { token: bob, body: { done: true } });
+
+  const doneList = await call("GET", "/api/tasks?done=true", { token: alice });
+  assert.deepEqual(doneList.body.map((t: any) => t.id), [done.id]);
+  const openList = await call("GET", "/api/tasks?done=false", { token: alice });
+  assert.deepEqual(openList.body.map((t: any) => t.id), [open.id]);
+  assert.equal((await call("GET", "/api/tasks?done=maybe", { token: alice })).status, 400);
+});
+
+test("a task answer never shows its owner", async () => {
+  const token = await newUser("shape_user");
+  const res = await call("POST", "/api/tasks", { token, body: { title: "shape" } });
+  assert.deepEqual(Object.keys(res.body).sort(), ["created_at", "done", "id", "title"]);
+});
+
+test("task input is validated and errors do not leak details", async () => {
+  const token = await newUser("input_user");
+  assert.equal((await call("POST", "/api/tasks", { token, body: {} })).status, 400);
+  assert.equal((await call("POST", "/api/tasks", { token, body: { title: 5 } })).status, 400);
+  const bad = await call("POST", "/api/tasks", { token, raw: "{oops" });
+  assert.equal(bad.status, 400);
+  assert.deepEqual(bad.body, { error: "invalid json" });
+  const created = (await call("POST", "/api/tasks", { token, body: { title: "ok" } })).body;
+  assert.equal((await call("PATCH", `/api/tasks/${created.id}`, { token, body: { done: "yes" } })).status, 400);
+  assert.equal((await call("PATCH", `/api/tasks/${created.id}`, { token, body: { title: "" } })).status, 400);
+});
+
+// AC5
+test("sign-out answers 204 and the token stops working", async () => {
+  const token = await newUser("grace");
+  const other = await signIn("grace");
+  assert.equal((await call("GET", "/api/tasks", { token })).status, 200);
+  const out = await call("DELETE", "/api/sessions", { token });
+  assert.equal(out.status, 204);
+  assert.equal(out.text, "");
+  const after = await call("GET", "/api/tasks", { token });
+  assert.equal(after.status, 401);
+  assert.deepEqual(after.body, { error: "authentication required" });
+  // Signing out twice, and another session of the same user, behave as expected.
+  assert.equal((await call("DELETE", "/api/sessions", { token })).status, 401);
+  assert.equal((await call("GET", "/api/tasks", { token: other })).status, 200);
+});
+
+test("sign-out with a missing or bad token answers 401", async () => {
+  for (const auth of [undefined, "Bearer nope", `Bearer ${"B".repeat(43)}`]) {
+    const res = await call("DELETE", "/api/sessions", { auth });
+    assert.equal(res.status, 401);
+    assert.deepEqual(res.body, { error: "authentication required" });
+  }
+});
+
+// AC6
+test("no response contains a password, a hash, a salt or a token hash", async () => {
+  const password = "a very secret passphrase";
+  const signup = await signUp("heidi", password);
+  const token = await signIn("heidi", password);
+  const wrong = await call("POST", "/api/sessions", { body: { username: "heidi", password: "wrong wrong wrong" } });
+  const bad = await call("POST", "/api/users", { raw: "{nope" });
+  const taken = await signUp("heidi", password);
+  const tasks = await call("GET", "/api/tasks", { token });
+
+  const db = new DatabaseSync(dbPath);
+  const user = db.prepare("SELECT * FROM users WHERE username = 'heidi'").get() as any;
+  const session = db.prepare("SELECT * FROM sessions WHERE user_id = ?").get(user.id) as any;
+  db.close();
+
+  const everything = [signup, wrong, bad, taken, tasks].map((r) => r.text).join("\n");
+  for (const secret of [password, user.password_hash, user.password_salt, session.token_hash]) {
+    assert.ok(!everything.includes(secret));
+  }
+  assert.ok(!/password|hash|salt/i.test(signup.text));
+});
+
+test("passwords are stored salted and scrypt-hashed, and only the token hash is stored", async () => {
+  const password = "same password for two";
+  await signUp("ivan", password);
+  await signUp("judy", password);
+  const token = await signIn("ivan", password);
+
+  const db = new DatabaseSync(dbPath);
+  const rows = db.prepare("SELECT * FROM users WHERE username IN ('ivan', 'judy')").all() as any[];
+  const sessions = db.prepare("SELECT * FROM sessions").all() as any[];
+  db.close();
+
+  assert.equal(rows.length, 2);
+  assert.notEqual(rows[0].password_salt, rows[1].password_salt);
+  assert.notEqual(rows[0].password_hash, rows[1].password_hash);
+  for (const row of rows) {
+    assert.ok(!JSON.stringify(row).includes(password));
+    assert.ok(row.password_salt.length >= 32);
+  }
+  assert.ok(sessions.length > 0);
+  for (const row of sessions) assert.notEqual(row.token_hash, token);
+  assert.ok(!JSON.stringify(sessions).includes(token));
+});
+
+// AC7
+test("tasks created before accounts are kept but no user sees them", async () => {
+  const db = new DatabaseSync(dbPath);
+  const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title) VALUES ('legacy task')").run();
+  db.close();
+  const legacyId = Number(lastInsertRowid);
+
+  const token = await newUser("leo");
+  const list = await call("GET", "/api/tasks", { token });
+  assert.ok(!list.body.some((t: any) => t.title === "legacy task"));
+  assert.ok(!(await call("GET", "/api/tasks?done=false", { token })).body.some((t: any) => t.id === legacyId));
+  for (const [method, body] of [["GET"], ["PATCH", { title: "mine now" }], ["DELETE"]] as [string, unknown?][]) {
+    const res = await call(method, `/api/tasks/${legacyId}`, { token, body });
+    assert.equal(res.status, 404, method);
+    assert.deepEqual(res.body, { error: "task not found" });
+  }
+
+  const check = new DatabaseSync(dbPath);
+  const row = check.prepare("SELECT title, user_id FROM tasks WHERE id = ?").get(legacyId) as any;
+  check.close();
+  assert.deepEqual({ ...row }, { title: "legacy task", user_id: null });
+});
diff --git a/test/qa.test.ts b/test/qa.test.ts
new file mode 100644
index 0000000..120640b
--- /dev/null
+++ b/test/qa.test.ts
@@ -0,0 +1,251 @@
+// QA regression tests, derived from the acceptance criteria of the accounts ticket (AC1-AC8).
+// They complement test/accounts.test.ts: a real upgrade of a pre-accounts database, session isolation,
+// token entropy, boundaries at the real sign-in, persistence across a restart and the served page.
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { createServer } from "../src/app.ts";
+
+let dir = "";
+const servers: any[] = [];
+
+before(() => {
+  dir = mkdtempSync(join(tmpdir(), "qa-test-"));
+});
+
+after(() => {
+  for (const s of servers) if (s.listening) s.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+/** Starts the app on a database file; returns a `call` bound to it and a `stop`. */
+async function start(dbPath: string) {
+  const server = createServer(dbPath);
+  servers.push(server);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  async function call(method: string, path: string, opts: { body?: unknown; token?: string } = {}) {
+    const headers: Record<string, string> = {};
+    if (opts.body !== undefined) headers["content-type"] = "application/json";
+    if (opts.token !== undefined) headers.authorization = `Bearer ${opts.token}`;
+    const res = await fetch(base + path, {
+      method,
+      headers,
+      body: opts.body === undefined ? undefined : JSON.stringify(opts.body),
+    });
+    const text = await res.text();
+    return { status: res.status, text, body: text ? JSON.parse(text) : null };
+  }
+  const stop = () => new Promise<void>((resolve) => server.close(() => resolve()));
+  return { call, stop, base };
+}
+
+type Call = Awaited<ReturnType<typeof start>>["call"];
+const PASSWORD = "correct horse battery";
+
+async function register(call: Call, username: string, password = PASSWORD): Promise<string> {
+  assert.equal((await call("POST", "/api/users", { body: { username, password } })).status, 201);
+  const res = await call("POST", "/api/sessions", { body: { username, password } });
+  assert.equal(res.status, 201);
+  return res.body.token;
+}
+
+// AC7: the database a user already has, made by the first release (before accounts), not a fresh one.
+test("AC7: a database from before accounts is upgraded, keeps its tasks and shows them to nobody", async () => {
+  const dbPath = join(dir, "legacy.db");
+  const old = new DatabaseSync(dbPath);
+  old.exec(`CREATE TABLE tasks (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    title TEXT NOT NULL,
+    done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+  )`);
+  old.exec("PRAGMA user_version = 1");
+  old.exec("INSERT INTO tasks (title, done) VALUES ('before accounts, open', 0), ('before accounts, done', 1)");
+  old.close();
+
+  const app = await start(dbPath);
+  const token = await register(app.call, "newcomer");
+  assert.deepEqual((await app.call("GET", "/api/tasks", { token })).body, []);
+  assert.deepEqual((await app.call("GET", "/api/tasks?done=true", { token })).body, []);
+  assert.deepEqual((await app.call("GET", "/api/tasks?done=false", { token })).body, []);
+  for (const id of [1, 2]) {
+    assert.equal((await app.call("GET", `/api/tasks/${id}`, { token })).status, 404);
+    assert.equal((await app.call("PATCH", `/api/tasks/${id}`, { token, body: { done: true } })).status, 404);
+    assert.equal((await app.call("DELETE", `/api/tasks/${id}`, { token })).status, 404);
+  }
+  // A task the new user creates does not reuse or disturb the old ones.
+  assert.equal((await app.call("POST", "/api/tasks", { token, body: { title: "mine" } })).status, 201);
+  await app.stop();
+
+  const check = new DatabaseSync(dbPath);
+  const rows = check.prepare("SELECT title, done, user_id FROM tasks ORDER BY id").all().map((r) => ({ ...r }));
+  const { user_version } = check.prepare("PRAGMA user_version").get() as { user_version: number };
+  check.close();
+  assert.equal(user_version, 2);
+  assert.equal(rows.length, 3);
+  assert.deepEqual(rows[0], { title: "before accounts, open", done: 0, user_id: null });
+  assert.deepEqual(rows[1], { title: "before accounts, done", done: 1, user_id: null });
+  assert.equal(rows[2].title, "mine");
+  assert.notEqual(rows[2].user_id, null);
+});
+
+// AC6: "tokens are random (at least 32 bytes) and only their hash is stored".
+test("AC6: a token carries at least 32 random bytes, differs per sign-in and is stored only hashed", async () => {
+  const dbPath = join(dir, "tokens.db");
+  const app = await start(dbPath);
+  await register(app.call, "tokenuser");
+  const tokens: string[] = [];
+  for (let i = 0; i < 5; i++) {
+    const res = await app.call("POST", "/api/sessions", { body: { username: "tokenuser", password: PASSWORD } });
+    tokens.push(res.body.token);
+  }
+  assert.equal(new Set(tokens).size, 5);
+  for (const token of tokens) {
+    assert.match(token, /^[A-Za-z0-9_-]+$/);
+    assert.ok(Buffer.from(token, "base64url").length >= 32, "at least 32 bytes of entropy");
+  }
+
+  const db = new DatabaseSync(dbPath);
+  const stored = db.prepare("SELECT * FROM sessions").all() as any[];
+  db.close();
+  assert.ok(stored.length >= 5);
+  const dump = JSON.stringify(stored);
+  for (const token of tokens) {
+    assert.ok(!dump.includes(token), "the raw token is not stored");
+    assert.ok(!dump.includes(Buffer.from(token, "base64url").toString("hex")), "nor its bytes in hex");
+  }
+  // Possessing the stored value is not enough to authenticate.
+  for (const row of stored) {
+    assert.equal((await app.call("GET", "/api/tasks", { token: row.token_hash })).status, 401);
+  }
+  await app.stop();
+});
+
+// AC5: "the token stops working": that token only.
+test("AC5: signing out ends that session only, not the user's other sessions or other users", async () => {
+  const app = await start(join(dir, "signout.db"));
+  const first = await register(app.call, "twosessions");
+  const second = (await app.call("POST", "/api/sessions", { body: { username: "twosessions", password: PASSWORD } })).body.token;
+  const other = await register(app.call, "bystander");
+
+  assert.equal((await app.call("DELETE", "/api/sessions", { token: first })).status, 204);
+  assert.equal((await app.call("GET", "/api/tasks", { token: first })).status, 401);
+  assert.equal((await app.call("GET", "/api/tasks", { token: second })).status, 200);
+  assert.equal((await app.call("GET", "/api/tasks", { token: other })).status, 200);
+  // A signed-out token cannot sign out again, and cannot be used to create anything.
+  assert.equal((await app.call("DELETE", "/api/sessions", { token: first })).status, 401);
+  assert.equal((await app.call("POST", "/api/tasks", { token: first, body: { title: "x" } })).status, 401);
+  // The user can sign in again after signing out.
+  const again = await app.call("POST", "/api/sessions", { body: { username: "twosessions", password: PASSWORD } });
+  assert.equal(again.status, 201);
+  await app.stop();
+});
+
+// AC1 + AC2 at the real sign-in: the boundaries the sign-up accepts must be usable to sign in.
+test("AC1/AC2: the longest accepted password and any-case username work to sign in; one more character is refused like a wrong password", async () => {
+  const app = await start(join(dir, "boundaries.db"));
+  const longest = "p".repeat(1024);
+  const shortest = "q".repeat(10);
+  assert.equal((await app.call("POST", "/api/users", { body: { username: "Longest_Pw", password: longest } })).status, 201);
+  assert.equal((await app.call("POST", "/api/users", { body: { username: "shortest_pw", password: shortest } })).status, 201);
+
+  for (const [username, password] of [
+    ["LONGEST_PW", longest],
+    ["longest_pw", longest],
+    ["Shortest_Pw", shortest],
+  ]) {
+    const res = await app.call("POST", "/api/sessions", { body: { username, password } });
+    assert.equal(res.status, 201, `${username}`);
+    assert.equal(typeof res.body.token, "string");
+  }
+  const wrong = await app.call("POST", "/api/sessions", { body: { username: "longest_pw", password: "x".repeat(20) } });
+  for (const password of ["p".repeat(1025), "p".repeat(1023), longest.toUpperCase(), 12345678901, null]) {
+    const res = await app.call("POST", "/api/sessions", { body: { username: "longest_pw", password } });
+    assert.equal(res.status, 401);
+    assert.equal(res.text, wrong.text);
+  }
+  const unknown = await app.call("POST", "/api/sessions", { body: { username: "x".repeat(100), password: longest } });
+  assert.equal(unknown.status, 401);
+  assert.equal(unknown.text, wrong.text);
+  // A username that is not a string is a refused sign-in, not a crash.
+  const typed = await app.call("POST", "/api/sessions", { body: { username: { a: 1 }, password: longest } });
+  assert.equal(typed.status, 401);
+  assert.equal(typed.text, wrong.text);
+  await app.stop();
+});
+
+// AC2 + AC4 + AC5 over a real restart: accounts, tokens and ownership live in the database file.
+test("AC2/AC4: after a restart the account, its token and its tasks are still there, still private", async () => {
+  const dbPath = join(dir, "restart.db");
+  const first = await start(dbPath);
+  const mine = await register(first.call, "persistent");
+  const theirs = await register(first.call, "persistent_two");
+  const task = (await first.call("POST", "/api/tasks", { token: mine, body: { title: "survives" } })).body;
+  await first.stop();
+
+  const second = await start(dbPath);
+  assert.deepEqual((await second.call("GET", "/api/tasks", { token: mine })).body.map((t: any) => t.title), ["survives"]);
+  assert.equal((await second.call("GET", `/api/tasks/${task.id}`, { token: theirs })).status, 404);
+  assert.equal((await second.call("POST", "/api/sessions", { body: { username: "persistent", password: PASSWORD } })).status, 201);
+  assert.equal((await second.call("POST", "/api/users", { body: { username: "PERSISTENT", password: PASSWORD } })).status, 409);
+  await second.stop();
+});
+
+// AC4: the owner of a new task is the caller, whatever the body says.
+test("AC4: a task body cannot choose its owner", async () => {
+  const app = await start(join(dir, "owner.db"));
+  const alice = await register(app.call, "owner_alice");
+  const bob = await register(app.call, "owner_bob");
+  const bobId = (await app.call("POST", "/api/users", { body: { username: "owner_carol", password: PASSWORD } })).body.id;
+
+  const created = await app.call("POST", "/api/tasks", {
+    token: alice,
+    body: { title: "forged", user_id: bobId, userId: bobId, owner: "owner_bob" },
+  });
+  assert.equal(created.status, 201);
+  assert.deepEqual((await app.call("GET", "/api/tasks", { token: bob })).body, []);
+  assert.equal((await app.call("GET", `/api/tasks/${created.body.id}`, { token: alice })).status, 200);
+
+  // Nor can a PATCH hand a task to someone else.
+  const patched = await app.call("PATCH", `/api/tasks/${created.body.id}`, { token: alice, body: { user_id: bobId, done: true } });
+  assert.equal(patched.status, 200);
+  assert.deepEqual((await app.call("GET", "/api/tasks", { token: bob })).body, []);
+  assert.equal((await app.call("GET", `/api/tasks/${created.body.id}`, { token: alice })).body.done, true);
+  await app.stop();
+});
+
+// AC8: what the server sends as the page. The behaviour in a browser was checked by hand.
+test("AC8: the page offers sign-up, sign-in and sign-out, with labelled fields and an alert area", async () => {
+  const app = await start(join(dir, "page.db"));
+  const html = await (await fetch(`${app.base}/`)).text();
+  const script = await (await fetch(`${app.base}/app.js`)).text();
+  await app.stop();
+
+  assert.match(html, /<form[^>]*id="sign-in"/);
+  assert.match(html, /<form[^>]*id="sign-up"/);
+  assert.match(html, /<button[^>]*id="sign-out"/);
+  assert.match(html, /id="error"[^>]*role="alert"|role="alert"[^>]*id="error"/);
+  // Every field of the two account forms has a visible label tied to it, and passwords are masked.
+  for (const form of ["sign-in", "sign-up"]) {
+    const block = html.slice(html.indexOf(`id="${form}"`), html.indexOf("</form>", html.indexOf(`id="${form}"`)));
+    const inputs = [...block.matchAll(/<input\b[^>]*>/g)].map((m) => m[0]);
+    assert.equal(inputs.length, 2, form);
+    for (const input of inputs) {
+      const id = /\bid="([^"]+)"/.exec(input)?.[1];
+      assert.ok(id, `${form}: input has an id`);
+      assert.match(block, new RegExp(`<label[^>]*for="${id}"[^>]*>[^<]+</label>`), `${form}: label for ${id}`);
+    }
+    assert.match(block, /type="password"[^>]*autocomplete="(current|new)-password"/);
+    assert.match(block, /type="submit"/);
+  }
+  // The task list is not shown to a signed-out visitor, and the token is sent as a Bearer header.
+  assert.match(html, /<section[^>]*id="signed-in"[^>]*\bhidden\b/);
+  assert.match(script, /authorization/i);
+  assert.match(script, /Bearer \$\{/);
+  assert.ok(!/localStorage/.test(script), "the token is not kept in localStorage");
+  assert.ok(!/innerHTML/.test(script), "server text is never injected as HTML");
+});
