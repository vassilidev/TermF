+async function openAndDone() {
+  const open = await call("POST", "/api/tasks", { title: "Still open" });
+  const done = await call("POST", "/api/tasks", { title: "Already done" });
+  await call("PATCH", `/api/tasks/${done.body.id}`, { done: true });
+  return { openId: open.body.id as number, doneId: done.body.id as number };
+}
+
+test("lists only the open tasks with ?done=false", async () => {
+  const { openId, doneId } = await openAndDone();
+  const list = await call("GET", "/api/tasks?done=false");
+  assert.equal(list.status, 200);
+  assert.ok(list.body.every((t: any) => t.done === false));
+  assert.ok(list.body.some((t: any) => t.id === openId));
+  assert.ok(!list.body.some((t: any) => t.id === doneId));
+});
+
+test("?done=true excludes the open tasks", async () => {
+  const { openId, doneId } = await openAndDone();
+  const list = await call("GET", "/api/tasks?done=true");
+  assert.ok(list.body.some((t: any) => t.id === doneId));
+  assert.ok(!list.body.some((t: any) => t.id === openId));
+});
+
+test("lists every task without the done parameter", async () => {
+  const { openId, doneId } = await openAndDone();
+  const list = await call("GET", "/api/tasks");
+  assert.ok(list.body.some((t: any) => t.id === openId));
+  assert.ok(list.body.some((t: any) => t.id === doneId));
+});
+
+test("rejects other values of done with a 400", async () => {
+  for (const value of ["yes", "", "TRUE", "1"]) {
+    const res = await call("GET", `/api/tasks?done=${value}`);
+    assert.equal(res.status, 400, `done=${value}`);
+    assert.deepEqual(res.body, { error: "done must be true or false" });
+  }
+});
+
 test("serves the page", async () => {
