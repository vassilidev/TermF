diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 1fa1bd8..892157a 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -69,5 +69,84 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+async function raw(method: string, path: string, text: string) {
+  const res = await fetch(base + path, { method, headers: { "content-type": "application/json" }, body: text });
+  return { status: res.status, body: await res.json() };
+}
+
+async function count() {
+  return (await call("GET", "/api/tasks")).body.length;
+}
+
+test("creating a task without a usable title is a 400 and creates nothing", async () => {
+  const before = await count();
+  for (const body of [{}, { title: "" }, { title: "   " }, { title: 5 }, { title: null }, { title: ["a"] }, null, []]) {
+    const res = await call("POST", "/api/tasks", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  assert.equal(await count(), before);
+});
+
+test("titles are saved trimmed and limited to 200 characters", async () => {
+  const created = await call("POST", "/api/tasks", { title: "  padded  " });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.title, "padded");
+  const ok = await call("POST", "/api/tasks", { title: ` ${"a".repeat(200)} ` });
+  assert.equal(ok.status, 201);
+  assert.equal(ok.body.title.length, 200);
+  const before = await count();
+  const long = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, { error: "title must be at most 200 characters" });
+  assert.equal(await count(), before);
+});
+
+test("updating a task applies the same title rules", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Keep me" });
+  const path = `/api/tasks/${created.body.id}`;
+  for (const title of ["", "  ", 5, null]) {
+    const res = await call("PATCH", path, { title });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  const long = await call("PATCH", path, { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, { error: "title must be at most 200 characters" });
+  const trimmed = await call("PATCH", path, { title: "  New  " });
+  assert.equal(trimmed.body.title, "New");
+  const doneOnly = await call("PATCH", path, { done: true });
+  assert.equal(doneOnly.status, 200);
+  assert.equal(doneOnly.body.title, "New");
+  assert.equal((await call("GET", path)).body.title, "New");
+});
+
+test("a body that is not valid JSON is a 400", async () => {
+  for (const [method, path] of [["POST", "/api/tasks"], ["PATCH", "/api/tasks/1"]]) {
+    const res = await raw(method, path, "{not json");
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "invalid JSON body" });
+  }
+});
+
+test("an unexpected error is a 500 that hides the internal message", async () => {
+  const logged: unknown[] = [];
+  const original = console.error;
+  console.error = (...args: unknown[]) => void logged.push(args);
+  const failing = createServer();
+  try {
+    await new Promise<void>((resolve) => failing.listen(0, "127.0.0.1", resolve));
+    failing.emit("close"); // closes the database under the running server, so every query throws
+    failing.removeAllListeners("close"); // the database is already closed
+    const res = await fetch(`http://127.0.0.1:${(failing.address() as any).port}/api/tasks`);
+    assert.equal(res.status, 500);
+    assert.deepEqual(await res.json(), { error: "internal error" });
+    assert.equal(logged.length, 1);
+  } finally {
+    console.error = original;
+    failing.close();
+  }
+});
