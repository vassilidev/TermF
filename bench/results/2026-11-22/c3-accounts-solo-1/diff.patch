+import { createHash, randomBytes, scrypt, scryptSync, timingSafeEqual } from "node:crypto";
+import type { Db } from "./db.ts";
+
+export interface User {
+  id: number;
+  username: string;
+}
+
+const USERNAME = /^[a-z0-9_]{3,32}$/;
+const MIN_PASSWORD = 10;
+const SCRYPT = { N: 16384, r: 8, p: 1 };
+const KEY_LENGTH = 64;
+const TOKEN_BYTES = 32;
+
+/** Lowercases a username and checks it; returns undefined when it is not valid. */
+export function normalizeUsername(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const username = value.toLowerCase();
+  return USERNAME.test(username) ? username : undefined;
+}
+
+export const isPasswordLongEnough = (value: unknown): value is string =>
+  typeof value === "string" && value.length >= MIN_PASSWORD;
+
+function derive(password: string, salt: any, params: { N: number; r: number; p: number }, length: number): Promise<any> {
+  return new Promise((resolve, reject) => {
+    // maxmem leaves room for the parameters of stored hashes, should they ever be raised.
+    scrypt(password, salt, length, { ...params, maxmem: 256 * 1024 * 1024 }, (err: Error | null, key: any) =>
+      err ? reject(err) : resolve(key),
+    );
+  });
+}
+
+/** `scrypt$N$r$p$salt$hash`, the salt and the hash in base64. */
+export async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  const key = await derive(password, salt, SCRYPT, KEY_LENGTH);
+  return ["scrypt", SCRYPT.N, SCRYPT.r, SCRYPT.p, salt.toString("base64"), key.toString("base64")].join("$");
+}
+
+// Checked against when the username does not exist, so that a miss costs as much as a wrong password.
+const DUMMY_HASH = (() => {
+  const salt = randomBytes(16);
+  const key = scryptSync(randomBytes(16), salt, KEY_LENGTH, SCRYPT);
+  return ["scrypt", SCRYPT.N, SCRYPT.r, SCRYPT.p, salt.toString("base64"), key.toString("base64")].join("$");
+})();
+
+export async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const [scheme, n, r, p, salt, hash] = stored.split("$");
+  if (scheme !== "scrypt" || hash === undefined) return false;
+  const expected = Buffer.from(hash, "base64");
+  const key = await derive(password, Buffer.from(salt, "base64"), { N: Number(n), r: Number(r), p: Number(p) }, expected.length);
+  return timingSafeEqual(key, expected);
+}
+
+export function findUserByName(db: Db, username: string): (User & { password_hash: string }) | undefined {
+  return db.prepare("SELECT id, username, password_hash FROM users WHERE username = ?").get(username) as any;
+}
+
+/** Creates the account; undefined when the username is taken. `username` must be normalized. */
+export async function createUser(db: Db, username: string, password: string): Promise<User | undefined> {
+  const passwordHash = await hashPassword(password);
+  try {
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO users (username, password_hash) VALUES (?, ?)")
+      .run(username, passwordHash);
+    return { id: Number(lastInsertRowid), username };
+  } catch (err: any) {
+    if (/UNIQUE/.test(String(err?.message))) return undefined;
+    throw err;
+  }
+}
+
+/** The user for these credentials, or undefined. Same work and same result whether the username or the password is wrong. */
+export async function authenticate(db: Db, username: unknown, password: unknown): Promise<User | undefined> {
+  const name = typeof username === "string" ? username.toLowerCase() : "";
+  const user = findUserByName(db, name);
+  const ok = await verifyPassword(typeof password === "string" ? password : "", user?.password_hash ?? DUMMY_HASH);
+  return user && ok ? { id: user.id, username: user.username } : undefined;
+}
+
+const hashToken = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+/** Opens a session and returns its token; only the hash of the token is stored. */
+export function createSession(db: Db, userId: number): string {
+  const token = randomBytes(TOKEN_BYTES).toString("base64url");
+  db.prepare("INSERT INTO sessions (token_hash, user_id) VALUES (?, ?)").run(hashToken(token), userId);
+  return token;
+}
+
+/** The user of the `Authorization` header, or undefined when it is missing, malformed or unknown. */
+export function userForHeader(db: Db, header: unknown): { user: User; token: string } | undefined {
+  if (typeof header !== "string") return undefined;
+  const match = /^Bearer ([A-Za-z0-9_-]{1,256})$/i.exec(header);
+  if (!match) return undefined;
+  const token = match[1];
+  const user = db
+    .prepare("SELECT users.id, users.username FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.token_hash = ?")
+    .get(hashToken(token)) as User | undefined;
+  return user && { user: { id: user.id, username: user.username }, token };
+}
+
+export function deleteSession(db: Db, token: string): void {
+  db.prepare("DELETE FROM sessions WHERE token_hash = ?").run(hashToken(token));
+}
