+/** Replaces the links of a task with the given (already valid) tags. */
+function setTags(db: Db, taskId: number, tags: string[]): void {
+  db.prepare("DELETE FROM task_tags WHERE task_id = ?").run(taskId);
+  for (const name of tags) {
+    db.prepare("INSERT OR IGNORE INTO tags (name) VALUES (?)").run(name);
+    db.prepare("INSERT INTO task_tags (task_id, tag_id) SELECT ?, id FROM tags WHERE name = ?").run(taskId, name);
+  }
+  // A tag no task uses any more is not kept.
+  db.exec("DELETE FROM tags WHERE id NOT IN (SELECT tag_id FROM task_tags)");
+}
+
+function inTransaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (err) {
+    db.exec("ROLLBACK");
+    throw err;
+  }
