+/** `tags` must already be valid (see parseTags). */
+export function createTask(db: Db, title: string, tags: string[] = []): Task {
+  return inTransaction(db, () => {
+    const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title) VALUES (?)").run(title);
+    const id = Number(lastInsertRowid);
+    setTags(db, id, tags);
+    return getTask(db, id)!;
+  });
+}
+
+/** `changes.tags`, when given, must already be valid (see parseTags) and replaces the whole list. */
+export function updateTask(
+  db: Db,
+  id: number,
+  changes: { title?: string; done?: boolean; tags?: string[] },
+): Task | undefined {
+  return inTransaction(db, () => {
+    const task = getTask(db, id);
+    if (!task) return undefined;
+    const title = changes.title ?? task.title;
+    const done = changes.done ?? task.done;
+    db.prepare("UPDATE tasks SET title = ?, done = ? WHERE id = ?").run(title, done ? 1 : 0, id);
+    if (changes.tags !== undefined) setTags(db, id, changes.tags);
+    return getTask(db, id);
+  });
 }
 
 export function deleteTask(db: Db, id: number): boolean {
-  return db.prepare("DELETE FROM tasks WHERE id = ?").run(id).changes > 0;
+  return inTransaction(db, () => {
+    const deleted = db.prepare("DELETE FROM tasks WHERE id = ?").run(id).changes > 0;
+    db.exec("DELETE FROM tags WHERE id NOT IN (SELECT tag_id FROM task_tags)");
+    return deleted;
+  });
+}
+
+export function listTags(db: Db): { name: string; count: number }[] {
+  return db
+    .prepare(
+      `SELECT t.name, COUNT(*) AS count FROM tags t JOIN task_tags tt ON tt.tag_id = t.id
+       GROUP BY t.id ORDER BY t.name`,
+    )
+    .all() as { name: string; count: number }[];
 }
