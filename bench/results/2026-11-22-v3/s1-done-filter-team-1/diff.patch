diff --git a/src/tasks.ts b/src/tasks.ts
index 4fd5acb..3ab8d62 100644
--- a/src/tasks.ts
+++ b/src/tasks.ts
@@ -14,11 +14,11 @@ interface Row {
   created_at: string;
 }
 
 const toTask = (row: Row): Task => ({ ...row, done: row.done === 1 });
 
-export function listTasks(db: Db, filter: { done?: string } = {}): Task[] {
+export function listTasks(db: Db, filter: { done?: boolean } = {}): Task[] {
   if (filter.done === undefined) {
     return (db.prepare("SELECT * FROM tasks ORDER BY id").all() as Row[]).map(toTask);
   }
   const rows = db.prepare("SELECT * FROM tasks WHERE done = ? ORDER BY id").all(filter.done ? 1 : 0) as Row[];
   return rows.map(toTask);
diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 1fa1bd8..5c9d40e 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -64,10 +64,38 @@ test("lists only the done tasks with ?done=true", async () => {
   const list = await call("GET", "/api/tasks?done=true");
   assert.ok(list.body.length > 0);
   assert.ok(list.body.every((t: any) => t.done));
 });
 
+test("lists only the open tasks with ?done=false", async () => {
+  const open = await call("POST", "/api/tasks", { title: "Still open" });
+  const finished = await call("POST", "/api/tasks", { title: "Already finished" });
+  await call("PATCH", `/api/tasks/${finished.body.id}`, { done: true });
+  const list = await call("GET", "/api/tasks?done=false");
+  assert.equal(list.status, 200);
+  assert.ok(list.body.some((t: any) => t.id === open.body.id));
+  assert.ok(!list.body.some((t: any) => t.id === finished.body.id));
+  assert.ok(list.body.every((t: any) => t.done === false));
+});
+
+test("lists every task without ?done", async () => {
+  const open = await call("POST", "/api/tasks", { title: "Open one" });
+  const finished = await call("POST", "/api/tasks", { title: "Done one" });
+  await call("PATCH", `/api/tasks/${finished.body.id}`, { done: true });
+  const list = await call("GET", "/api/tasks");
+  const ids = list.body.map((t: any) => t.id);
+  assert.ok(ids.includes(open.body.id) && ids.includes(finished.body.id));
+});
+
+test("any other value of done is a 400", async () => {
+  for (const q of ["yes", "", "TRUE", "1"]) {
+    const res = await call("GET", `/api/tasks?done=${q}`);
+    assert.equal(res.status, 400, `done=${q}`);
+    assert.deepEqual(res.body, { error: "done must be true or false" });
+  }
+});
+
