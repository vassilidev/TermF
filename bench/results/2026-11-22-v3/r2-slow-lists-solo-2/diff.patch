+// `key` reads the sort key of a task, `after` the condition for the tasks that come after a cursor holding that key
+// (written so that SQLite can seek the sort's index to the cursor instead of reading from the start).
+interface Sort {
+  order: string;
+  key: (task: Task) => (string | number | null)[];
+  after: (key: (string | number | null)[]) => { sql: string; args: (string | number | null)[] };
+}
+
+const SORTS: Record<string, Sort> = {
+  position: {
+    order: "t.position, t.id",
+    key: (t) => [t.position, t.id],
+    after: ([p, id]) => ({ sql: "(t.position, t.id) > (?, ?)", args: [p, id] }),
+  },
+  due_date: {
+    order: "t.due_date IS NULL, t.due_date, t.id",
+    key: (t) => [t.due_date, t.id],
+    after: ([d, id]) =>
+      d === null
+        ? { sql: "(t.due_date IS NULL AND t.id > ?)", args: [id] }
+        : { sql: "(t.due_date IS NULL OR t.due_date > ? OR (t.due_date = ? AND t.id > ?))", args: [d, d, id] },
+  },
+  priority: {
+    order: "t.priority DESC, t.id",
+    key: (t) => [t.priority, t.id],
+    after: ([p, id]) => ({ sql: "t.priority <= ? AND (t.priority < ? OR (t.priority = ? AND t.id > ?))", args: [p, p, p, id] }),
+  },
+  created: {
+    order: "t.created_at DESC, t.id DESC",
+    key: (t) => [t.created_at, t.id],
+    after: ([c, id]) => ({ sql: "(t.created_at, t.id) < (?, ?)", args: [c, id] }),
+  },
 };
 
+const DEFAULT_LIMIT = 50;
+const MAX_LIMIT = 200;
+
+function encodeCursor(listId: number, sort: string, key: (string | number | null)[]): string {
+  return Buffer.from(JSON.stringify([listId, sort, ...key])).toString("base64url");
+}
+
+/** The sort key held by `cursor`; 400 unless it was made for this list and this sort. */
+function decodeCursor(cursor: string, listId: number, sort: string): (string | number | null)[] {
+  const invalid = badRequest("invalid cursor");
+  let parts: unknown;
+  try {
+    parts = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
+  } catch {
+    throw invalid;
+  }
+  if (!Array.isArray(parts) || parts.length !== 4 || parts[0] !== listId || parts[1] !== sort) throw invalid;
+  const [, , value, id] = parts;
+  if (!Number.isInteger(id)) throw invalid;
+  if (sort === "due_date" ? value !== null && typeof value !== "string" : sort === "created" ? typeof value !== "string" : !Number.isInteger(value)) {
+    throw invalid;
+  }
+  return [value, id];
+}
