+// Each sort is an ascending (or, for `created`, descending) row value, so that a page is "the rows after the last one
+// seen": `after` below, bound to the same row value taken from the cursor. The expressions match the indexes.
+interface Sort {
+  /** The columns of the sort key, in order; the last one is the id. */
+  keys: string[];
+  order: string;
+  /** The comparison that selects the rows after the cursor. */
+  after: ">" | "<";
+  /** The value of each key in a row, as stored in a cursor. */
+  fields: (keyof Task | "due_key" | "priority_key")[];
+}
+const SORTS: Record<string, Sort> = {
+  position: { keys: ["t.position", "t.id"], order: "t.position, t.id", after: ">", fields: ["position", "id"] },
+  // Tasks without a due date come last (`due_key`), by id; highest priority first (`priority_key`, see db.ts).
+  due_date: { keys: ["t.due_key", "t.id"], order: "t.due_key, t.id", after: ">", fields: ["due_key", "id"] },
+  priority: { keys: ["t.priority_key", "t.id"], order: "t.priority_key, t.id", after: ">", fields: ["priority_key", "id"] },
+  created: { keys: ["t.created_at", "t.id"], order: "t.created_at DESC, t.id DESC", after: "<", fields: ["created_at", "id"] },
 };
 
+const DEFAULT_LIMIT = 50;
+const MAX_LIMIT = 200;
+
+/** A cursor names the list and the sort it came from, and the sort key of the last task of the page. */
+function encodeCursor(listId: number, sort: string, task: Task): string {
+  const key = SORTS[sort].fields.map((field) => (task as any)[field]);
+  return Buffer.from(JSON.stringify({ l: listId, s: sort, k: key })).toString("base64url");
+}
+
+/** The key values of a cursor, in the form the sort compares them. */
+function decodeCursor(cursor: string, listId: number, sort: string): (string | number)[] {
+  const invalid = badRequest("invalid cursor");
+  let data: any;
+  try {
+    data = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
+  } catch {
+    throw invalid;
+  }
+  const fields = SORTS[sort].fields;
+  if (data === null || typeof data !== "object" || data.l !== listId || data.s !== sort) throw invalid;
+  if (!Array.isArray(data.k) || data.k.length !== fields.length) throw invalid;
+  const k: unknown[] = data.k;
+  const id = k[k.length - 1];
+  if (!Number.isInteger(id)) throw invalid;
+  switch (sort) {
+    case "position":
+    case "priority":
+      // priority: the key is -priority, 0 to -3.
+      if (!Number.isInteger(k[0]) || (sort === "priority" && ((k[0] as number) > 0 || (k[0] as number) < -3))) throw invalid;
+      return [k[0] as number, id as number];
+    case "due_date":
+      if (typeof k[0] !== "string" || k[0].length > 10) throw invalid;
+      return [k[0], id as number];
+    default:
+      if (typeof k[0] !== "string") throw invalid;
+      return [k[0], id as number];
+  }
+}
