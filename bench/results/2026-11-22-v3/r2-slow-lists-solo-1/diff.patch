+
+/** Every task of a list, page by page; the pages must not overlap. */
+async function allPages(listId: number, auth: Auth, query: string, limit: number) {
+  const ids: number[] = [];
+  const titlesSeen: string[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url = `/api/lists/${listId}/tasks?limit=${limit}&${query}${cursor ? `&cursor=${cursor}` : ""}`;
+    const res = await app.call("GET", url, undefined, auth);
+    assert.equal(res.status, 200);
+    assert.ok(res.body.items.length <= limit);
+    for (const task of res.body.items) {
+      ids.push(task.id);
+      titlesSeen.push(task.title);
+    }
+    cursor = res.body.next_cursor;
+    pages++;
+  } while (cursor !== null && pages < 100);
+  assert.equal(new Set(ids).size, ids.length);
+  return titlesSeen;
+}
+
