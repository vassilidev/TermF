diff --git a/public/sharing.js b/public/sharing.js
new file mode 100644
index 0000000..bc6125b
--- /dev/null
+++ b/public/sharing.js
@@ -0,0 +1,106 @@
+import { api, element, showError } from "./api.js";
+
+const section = document.querySelector("#sharing");
+const memberItems = document.querySelector("#members");
+const pendingBox = document.querySelector("#pending");
+const pendingItems = document.querySelector("#pending-items");
+const inviteForm = document.querySelector("#invite-form");
+const inviteRole = document.querySelector("#invite-role");
+const inviteHours = document.querySelector("#invite-hours");
+const inviteLink = document.querySelector("#invite-link");
+const linkInput = document.querySelector("#invite-url");
+
+let current = null;
+let members = [];
+
+export function initSharing(onChange) {
+  inviteForm.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    try {
+      const body = { role: inviteRole.value };
+      if (inviteHours.value) body.expires_in_hours = Number(inviteHours.value);
+      const invitation = await api(`/api/lists/${current.id}/invitations`, { method: "POST", body });
+      linkInput.value = invitation.url;
+      inviteLink.hidden = false;
+      linkInput.select();
+      showError(null);
+      await renderPending();
+    } catch (err) {
+      showError(err);
+    }
+  });
+  document.querySelector("#copy-link").addEventListener("click", async () => {
+    linkInput.select();
+    try {
+      await navigator.clipboard.writeText(linkInput.value);
+    } catch {
+      document.execCommand?.("copy");
+    }
+  });
+  addEventListener("members-changed", () => onChange?.());
+}
+
+/** The members of the list, for the sharing section and the assignee choices. */
+export function currentMembers() {
+  return members;
+}
+
+/** Shows who the list is shared with; the owner also gets the invitations. */
+export async function showSharing(list) {
+  current = list;
+  inviteLink.hidden = true;
+  linkInput.value = "";
+  const owner = list.role === "owner";
+  inviteForm.hidden = !owner;
+  pendingBox.hidden = !owner;
+  members = await api(`/api/lists/${list.id}/members`);
+  renderMembers(owner);
+  if (owner) await renderPending();
+  section.hidden = members.length < 2 && !owner;
+}
+
+function renderMembers(owner) {
+  memberItems.replaceChildren(
+    ...members.map((member) => {
+      const item = element("li", {}, element("span", { textContent: `${member.username} ` }), element("span", { className: "tag", textContent: member.role }));
+      if (owner && member.role !== "owner") {
+        const remove = element("button", { type: "button", textContent: "Remove" });
+        remove.setAttribute("aria-label", `Remove ${member.username}`);
+        remove.addEventListener("click", async () => {
+          if (!confirm(`Remove ${member.username} from "${current.name}"?`)) return;
+          try {
+            await api(`/api/lists/${current.id}/members/${member.id}`, { method: "DELETE" });
+            dispatchEvent(new Event("members-changed"));
+          } catch (err) {
+            showError(err);
+          }
+        });
+        item.append(" ", remove);
+      }
+      return item;
+    }),
+  );
+}
+
+async function renderPending() {
+  const invitations = await api(`/api/lists/${current.id}/invitations`);
+  pendingItems.replaceChildren(
+    ...invitations.map((invitation) => {
+      const revoke = element("button", { type: "button", textContent: "Revoke" });
+      revoke.addEventListener("click", async () => {
+        try {
+          await api(`/api/lists/${current.id}/invitations/${invitation.id}`, { method: "DELETE" });
+          await renderPending();
+        } catch (err) {
+          showError(err);
+        }
+      });
+      return element(
+        "li",
+        {},
+        element("span", { textContent: `${invitation.role}, expires ${new Date(invitation.expires_at).toLocaleString()} ` }),
+        revoke,
+      );
+    }),
+  );
+}
