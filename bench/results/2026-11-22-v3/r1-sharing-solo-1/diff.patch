index 0000000..d4c08ec
--- /dev/null
+++ b/src/sharing.ts
@@ -0,0 +1,128 @@
+import { randomBytes } from "node:crypto";
+import { hashToken, type User } from "./auth.ts";
+import { now, transaction, type Db } from "./db.ts";
+import { HttpError, badRequest, notFound } from "./http.ts";
+import { getList, loadList, roleOf, type ListView } from "./lists.ts";
+import * as activity from "./activity.ts";
+
+export type MemberRole = "editor" | "viewer";
+
+export interface Member {
+  id: number;
+  username: string;
+  role: "owner" | MemberRole;
+}
+
+export interface InvitationView {
+  id: number;
+  role: MemberRole;
+  created_at: string;
+  expires_at: string;
+}
+
+const ROLES: MemberRole[] = ["editor", "viewer"];
+const DEFAULT_HOURS = 72;
+const MAX_HOURS = 720;
+
+/**
+ * The address the page is served at, for the invitation links: `PUBLIC_URL` when set, else the `Host` of the
+ * request. The link only goes back to whoever asked for it.
+ */
+function baseUrl(req: any): string {
+  const configured = process.env.PUBLIC_URL;
+  if (configured) return configured.replace(/\/+$/, "");
+  const host = String(req.headers.host ?? "");
+  return /^[A-Za-z0-9.:\[\]-]{1,255}$/.test(host) ? `http://${host}` : "http://localhost";
+}
+
+/** Owner and members of a list, the owner first. Anyone with access to the list can see them. */
+export function listMembers(db: Db, user: User, listId: number): Member[] {
+  const list = loadList(db, user, listId);
+  const owner = db.prepare("SELECT id, username FROM users WHERE id = ?").get(list.owner_id) as { id: number; username: string };
+  const members = db
+    .prepare(
+      `SELECT u.id, u.username, m.role FROM list_members m JOIN users u ON u.id = m.user_id
+       WHERE m.list_id = ? ORDER BY u.username, u.id`,
+    )
+    .all(listId) as unknown as Member[];
+  return [{ id: owner.id, username: owner.username, role: "owner" }, ...members];
+}
+
+export async function removeMember(db: Db, user: User, listId: number, userId: number): Promise<void> {
+  const list = loadList(db, user, listId, "owner");
+  if (userId === list.owner_id) throw badRequest("the owner of a list cannot be removed");
+  const member = db.prepare("SELECT role FROM list_members WHERE list_id = ? AND user_id = ?").get(listId, userId) as { role: string } | undefined;
+  if (!member) throw notFound("member not found");
+  transaction(db, () => {
+    db.prepare("DELETE FROM list_members WHERE list_id = ? AND user_id = ?").run(listId, userId);
+    // Someone without access to the list can no longer be given its tasks, nor be reminded of them.
+    const assigned = db.prepare("SELECT id FROM tasks WHERE list_id = ? AND assignee_id = ?").all(listId, userId) as { id: number }[];
+    db.prepare("UPDATE tasks SET assignee_id = NULL, updated_at = ? WHERE list_id = ? AND assignee_id = ?").run(now(), listId, userId);
+    for (const { id } of assigned) {
+      db.prepare("DELETE FROM jobs WHERE kind = 'reminder' AND done_at IS NULL AND json_extract(payload, '$.task_id') = ?").run(id);
+    }
+  });
+  await activity.record(db, { list_id: listId, user_id: user.id, action: "member.removed", detail: { user_id: userId, role: member.role } });
+}
+
+export async function createInvitation(db: Db, user: User, listId: number, body: any, req: any) {
+  loadList(db, user, listId, "owner");
+  if (!ROLES.includes(body.role)) throw badRequest("role must be viewer or editor");
+  const hours = body.expires_in_hours ?? DEFAULT_HOURS;
+  if (typeof hours !== "number" || !Number.isFinite(hours) || hours <= 0 || hours > MAX_HOURS) {
+    throw badRequest(`expires_in_hours must be a number above 0, ${MAX_HOURS} at most`);
+  }
+  const token = randomBytes(32).toString("base64url");
+  const created = new Date();
+  const expiresAt = new Date(created.getTime() + hours * 3_600_000).toISOString();
+  // The token is only stored hashed: reading the database does not give access to the lists.
+  const { lastInsertRowid } = transaction(db, () => {
+    db.prepare("DELETE FROM invitations WHERE list_id = ? AND expires_at <= ?").run(listId, created.toISOString());
+    return db
+      .prepare("INSERT INTO invitations (list_id, token_hash, role, created_by, created_at, expires_at) VALUES (?, ?, ?, ?, ?, ?)")
+      .run(listId, hashToken(token), body.role, user.id, created.toISOString(), expiresAt);
+  });
+  return { id: Number(lastInsertRowid), token, url: `${baseUrl(req)}/#invitation=${token}`, role: body.role as MemberRole, expires_at: expiresAt };
+}
+
+/** The invitations not yet accepted nor expired. The tokens are not kept: only the one answered at creation exists. */
+export function listInvitations(db: Db, user: User, listId: number): InvitationView[] {
+  loadList(db, user, listId, "owner");
+  return db
+    .prepare("SELECT id, role, created_at, expires_at FROM invitations WHERE list_id = ? AND expires_at > ? ORDER BY id")
+    .all(listId, now()) as unknown as InvitationView[];
+}
+
+export function revokeInvitation(db: Db, user: User, listId: number, invitationId: number): void {
+  loadList(db, user, listId, "owner");
+  const { changes } = db.prepare("DELETE FROM invitations WHERE id = ? AND list_id = ?").run(invitationId, listId);
+  if (!changes) throw notFound("invitation not found");
+}
+
+/**
+ * Makes `user` a member of the invitation's list. An invitation is used once. Someone who already has access
+ * keeps it, except a viewer holding an editor invitation, who becomes an editor.
+ */
+export async function acceptInvitation(db: Db, user: User, token: string): Promise<ListView> {
+  const outcome = transaction(db, () => {
+    const invitation = db
+      .prepare("SELECT id, list_id, role, expires_at FROM invitations WHERE token_hash = ?")
+      .get(hashToken(token)) as { id: number; list_id: number; role: MemberRole; expires_at: string } | undefined;
+    if (!invitation) throw notFound("invitation not found");
+    if (invitation.expires_at <= now()) throw new HttpError(410, "invitation expired");
+    const current = roleOf(db, user, invitation.list_id);
+    if (current === "owner" || current === "editor" || (current === "viewer" && invitation.role === "viewer")) {
+      return { listId: invitation.list_id, joined: false };
+    }
+    db.prepare(
+      `INSERT INTO list_members (list_id, user_id, role) VALUES (?, ?, ?)
+       ON CONFLICT (list_id, user_id) DO UPDATE SET role = excluded.role`,
+    ).run(invitation.list_id, user.id, invitation.role);
+    db.prepare("DELETE FROM invitations WHERE id = ?").run(invitation.id);
+    return { listId: invitation.list_id, joined: true, role: invitation.role };
+  });
+  if (outcome.joined) {
+    await activity.record(db, { list_id: outcome.listId, user_id: user.id, action: "member.joined", detail: { role: outcome.role } });
+  }
+  return getList(db, user, outcome.listId);
+}
