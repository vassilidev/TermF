   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+const DUE_ERROR = { error: "due_date must be a date in YYYY-MM-DD format" };
+
+test("a task has a null due_date by default", async () => {
+  const created = await call("POST", "/api/tasks", { title: "No date" });
+  assert.equal(created.body.due_date, null);
+});
+
+test("creates a task with a due date, and null means none", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Dated", due_date: "2026-03-04" });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.due_date, "2026-03-04");
+  assert.equal((await call("GET", `/api/tasks/${created.body.id}`)).body.due_date, "2026-03-04");
+  const none = await call("POST", "/api/tasks", { title: "Null", due_date: null });
+  assert.equal(none.body.due_date, null);
+});
+
+test("PATCH sets, keeps and clears the due date", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Patch me" });
+  const id = created.body.id;
+  assert.equal((await call("PATCH", `/api/tasks/${id}`, { due_date: "2026-12-31" })).body.due_date, "2026-12-31");
+  assert.equal((await call("PATCH", `/api/tasks/${id}`, { done: true })).body.due_date, "2026-12-31");
+  const cleared = await call("PATCH", `/api/tasks/${id}`, { due_date: null });
+  assert.equal(cleared.status, 200);
+  assert.equal(cleared.body.due_date, null);
+});
+
+for (const bad of ["2026-1-5", "tomorrow", "2026-02-30", "2026-13-01", "", 20260105, true]) {
+  test(`rejects due_date ${JSON.stringify(bad)} and saves nothing`, async () => {
+    const before = (await call("GET", "/api/tasks")).body.length;
+    const post = await call("POST", "/api/tasks", { title: "Bad", due_date: bad });
+    assert.equal(post.status, 400);
+    assert.deepEqual(post.body, DUE_ERROR);
+    assert.equal((await call("GET", "/api/tasks")).body.length, before);
+
+    const created = await call("POST", "/api/tasks", { title: "Keep", due_date: "2026-05-05" });
+    const patch = await call("PATCH", `/api/tasks/${created.body.id}`, { title: "Changed", done: true, due_date: bad });
+    assert.equal(patch.status, 400);
+    assert.deepEqual(patch.body, DUE_ERROR);
+    const read = await call("GET", `/api/tasks/${created.body.id}`);
+    assert.equal(read.body.title, "Keep");
+    assert.equal(read.body.done, false);
+    assert.equal(read.body.due_date, "2026-05-05");
+  });
+}
+
+test("a database at the first migration upgrades with due_date null", () => {
+  const db = new DatabaseSync(":memory:");
+  db.exec(`CREATE TABLE tasks (
+     id INTEGER PRIMARY KEY AUTOINCREMENT,
+     title TEXT NOT NULL,
+     done INTEGER NOT NULL DEFAULT 0,
+     created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+   )`);
+  db.exec("PRAGMA user_version = 1");
+  db.prepare("INSERT INTO tasks (title) VALUES (?)").run("Old row");
+  migrate(db);
+  const tasks = listTasks(db);
+  assert.equal(tasks.length, 1);
