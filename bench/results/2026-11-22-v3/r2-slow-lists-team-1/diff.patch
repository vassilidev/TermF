+test("the migration that adds the paging indexes upgrades a database at the previous version", () => {
+  const db = openDb();
+  db.exec("DROP INDEX tasks_list_position; DROP INDEX tasks_list_due_date; DROP INDEX tasks_list_priority; DROP INDEX tasks_list_created");
+  db.exec("DROP INDEX task_tags_task; DROP INDEX task_tags_tag; DROP INDEX comments_task; PRAGMA user_version = 6");
+  db.exec("INSERT INTO users (username, password_hash) VALUES ('old', 'x'); INSERT INTO lists (owner_id, name) VALUES (1, 'l')");
+  db.exec("INSERT INTO tasks (list_id, title, updated_at) VALUES (1, 'kept', 'x')");
+  migrate(db);
+  const names = (db.prepare("SELECT name FROM sqlite_master WHERE type = 'index'").all() as { name: string }[]).map((r) => r.name);
+  for (const name of ["tasks_list_position", "tasks_list_due_date", "tasks_list_priority", "tasks_list_created", "task_tags_task", "task_tags_tag", "comments_task"]) {
+    assert.ok(names.includes(name), name);
+  }
+  assert.equal((db.prepare("SELECT COUNT(*) AS n FROM tasks").get() as { n: number }).n, 1);
+  assert.equal((db.prepare("PRAGMA user_version").get() as { user_version: number }).user_version, 7);
+});
