+test("each sort keeps the documented order across pages", async () => {
+  const { auth, list } = await bigList();
+  const order = async (sort: string) =>
+    (await app.call("GET", `/api/lists/${list.id}/tasks?sort=${sort}&limit=200`, undefined, auth)).body.items as any[];
+  const byPosition = await order("position");
+  for (let i = 1; i < byPosition.length; i++) {
+    const a = byPosition[i - 1], b = byPosition[i];
+    assert.ok(a.position < b.position || (a.position === b.position && a.id < b.id));
+  }
+  const byDue = await order("due_date");
+  const dated = byDue.filter((t) => t.due_date !== null);
+  assert.equal(dated.length, 104);
+  assert.ok(byDue.slice(0, 104).every((t) => t.due_date !== null), "dated tasks come first");
+  assert.ok(byDue.slice(104).every((t) => t.due_date === null), "undated tasks come last");
+  for (let i = 1; i < byDue.length; i++) {
+    const a = byDue[i - 1], b = byDue[i];
+    if (a.due_date === b.due_date) assert.ok(a.id < b.id);
+    else if (a.due_date !== null && b.due_date !== null) assert.ok(a.due_date < b.due_date);
+  }
+  const byPriority = await order("priority");
+  for (let i = 1; i < byPriority.length; i++) {
+    const a = byPriority[i - 1], b = byPriority[i];
+    assert.ok(a.priority > b.priority || (a.priority === b.priority && a.id < b.id));
+  }
+  const byCreated = await order("created");
+  for (let i = 1; i < byCreated.length; i++) {
+    const a = byCreated[i - 1], b = byCreated[i];
+    assert.ok(a.created_at > b.created_at || (a.created_at === b.created_at && a.id > b.id));
+  }
+});
