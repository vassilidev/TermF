+
+async function walk(auth: Auth, listId: number, params: string, limit: number): Promise<{ ids: number[]; pages: number }> {
+  const ids: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const res: any = await app.call("GET", `/api/lists/${listId}/tasks?${params}&limit=${limit}${cursor ? `&cursor=${cursor}` : ""}`, undefined, auth);
+    assert.equal(res.status, 200, JSON.stringify(res.body));
+    assert.ok(res.body.items.length <= limit);
+    ids.push(...res.body.items.map((t: any) => t.id));
+    cursor = res.body.next_cursor;
+    pages++;
+    assert.ok(pages < 1000);
+  } while (cursor !== null);
+  return { ids, pages };
+}
