+test("the Load more button is hidden when there is no next page: its own display rule must not defeat the hidden attribute", () => {
+  const css = readFileSync(new URL("../public/style.css", import.meta.url), "utf8");
+  const rules = [...css.matchAll(/([^{}]+)\{([^}]*)\}/g)].map(([, selector, body]) => ({ selector: selector.trim(), body }));
+  const sets = (r: { body: string }) => /(^|;|\s)display\s*:/.test(r.body);
+  const own = rules.filter((r) => r.selector === "#load-more" && sets(r));
+  const guarded = rules.some((r) => /#load-more\[hidden\]/.test(r.selector) && /display\s*:\s*none/.test(r.body));
+  assert.ok(own.length === 0 || guarded, "#load-more sets display, so [hidden] needs its own display:none rule");
+});
