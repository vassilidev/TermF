+  // A good cursor of this list and sort is accepted, and a valid one for a null due date too.
+  const ok = await app.call("GET", `/api/lists/${list.id}/tasks?sort=due_date&cursor=${forge({ l: list.id, s: "due_date", k: [null, 1] })}`, undefined, auth);
