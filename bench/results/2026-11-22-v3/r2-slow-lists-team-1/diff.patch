+test("a cursor that is not one handed out for this list and sort is a 400", async () => {
+  const { auth, list } = await bigList();
+  const other = await setUp();
+  await makeTask(app, other.auth, other.list.id);
+  await makeTask(app, other.auth, other.list.id);
+  const page = (id: number, sort: string, auth: Auth) => app.call("GET", `/api/lists/${id}/tasks?sort=${sort}&limit=1`, undefined, auth);
+  const cursors: Record<string, string> = {};
+  for (const sort of SORT_NAMES) cursors[sort] = (await page(list.id, sort, auth)).body.next_cursor;
+  const otherCursor = (await page(other.list.id, "position", other.auth)).body.next_cursor;
+  const forge = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64url");
+  const bad: [string, string, string][] = [
+    ["garbage", "position", "not a cursor"],
+    ["empty", "position", ""],
+    ["base64 of not json", "position", Buffer.from("hello").toString("base64url")],
+    ["another list", "position", otherCursor],
+    ["another sort", "created", cursors.position],
+    ["another sort", "position", cursors.priority],
+    ["a sort that does not exist", "position", forge({ l: list.id, s: "title", k: [1, 1] })],
+    ["a string position", "position", forge({ l: list.id, s: "position", k: ["1", 1] })],
+    ["an SQL text", "position", forge({ l: list.id, s: "position", k: ["1 OR 1=1", 1] })],
+    ["an SQL text as id", "position", forge({ l: list.id, s: "position", k: [1, "1; DROP TABLE tasks"] })],
+    ["a float", "position", forge({ l: list.id, s: "position", k: [1.5, 1] })],
+    ["too short", "position", forge({ l: list.id, s: "position", k: [1] })],
+    ["too long", "position", forge({ l: list.id, s: "position", k: [1, 1, 1] })],
+    ["k not a list", "position", forge({ l: list.id, s: "position", k: "1,1" })],
+    ["a list as a string", "position", forge({ l: String(list.id), s: "position", k: [1, 1] })],
+    ["a null position", "position", forge({ l: list.id, s: "position", k: [null, 1] })],
+    ["a bad priority", "priority", forge({ l: list.id, s: "priority", k: [9, 1] })],
+    ["a bad date", "due_date", forge({ l: list.id, s: "due_date", k: ["tomorrow", 1] })],
+    ["a number as date", "due_date", forge({ l: list.id, s: "due_date", k: [20260101, 1] })],
+    ["a null created_at", "created", forge({ l: list.id, s: "created", k: [null, 1] })],
+    ["a number as created_at", "created", forge({ l: list.id, s: "created", k: [5, 1] })],
+    ["an array", "position", forge([list.id, "position", [1, 1]])],
+    ["null", "position", forge(null)],
+    ["bad characters", "position", `${cursors.position}=`],
+    ["too long text", "position", "A".repeat(5000)],
+  ];
+  for (const [name, sort, cursor] of bad) {
+    const res = await app.call("GET", `/api/lists/${list.id}/tasks?sort=${sort}&cursor=${encodeURIComponent(cursor)}`, undefined, auth);
+    assert.equal(res.status, 400, name);
+    assert.deepEqual(res.body, { error: "invalid cursor" }, name);
