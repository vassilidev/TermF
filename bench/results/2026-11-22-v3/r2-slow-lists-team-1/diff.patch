+// QA additions: gaps found against the acceptance criteria
+
+import { readFileSync } from "node:fs";
+import { listTasks } from "../src/tasks.ts";
+
+/** A database with one list of 600 tasks whose created_at, priority, position and due dates take very few values. */
+function tiedDb() {
+  const db = openDb();
+  db.exec("INSERT INTO users (username, password_hash) VALUES ('qa', 'x'); INSERT INTO lists (owner_id, name) VALUES (1, 'Warehouse')");
+  const insert = db.prepare(
+    "INSERT INTO tasks (list_id, title, priority, position, due_date, created_at, updated_at) VALUES (1, ?, ?, ?, ?, ?, 'x')",
+  );
+  for (let i = 0; i < 600; i++) {
+    insert.run(`t${i}`, i % 2, i % 3, i % 4 === 0 ? null : `2026-01-0${1 + (i % 2)}`, `2026-01-01T00:00:0${i % 2}.000Z`);
+  }
+  return db;
+}
+
+test("paging a list whose tasks all share a few created_at, priority, position and due date values loses and repeats nothing", () => {
+  const db = tiedDb();
+  const user: any = { id: 1, username: "qa" };
+  const unpaged: Record<string, string> = {
+    position: "position, id",
+    due_date: "due_date IS NULL, due_date, id",
+    priority: "priority DESC, id",
+    created: "created_at DESC, id DESC",
+  };
+  for (const [sort, order] of Object.entries(unpaged)) {
+    const expected = (db.prepare(`SELECT id FROM tasks WHERE list_id = 1 ORDER BY ${order}`).all() as { id: number }[]).map((r) => r.id);
+    for (const limit of [1, 13, 200]) {
+      const ids: number[] = [];
+      let cursor: string | null = null;
+      do {
+        const query = new URLSearchParams({ sort, limit: String(limit) });
+        if (cursor) query.set("cursor", cursor);
+        const page = listTasks(db, user, 1, query);
+        ids.push(...page.items.map((t) => t.id));
+        cursor = page.next_cursor;
+      } while (cursor !== null && ids.length < 5000);
+      assert.deepEqual(ids, expected, `${sort} by ${limit}`);
+    }
+  }
+});
+
+test("a page costs a fixed number of queries, whatever its size", () => {
+  const db = tiedDb();
+  db.exec("INSERT INTO tags (list_id, name) VALUES (1, 'a'); INSERT INTO task_tags (task_id, tag_id) SELECT id, 1 FROM tasks");
+  db.exec("INSERT INTO comments (task_id, author_id, body) SELECT id, 1, 'x' FROM tasks");
+  const real = db.prepare.bind(db);
+  let prepared = 0;
+  (db as any).prepare = (sql: string) => (prepared++, real(sql));
+  const user: any = { id: 1, username: "qa" };
+  const cost = (limit: number) => {
+    prepared = 0;
+    const page = listTasks(db, user, 1, new URLSearchParams({ limit: String(limit) }));
+    assert.equal(page.items.length, limit);
+    assert.ok(page.items.every((t) => t.tags.length === 1 && t.comment_count === 1));
+    return prepared;
+  };
+  assert.equal(cost(150), cost(2));
+});
