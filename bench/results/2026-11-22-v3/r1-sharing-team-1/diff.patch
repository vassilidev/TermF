diff --git a/test/sharing-authz.test.ts b/test/sharing-authz.test.ts
new file mode 100644
index 0000000..5788a2b
--- /dev/null
+++ b/test/sharing-authz.test.ts
@@ -0,0 +1,232 @@
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { openDb, type Db } from "../src/db.ts";
+import { invite, makeList, makeTask, share, signUp, start, type App, type Auth } from "./helpers.ts";
+
+// Authorization regressions for sharing: what a caller must not manage by mixing lists, ids, roles or sessions.
+// The server and this file's `db` open the same SQLite file, to look at what is stored.
+let app: App;
+let db: Db;
+let dir: string;
+const people = {} as Record<"owner" | "other" | "editor" | "viewer" | "stranger", { auth: Auth; user: any }>;
+type Person = keyof typeof people;
+
+before(async () => {
+  dir = mkdtempSync(join(tmpdir(), "sharing-authz-"));
+  app = await start(join(dir, "lists.db"));
+  db = openDb(join(dir, "lists.db"));
+  for (const name of ["owner", "other", "editor", "viewer", "stranger"] as const) people[name] = await signUp(app, name);
+});
+after(async () => {
+  db.close();
+  await app.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const call = (who: Person, method: string, path: string, body?: unknown) => app.call(method, path, body, people[who].auth);
+const uid = (who: Person) => people[who].user.id as number;
+
+test("without a valid session, every list, task, comment, member and invitation route answers 401 and changes nothing", async () => {
+  const list = await makeList(app, people.owner.auth, "Private");
+  const task = await makeTask(app, people.owner.auth, list.id);
+  await share(app, people.owner.auth, list.id, "viewer", people.viewer.auth);
+  const pending = await invite(app, people.owner.auth, list.id, "editor");
+  const routes: [string, string, unknown?][] = [
+    ["GET", "/api/lists"],
+    ["POST", "/api/lists", { name: "Anon" }],
+    ["GET", `/api/lists/${list.id}`],
+    ["PATCH", `/api/lists/${list.id}`, { name: "Anon" }],
+    ["DELETE", `/api/lists/${list.id}`],
+    ["GET", `/api/lists/${list.id}/tasks`],
+    ["POST", `/api/lists/${list.id}/tasks`, { title: "Anon" }],
+    ["GET", `/api/lists/${list.id}/tags`],
+    ["GET", `/api/lists/${list.id}/activity`],
+    ["GET", `/api/lists/${list.id}/members`],
+    ["DELETE", `/api/lists/${list.id}/members/${uid("viewer")}`],
+    ["GET", `/api/lists/${list.id}/invitations`],
+    ["POST", `/api/lists/${list.id}/invitations`, { role: "editor" }],
+    ["DELETE", `/api/lists/${list.id}/invitations/${pending.id}`],
+    ["POST", `/api/invitations/${pending.token}/accept`],
+    ["GET", `/api/tasks/${task.id}`],
+    ["PATCH", `/api/tasks/${task.id}`, { title: "Anon" }],
+    ["DELETE", `/api/tasks/${task.id}`],
+    ["GET", `/api/tasks/${task.id}/comments`],
+    ["POST", `/api/tasks/${task.id}/comments`, { body: "Anon" }],
+  ];
+  for (const headers of [{} as Auth, { Authorization: "Bearer not-a-session" }, { Authorization: `Basic ${people.owner.auth.Authorization.slice(7)}` }]) {
+    for (const [method, path, body] of routes) {
+      const res = await app.call(method, path, body, headers);
+      assert.equal(res.status, 401, `${JSON.stringify(headers)} ${method} ${path}`);
+    }
+  }
+  const members = (await call("owner", "GET", `/api/lists/${list.id}/members`)).body;
+  assert.deepEqual(members.map((m: any) => m.role), ["owner", "viewer"]);
+  assert.equal((await call("owner", "GET", `/api/lists/${list.id}/invitations`)).body.length, 1);
+  assert.equal((await call("owner", "GET", `/api/lists/${list.id}`)).body.name, "Private");
+  assert.equal((await call("stranger", "POST", `/api/invitations/${pending.token}/accept`)).status, 200, "the token was not used up");
+});
+
+test("an invitation id of list A, sent to list B's routes, revokes nothing, for the same owner or for another one", async () => {
+  const a = await makeList(app, people.owner.auth, "A");
+  const b = await makeList(app, people.owner.auth, "B");
+  const otherB = await makeList(app, people.other.auth, "Other B");
+  const invitation = await invite(app, people.owner.auth, a.id, "editor");
+  for (const [who, listId] of [["owner", b.id], ["other", otherB.id]] as const) {
+    const res = await call(who, "DELETE", `/api/lists/${listId}/invitations/${invitation.id}`);
+    assert.equal(res.status, 404, `${who} via list ${listId}`);
+    assert.deepEqual((await call(who, "GET", `/api/lists/${listId}/invitations`)).body, []);
+  }
+  // Nor can the owner of B revoke it through A: they have no access there.
+  assert.equal((await call("other", "DELETE", `/api/lists/${a.id}/invitations/${invitation.id}`)).status, 404);
+  assert.deepEqual((await call("owner", "GET", `/api/lists/${a.id}/invitations`)).body.map((i: any) => i.id), [invitation.id]);
+  const accepted = await call("stranger", "POST", `/api/invitations/${invitation.token}/accept`);
+  assert.equal(accepted.status, 200);
+  assert.equal(accepted.body.id, a.id);
+});
+
+test("a member id sent to another list's route removes nobody and keeps their tasks assigned", async () => {
+  const a = await makeList(app, people.owner.auth, "A");
+  const b = await makeList(app, people.owner.auth, "B");
+  await share(app, people.owner.auth, a.id, "editor", people.editor.auth);
+  const task = await makeTask(app, people.owner.auth, a.id, { assignee_id: uid("editor") });
+  const res = await call("owner", "DELETE", `/api/lists/${b.id}/members/${uid("editor")}`);
+  assert.equal(res.status, 404);
+  assert.deepEqual((await call("owner", "GET", `/api/lists/${a.id}/members`)).body.map((m: any) => m.id), [uid("owner"), uid("editor")]);
+  assert.equal((await call("editor", "GET", `/api/tasks/${task.id}`)).body.assignee.id, uid("editor"));
+  assert.equal((await call("other", "DELETE", `/api/lists/${a.id}/members/${uid("editor")}`)).status, 404);
+});
+
+test("the role of a membership is the invitation's: nothing the caller sends with the accept request changes it", async () => {
+  const list = await makeList(app, people.owner.auth, "Roles");
+  const task = await makeTask(app, people.owner.auth, list.id);
+  const invitation = await invite(app, people.owner.auth, list.id, "viewer");
+  const res = await app.call(
+    "POST",
+    `/api/invitations/${invitation.token}/accept?role=editor&role=owner`,
+    { role: "editor", list_id: 1, user_id: uid("owner") },
+    people.stranger.auth,
+  );
+  assert.equal(res.status, 200);
+  assert.equal(res.body.role, "viewer");
+  const members = (await call("owner", "GET", `/api/lists/${list.id}/members`)).body;
+  assert.deepEqual(members.map((m: any) => [m.id, m.role]), [[uid("owner"), "owner"], [uid("stranger"), "viewer"]]);
+  assert.equal((await call("stranger", "PATCH", `/api/tasks/${task.id}`, { title: "Escalated" })).status, 403);
+  assert.equal((await call("stranger", "POST", `/api/lists/${list.id}/invitations`, { role: "editor" })).status, 403);
+});
+
+test("a token accepted by two people at once makes exactly one of them a member", async () => {
+  const list = await makeList(app, people.owner.auth, "Race");
+  const invitation = await invite(app, people.owner.auth, list.id, "editor");
+  const answers = await Promise.all([
+    call("editor", "POST", `/api/invitations/${invitation.token}/accept`),
+    call("viewer", "POST", `/api/invitations/${invitation.token}/accept`),
+    call("stranger", "POST", `/api/invitations/${invitation.token}/accept`),
