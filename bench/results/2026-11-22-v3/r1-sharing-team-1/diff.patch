+}
+
+/** Who has access to the list: its owner first, then the members in the order they joined. Any member can ask. */
+export function listMembers(db: Db, user: User, listId: number): Member[] {
+  const list = loadList(db, user, listId, "read");
+  const owner = db.prepare("SELECT id, username FROM users WHERE id = ?").get(list.owner_id) as { id: number; username: string };
+  const members = db
+    .prepare(
+      `SELECT u.id, u.username, m.role FROM list_members m JOIN users u ON u.id = m.user_id
+       WHERE m.list_id = ? ORDER BY m.created_at, m.rowid`,
+    )
+    .all(listId) as unknown as Member[];
+  return [
+    { id: owner.id, username: owner.username, role: "owner" },
+    ...members.map((m) => ({ id: m.id, username: m.username, role: m.role })),
