+/** The invitations of the list still waiting to be accepted, oldest first. */
+export function listInvitations(db: Db, user: User, listId: number): InvitationView[] {
+  loadList(db, user, listId, "owner");
+  const rows = db
+    .prepare(`SELECT id, role, expires_at, created_at FROM invitations WHERE list_id = ? AND ${PENDING} ORDER BY id`)
