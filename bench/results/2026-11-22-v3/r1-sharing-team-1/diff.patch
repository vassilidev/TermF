+}
+
+/**
+ * Removes a member, for the owner. Their tasks in the list become unassigned and their reminders are cancelled, so
+ * nothing about the list keeps reaching them.
+ */
+export async function removeMember(db: Db, user: User, listId: number, userId: number): Promise<void> {
+  const list = loadList(db, user, listId, "owner");
+  if (userId === list.owner_id) throw badRequest("the owner can't be removed");
+  const member = db
+    .prepare("SELECT u.username FROM list_members m JOIN users u ON u.id = m.user_id WHERE m.list_id = ? AND m.user_id = ?")
+    .get(listId, userId) as { username: string } | undefined;
+  if (!member) throw notFound("member not found");
+  transaction(db, () => {
+    db.prepare("DELETE FROM list_members WHERE list_id = ? AND user_id = ?").run(listId, userId);
+    const assigned = db.prepare("SELECT id FROM tasks WHERE list_id = ? AND assignee_id = ?").all(listId, userId) as { id: number }[];
+    const stamp = now();
+    for (const { id } of assigned) {
+      db.prepare("UPDATE tasks SET assignee_id = NULL, updated_at = ? WHERE id = ?").run(stamp, id);
+      jobs.cancelReminders(db, id);
+    }
+  });
+  await activity.record(db, { list_id: listId, user_id: user.id, action: "member.removed", detail: { username: member.username } });
+}
