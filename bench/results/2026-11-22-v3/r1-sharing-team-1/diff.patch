+import { randomBytes } from "node:crypto";
+import { hashToken, type User } from "./auth.ts";
+import { now, transaction, type Db } from "./db.ts";
+import { badRequest, notFound } from "./http.ts";
+import { getList, loadList, type ListView, type Role } from "./lists.ts";
+import * as activity from "./activity.ts";
+import * as jobs from "./jobs.ts";
+
+export type MemberRole = "editor" | "viewer";
+
+/** A pending invitation, as the owner sees it: never with its token, which only the creation answer holds. */
+export interface InvitationView {
+  id: number;
+  role: MemberRole;
+  expires_at: string;
+  created_at: string;
+}
+
+export interface CreatedInvitation extends InvitationView {
+  token: string;
+  url: string;
+}
+
+export interface Member {
+  id: number;
+  username: string;
+  role: Role;
+}
+
+const DEFAULT_HOURS = 72;
+const MAX_HOURS = 720;
+const HOUR_MS = 3_600_000;
+
+// An invitation is pending until it is accepted, revoked or expired.
+const PENDING = "accepted_at IS NULL AND revoked_at IS NULL AND expires_at > ?";
+
+/**
+ * Where the page lives, for the invitation link: `BASE_URL` if set (set it behind a proxy or TLS), else the host the
+ * request was sent to.
+ */
+export function baseUrl(req: any): string {
+  const configured = process.env.BASE_URL;
+  if (configured) return configured.replace(/\/+$/, "");
+  const host = String(req.headers.host ?? "");
+  const valid = /^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?$/.test(host);
+  return `http://${valid ? host : `localhost:${process.env.PORT ?? 3000}`}`;
+}
+
+/**
+ * Creates an invitation to the list, for its owner. The token is returned once: only its hash is stored. The link puts
+ * it in the fragment, which browsers never send, so it stays out of server logs and `Referer` headers.
+ */
+export function createInvitation(db: Db, user: User, listId: number, body: any, base: string): CreatedInvitation {
+  loadList(db, user, listId, "owner");
+  const role = body.role;
+  if (role !== "viewer" && role !== "editor") throw badRequest("role must be viewer or editor");
+  const hours = body.expires_in_hours === undefined ? DEFAULT_HOURS : body.expires_in_hours;
+  if (typeof hours !== "number" || !Number.isFinite(hours) || hours <= 0 || hours > MAX_HOURS) {
+    throw badRequest(`expires_in_hours must be a number above 0, at most ${MAX_HOURS}`);
+  }
