+  const createdAt = created.toISOString();
+  const expiresAt = new Date(created.getTime() + hours * HOUR_MS).toISOString();
+  const token = randomBytes(32).toString("base64url");
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO invitations (list_id, role, token_hash, created_by, created_at, expires_at) VALUES (?, ?, ?, ?, ?, ?)")
