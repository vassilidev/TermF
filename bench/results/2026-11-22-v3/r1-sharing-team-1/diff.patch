diff --git a/public/sharing.js b/public/sharing.js
new file mode 100644
index 0000000..a86f774
--- /dev/null
+++ b/public/sharing.js
@@ -0,0 +1,107 @@
+import { api, element, showError, showStatus } from "./api.js";
+import { renderLists } from "./lists.js";
+
+const members = document.querySelector("#members");
+const ownerPart = document.querySelector("#owner-sharing");
+const inviteForm = document.querySelector("#invite-form");
+const roleSelect = document.querySelector("#invite-role");
+const hoursInput = document.querySelector("#invite-hours");
+const result = document.querySelector("#invite-result");
+const linkInput = document.querySelector("#invite-link");
+const copyButton = document.querySelector("#copy-link");
+const invitations = document.querySelector("#invitations");
+
+let current = null;
+
+export function initSharing() {
+  inviteForm.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    const body = { role: roleSelect.value };
+    if (hoursInput.value !== "") body.expires_in_hours = Number(hoursInput.value);
+    const list = current;
+    try {
+      const invitation = await api(`/api/lists/${list.id}/invitations`, { method: "POST", body });
+      if (current?.id !== list.id) return;
+      showError(null);
+      linkInput.value = invitation.url;
+      result.hidden = false;
+      showStatus("Invitation link created. Copy it now: it is shown only once.");
+      await renderSharing(list);
+    } catch (err) {
+      showError(err);
+    }
+  });
+
+  copyButton.addEventListener("click", async () => {
+    try {
+      await navigator.clipboard.writeText(linkInput.value);
+      showStatus("Invitation link copied.");
+    } catch {
+      linkInput.focus();
+      linkInput.select();
+      showStatus("Could not copy automatically. The link is selected: press Ctrl+C or Cmd+C to copy it.");
+    }
+  });
+}
+
+/** Loads and shows who the list is shared with; the owner also gets the invitation controls. */
+export async function renderSharing(list) {
+  if (current?.id !== list.id) {
+    linkInput.value = "";
+    result.hidden = true;
+  }
+  current = list;
+  const isOwner = list.role === "owner";
+  ownerPart.hidden = !isOwner;
+  const [people, pending] = await Promise.all([
+    api(`/api/lists/${list.id}/members`),
+    isOwner ? api(`/api/lists/${list.id}/invitations`) : [],
+  ]);
+  if (current?.id !== list.id) return;
+  members.replaceChildren(...people.map((person) => memberItem(list, person)));
+  invitations.replaceChildren(
+    ...(pending.length ? pending.map((invitation) => invitationItem(list, invitation)) : [element("li", { textContent: "No pending invitations." })]),
+  );
+}
+
+function memberItem(list, person) {
+  const children = [element("span", { textContent: `${person.username}: ` }), element("strong", { className: "role", textContent: person.role })];
+  if (list.role === "owner" && person.role !== "owner") {
+    const remove = element("button", { type: "button", textContent: "Remove" });
+    remove.setAttribute("aria-label", `Remove ${person.username}`);
+    remove.addEventListener("click", async () => {
+      if (!confirm(`Remove ${person.username} from "${list.name}"? Their tasks become unassigned.`)) return;
+      try {
+        await api(`/api/lists/${list.id}/members/${person.id}`, { method: "DELETE" });
+        showError(null);
+        showStatus(`${person.username} was removed.`);
+        await renderLists();
+      } catch (err) {
+        showError(err);
+      }
+    });
+    children.push(remove);
+  }
+  return element("li", { className: "person" }, ...children);
+}
+
+function invitationItem(list, invitation) {
+  const revoke = element("button", { type: "button", textContent: "Revoke" });
+  revoke.setAttribute("aria-label", `Revoke ${invitation.role} invitation`);
+  revoke.addEventListener("click", async () => {
+    try {
+      await api(`/api/lists/${list.id}/invitations/${invitation.id}`, { method: "DELETE" });
+      showError(null);
+      showStatus("Invitation revoked.");
+      await renderSharing(list);
+    } catch (err) {
+      showError(err);
+    }
+  });
+  return element(
+    "li",
+    { className: "person" },
+    element("span", { textContent: `${invitation.role}, expires ${new Date(invitation.expires_at).toLocaleString()}` }),
+    revoke,
+  );
+}
