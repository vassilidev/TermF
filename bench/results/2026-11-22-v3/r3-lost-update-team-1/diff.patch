@@ -1,7 +1,8 @@
 import { after, before, test } from "node:test";
 import assert from "node:assert/strict";
+import { migrate, openDb } from "../src/db.ts";
 import { makeList, makeTask, signUp, start, type App, type Auth } from "./helpers.ts";
 
 let app: App;
 before(async () => (app = await start()));
 after(() => app.close());
@@ -183,5 +184,92 @@ test.skip("moving a task renumbers the positions of the others", async () => {
   assert.deepEqual(
     res.body.map((t: any) => [t.title, t.position]),
     [["c", 0], ["a", 1], ["b", 2]],
   );
 });
+
+test("PATCHes fired at once on different fields all land", async () => {
+  const { auth, list } = await setUp();
+  for (let round = 0; round < 20; round++) {
+    const task = await makeTask(app, auth, list.id, { title: "Old name" });
+    const patch = (body: object) => app.call("PATCH", `/api/tasks/${task.id}`, body, auth);
+    const replies = await Promise.all([
+      patch({ title: "New name" }),
+      patch({ done: true }),
+      patch({ priority: 3 }),
+      patch({ due_date: "2030-01-02" }),
+      patch({ notes: "Some notes" }),
+    ]);
+    assert.deepEqual(replies.map((r) => r.status), [200, 200, 200, 200, 200]);
+    const after = (await app.call("GET", `/api/tasks/${task.id}`, undefined, auth)).body;
+    assert.equal(after.title, "New name", `round ${round}`);
+    assert.equal(after.done, true, `round ${round}`);
+    assert.equal(after.priority, 3, `round ${round}`);
+    assert.equal(after.due_date, "2030-01-02", `round ${round}`);
+    assert.equal(after.notes, "Some notes", `round ${round}`);
+  }
+});
+
+test("each of several simultaneous PATCHes adds one to the version", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  const patch = (body: object) => app.call("PATCH", `/api/tasks/${task.id}`, body, auth);
+  await Promise.all([patch({ title: "A" }), patch({ done: true }), patch({ priority: 2 })]);
+  assert.equal((await app.call("GET", `/api/tasks/${task.id}`, undefined, auth)).body.version, 4);
+});
+
+test("a new task has version 1, and each change adds one but a no-op adds none", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  assert.equal(task.version, 1);
+  const renamed = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Other" }, auth);
+  assert.equal(renamed.body.version, 2);
+  const same = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Other" }, auth);
+  assert.equal(same.body.version, 2);
+  const tagged = await app.call("PATCH", `/api/tasks/${task.id}`, { tags: ["home"] }, auth);
+  assert.equal(tagged.body.version, 3);
+  const listed = await app.call("GET", `/api/lists/${list.id}/tasks`, undefined, auth);
+  assert.equal(listed.body[0].version, 3);
+});
+
+test("a task that existed before versions has version 1", async () => {
+  const db = openDb(":memory:");
+  db.exec("PRAGMA user_version = 6");
+  db.exec("ALTER TABLE tasks DROP COLUMN version");
+  db.exec("INSERT INTO users (username, password_hash) VALUES ('old', 'x')");
+  db.exec("INSERT INTO lists (owner_id, name) VALUES (1, 'L')");
+  db.exec("INSERT INTO tasks (list_id, title, updated_at) VALUES (1, 'Old task', 'then')");
+  migrate(db);
+  assert.deepEqual(db.prepare("SELECT version FROM tasks").all().map((r: any) => r.version), [1]);
+});
+
+test("PATCH with the version read succeeds", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  const res = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Renamed", version: 1 }, auth);
+  assert.equal(res.status, 200);
+  assert.equal(res.body.title, "Renamed");
+  assert.equal(res.body.version, 2);
+});
+
+test("PATCH with a stale version answers 409 with the current task and changes nothing", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id, { title: "Mine" });
+  await app.call("PATCH", `/api/tasks/${task.id}`, { done: true }, auth);
+  const res = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Stale", version: 1 }, auth);
+  assert.equal(res.status, 409);
+  assert.equal(res.body.error, "version conflict");
+  assert.equal(res.body.task.title, "Mine");
+  assert.equal(res.body.task.done, true);
+  assert.equal(res.body.task.version, 2);
+  const after = await app.call("GET", `/api/tasks/${task.id}`, undefined, auth);
+  assert.deepEqual(after.body, res.body.task);
+});
+
+test("PATCH rejects a version that is not a positive integer", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  for (const version of [0, -1, 1.5, "1", null]) {
+    const res = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "X", version }, auth);
+    assert.equal(res.status, 400);
+  }
+});
