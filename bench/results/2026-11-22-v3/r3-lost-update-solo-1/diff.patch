diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 50f8599..3f5ff8c 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -183,5 +183,65 @@ test.skip("moving a task renumbers the positions of the others", async () => {
   assert.deepEqual(
     res.body.map((t: any) => [t.title, t.position]),
     [["c", 0], ["a", 1], ["b", 2]],
   );
 });
+
+test("tasks carry a version that goes up with each change", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  assert.equal(task.version, 1);
+  const changed = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "New" }, auth);
+  assert.equal(changed.body.version, 2);
+  const same = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "New" }, auth);
+  assert.equal(same.body.version, 2);
+  assert.equal((await app.call("GET", `/api/tasks/${task.id}`, undefined, auth)).body.version, 2);
+  assert.equal((await app.call("GET", `/api/lists/${list.id}/tasks`, undefined, auth)).body[0].version, 2);
+  const bad = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "x", version: "2" }, auth);
+  assert.equal(bad.status, 400);
+});
+
+test("a PATCH with a stale version is a 409 and changes nothing", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id, { title: "Old" });
+  const first = await app.call("PATCH", `/api/tasks/${task.id}`, { done: true, version: 1 }, auth);
+  assert.equal(first.status, 200);
+  assert.equal(first.body.version, 2);
+  const stale = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Mine", version: 1 }, auth);
+  assert.equal(stale.status, 409);
+  assert.deepEqual(stale.body, { error: "version conflict", task: first.body });
+  assert.deepEqual((await app.call("GET", `/api/tasks/${task.id}`, undefined, auth)).body, first.body);
+  const retried = await app.call("PATCH", `/api/tasks/${task.id}`, { title: "Mine", version: 2 }, auth);
+  assert.equal(retried.status, 200);
+  assert.equal(retried.body.version, 3);
+  assert.equal(retried.body.done, true);
+});
+
+test("simultaneous PATCHes of different fields are all kept", async () => {
+  const { auth, list } = await setUp();
+  for (let round = 0; round < 20; round++) {
+    const task = await makeTask(app, auth, list.id, { title: "Old" });
+    const sent = await Promise.all([
+      app.call("PATCH", `/api/tasks/${task.id}`, { title: "Renamed" }, auth),
+      app.call("PATCH", `/api/tasks/${task.id}`, { done: true }, auth),
+      app.call("PATCH", `/api/tasks/${task.id}`, { priority: 2, due_date: "2026-06-01" }, auth),
+    ]);
+    assert.deepEqual(sent.map((r) => r.status), [200, 200, 200]);
+    const now = (await app.call("GET", `/api/tasks/${task.id}`, undefined, auth)).body;
+    assert.equal(now.title, "Renamed");
+    assert.equal(now.done, true);
+    assert.equal(now.priority, 2);
+    assert.equal(now.due_date, "2026-06-01");
+    assert.equal(now.version, 4);
+  }
+});
+
+test("of simultaneous PATCHes with the same version, one wins and the others get a 409", async () => {
+  const { auth, list } = await setUp();
+  const task = await makeTask(app, auth, list.id);
+  const sent = await Promise.all(
+    ["a", "b", "c"].map((title) => app.call("PATCH", `/api/tasks/${task.id}`, { title, version: 1 }, auth)),
+  );
+  assert.deepEqual(sent.map((r) => r.status).sort(), [200, 409, 409]);
+  const winner = sent.find((r) => r.status === 200)!.body;
+  for (const loser of sent.filter((r) => r.status === 409)) assert.deepEqual(loser.body.task, winner);
+});
