+import { createHash, randomBytes } from "node:crypto";
+import type { User } from "./auth.ts";
+import { now, transaction, type Db } from "./db.ts";
+import { HttpError, badRequest, notFound } from "./http.ts";
+import { getList, loadList, type ListView, type Role } from "./lists.ts";
+import * as activity from "./activity.ts";
+import * as jobs from "./jobs.ts";
+
+export interface Member {
+  id: number;
+  username: string;
+  role: Role;
+}
+
+export interface Invitation {
+  id: number;
+  role: "editor" | "viewer";
+  created_at: string;
+  expires_at: string;
+}
+
+const DEFAULT_HOURS = 72;
+const MAX_HOURS = 720;
+const MAX_PENDING = 100;
+const HOUR = 3_600_000;
+const ROLES = ["editor", "viewer"];
+
+// Only the hash of an invitation token is stored: reading the database does not give access to the lists.
+const hashToken = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+/** The owner first, then the members by name. Any member of the list can read it. */
+export function listMembers(db: Db, user: User, listId: number): Member[] {
+  loadList(db, user, listId, "read");
+  return db
+    .prepare(
+      `SELECT id, username, role FROM (
+         SELECT u.id, u.username, 'owner' AS role FROM lists l JOIN users u ON u.id = l.owner_id WHERE l.id = ?1
+         UNION ALL
+         SELECT u.id, u.username, m.role FROM list_members m JOIN users u ON u.id = m.user_id WHERE m.list_id = ?1
+       ) ORDER BY role <> 'owner', username`,
+    )
+    .all(listId) as unknown as Member[];
+}
+
+export async function removeMember(db: Db, user: User, listId: number, userId: number): Promise<void> {
+  const list = loadList(db, user, listId, "owner");
+  if (userId === list.owner_id) throw badRequest("the owner cannot be removed");
+  const member = db
+    .prepare("SELECT u.username FROM list_members m JOIN users u ON u.id = m.user_id WHERE m.list_id = ? AND m.user_id = ?")
+    .get(listId, userId) as { username: string } | undefined;
+  if (!member) throw notFound("member not found");
+  transaction(db, () => {
+    db.prepare("DELETE FROM list_members WHERE list_id = ? AND user_id = ?").run(listId, userId);
+    // What was assigned to them goes back to nobody: they must not be reminded of, nor named on, a list they cannot see.
+    const assigned = db.prepare("SELECT id FROM tasks WHERE list_id = ? AND assignee_id = ?").all(listId, userId) as { id: number }[];
+    db.prepare("UPDATE tasks SET assignee_id = NULL, updated_at = ? WHERE list_id = ? AND assignee_id = ?").run(now(), listId, userId);
+    for (const { id } of assigned) jobs.cancelReminders(db, id);
+  });
+  await activity.record(db, { list_id: listId, user_id: user.id, action: "member.removed", detail: { user_id: userId, username: member.username } });
+}
+
+export function createInvitation(db: Db, user: User, listId: number, body: any, baseUrl: string) {
+  loadList(db, user, listId, "owner");
+  if (typeof body.role !== "string" || !ROLES.includes(body.role)) throw badRequest("role must be viewer or editor");
+  const hours = body.expires_in_hours === undefined ? DEFAULT_HOURS : body.expires_in_hours;
+  if (typeof hours !== "number" || !Number.isFinite(hours) || hours <= 0 || hours > MAX_HOURS) {
+    throw badRequest(`expires_in_hours must be a number above 0 and at most ${MAX_HOURS}`);
+  }
+  const { count } = db
+    .prepare("SELECT COUNT(*) AS count FROM invitations WHERE list_id = ? AND accepted_at IS NULL AND expires_at > ?")
+    .get(listId, now()) as { count: number };
+  if (count >= MAX_PENDING) throw new HttpError(409, "too many pending invitations: revoke some first");
