+let app: App;
+before(async () => (app = await start()));
+after(() => app.close());
+
+let n = 0;
+const name = () => `person_${++n}`;
+
+/** An owner with a list, an editor and a viewer who joined it, and an outsider. */
+async function setUp() {
+  const owner = await signUp(app, name());
+  const editor = await signUp(app, name());
+  const viewer = await signUp(app, name());
+  const outsider = await signUp(app, name());
+  const list = await makeList(app, owner.auth);
+  await join(owner.auth, list.id, editor.auth, "editor");
+  await join(owner.auth, list.id, viewer.auth, "viewer");
+  return { owner, editor, viewer, outsider, list };
+}
+
+async function invite(auth: Auth, listId: number, body: Record<string, unknown> = { role: "viewer" }) {
+  return app.call("POST", `/api/lists/${listId}/invitations`, body, auth);
+}
+
+async function join(ownerAuth: Auth, listId: number, auth: Auth, role: "editor" | "viewer") {
+  const invitation = await invite(ownerAuth, listId, { role });
+  assert.equal(invitation.status, 201);
+  const res = await app.call("POST", `/api/invitations/${invitation.body.token}/accept`, undefined, auth);
+  assert.equal(res.status, 200);
+  return res.body;
+}
+
+test("an invitation answers its token, link, role and expiry (72 hours by default)", async () => {
+  const { auth } = await signUp(app, name());
+  const list = await makeList(app, auth);
+  const before = Date.now();
+  const res = await invite(auth, list.id, { role: "editor" });
+  assert.equal(res.status, 201);
+  assert.deepEqual(Object.keys(res.body).sort(), ["expires_at", "id", "role", "token", "url"]);
+  assert.equal(res.body.role, "editor");
+  assert.ok(res.body.url.startsWith(app.base) && res.body.url.endsWith(res.body.token));
+  const hours = (Date.parse(res.body.expires_at) - before) / 3_600_000;
+  assert.ok(hours > 71.9 && hours < 72.1);
+  const custom = await invite(auth, list.id, { role: "viewer", expires_in_hours: 1 });
+  assert.ok(Date.parse(custom.body.expires_at) - before < 3_700_000);
+});
+
+test("refuses invalid invitations", async () => {
