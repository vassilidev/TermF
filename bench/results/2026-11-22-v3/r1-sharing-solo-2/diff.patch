+test("accepting twice or as the owner changes nothing", async () => {
+  const owner = await signUp(app, name());
+  const guest = await signUp(app, name());
+  const list = await makeList(app, owner.auth);
+  const editorInvite = await invite(owner.auth, list.id, { role: "editor" });
+  const viewerInvite = await invite(owner.auth, list.id, { role: "viewer" });
+  const own = await app.call("POST", `/api/invitations/${viewerInvite.body.token}/accept`, undefined, owner.auth);
+  assert.equal(own.body.role, "owner");
+  assert.equal((await app.call("GET", `/api/lists/${list.id}/members`, undefined, owner.auth)).body.length, 1);
+  const other = await invite(owner.auth, list.id, { role: "viewer" });
+  await app.call("POST", `/api/invitations/${editorInvite.body.token}/accept`, undefined, guest.auth);
+  const again = await app.call("POST", `/api/invitations/${other.body.token}/accept`, undefined, guest.auth);
+  assert.equal(again.body.role, "editor", "a lesser invitation does not demote");
+});
