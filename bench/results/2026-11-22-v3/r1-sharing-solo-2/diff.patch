+  const expiresAt = new Date(Date.now() + hours * HOUR).toISOString();
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO invitations (list_id, token_hash, role, created_by, expires_at) VALUES (?, ?, ?, ?, ?)")
+    .run(listId, hashToken(token), body.role, user.id, expiresAt);
+  return { id: Number(lastInsertRowid), token, url: `${baseUrl}/invite/${token}`, role: body.role, expires_at: expiresAt };
+}
+
+/** The invitations of a list that can still be accepted. */
+export function listInvitations(db: Db, user: User, listId: number): Invitation[] {
+  loadList(db, user, listId, "owner");
+  return db
+    .prepare(
+      `SELECT id, role, created_at, expires_at FROM invitations
+       WHERE list_id = ? AND accepted_at IS NULL AND expires_at > ? ORDER BY id`,
+    )
+    .all(listId, now()) as unknown as Invitation[];
+}
+
+export function revokeInvitation(db: Db, user: User, listId: number, id: number): void {
+  loadList(db, user, listId, "owner");
+  const { changes } = db.prepare("DELETE FROM invitations WHERE id = ? AND list_id = ? AND accepted_at IS NULL").run(id, listId);
+  if (changes === 0) throw notFound("invitation not found");
+}
+
+const RANK: Record<Role, number> = { viewer: 0, editor: 1, owner: 2 };
+
+/** Makes `user` a member of the invitation's list. An invitation works once; the person who owns the list or already has a better role keeps it. */
+export async function acceptInvitation(db: Db, user: User, token: string): Promise<ListView> {
+  const stamp = now();
+  const joined = transaction(db, () => {
+    const invitation = db
+      .prepare("SELECT id, list_id, role, expires_at, accepted_at FROM invitations WHERE token_hash = ?")
+      .get(hashToken(token)) as { id: number; list_id: number; role: "editor" | "viewer"; expires_at: string; accepted_at: string | null } | undefined;
+    if (!invitation) throw notFound("invitation not found");
+    if (invitation.accepted_at !== null) throw new HttpError(410, "invitation already used");
+    if (invitation.expires_at <= stamp) throw new HttpError(410, "invitation expired");
+
+    const list = db.prepare("SELECT owner_id FROM lists WHERE id = ?").get(invitation.list_id) as { owner_id: number };
+    if (list.owner_id === user.id) return { listId: invitation.list_id, changed: false };
+    db.prepare("UPDATE invitations SET accepted_by = ?, accepted_at = ? WHERE id = ?").run(user.id, stamp, invitation.id);
+    const current = db
+      .prepare("SELECT role FROM list_members WHERE list_id = ? AND user_id = ?")
+      .get(invitation.list_id, user.id) as { role: "editor" | "viewer" } | undefined;
+    if (current && RANK[current.role] >= RANK[invitation.role]) return { listId: invitation.list_id, changed: false };
+    db.prepare(
+      "INSERT INTO list_members (list_id, user_id, role) VALUES (?, ?, ?) ON CONFLICT (list_id, user_id) DO UPDATE SET role = excluded.role",
+    ).run(invitation.list_id, user.id, invitation.role);
+    return { listId: invitation.list_id, changed: true, role: invitation.role };
+  });
+  if (joined.changed) {
+    await activity.record(db, {
+      list_id: joined.listId,
+      user_id: user.id,
+      action: "member.joined",
+      detail: { user_id: user.id, username: user.username, role: joined.role },
+    });
+  }
+  return getList(db, user, joined.listId);
+}
