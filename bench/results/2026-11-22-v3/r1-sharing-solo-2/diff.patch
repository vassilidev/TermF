diff --git a/public/sharing.js b/public/sharing.js
new file mode 100644
index 0000000..3c4432a
--- /dev/null
+++ b/public/sharing.js
@@ -0,0 +1,105 @@
+import { api, element, showError } from "./api.js";
+
+const members = document.querySelector("#members");
+const ownerPart = document.querySelector("#owner-sharing");
+const invitations = document.querySelector("#invitations");
+const form = document.querySelector("#new-invitation");
+const roleInput = document.querySelector("#invite-role");
+const hoursInput = document.querySelector("#invite-hours");
+const linkBox = document.querySelector("#new-link");
+const linkUrl = document.querySelector("#link-url");
+const badge = document.querySelector("#role-badge");
+
+let current = null;
+/** Called after a member is removed, so that the tasks (their assignees) are drawn again. */
+let onChange = () => {};
+
+export function initSharing(changed) {
+  onChange = changed;
+  form.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    try {
+      const body = { role: roleInput.value, expires_in_hours: Number(hoursInput.value) };
+      const invitation = await api(`/api/lists/${current.id}/invitations`, { method: "POST", body });
+      linkUrl.value = invitation.url;
+      linkBox.hidden = false;
+      linkUrl.select();
+      showError(null);
+      await renderInvitations();
+    } catch (err) {
+      showError(err);
+    }
+  });
+  document.querySelector("#copy-link").addEventListener("click", async () => {
+    try {
+      await navigator.clipboard.writeText(linkUrl.value);
+    } catch {
+      linkUrl.select();
+      document.execCommand("copy");
+    }
+  });
+}
+
+/** Draws who the list is shared with (and, for its owner, the invitations); returns the members. */
+export async function showSharing(list) {
+  const changed = list.id !== current?.id;
+  current = list;
+  badge.textContent = list.role === "owner" ? "" : `(you are ${list.role === "editor" ? "an editor" : "a viewer"})`;
+  ownerPart.hidden = list.role !== "owner";
+  if (changed) {
+    linkBox.hidden = true;
+    linkUrl.value = "";
+  }
+  const [people] = await Promise.all([renderMembers(), list.role === "owner" ? renderInvitations() : undefined]);
+  return people;
+}
+
+async function renderMembers() {
+  const people = await api(`/api/lists/${current.id}/members`);
+  members.replaceChildren(
+    ...people.map((person) => {
+      const item = element("li", {}, element("span", { className: "name", textContent: person.username }), element("span", { className: "role", textContent: person.role }));
+      if (current.role === "owner" && person.role !== "owner") {
+        const remove = element("button", { type: "button", textContent: "Remove" });
+        remove.addEventListener("click", async () => {
+          if (!confirm(`Remove ${person.username} from "${current.name}"?`)) return;
+          try {
+            await api(`/api/lists/${current.id}/members/${person.id}`, { method: "DELETE" });
+            await onChange();
+          } catch (err) {
+            showError(err);
+          }
+        });
+        item.append(remove);
+      }
+      return item;
+    }),
+  );
+  return people;
+}
+
+async function renderInvitations() {
+  const pending = await api(`/api/lists/${current.id}/invitations`);
+  invitations.replaceChildren(
+    ...(pending.length === 0 ? [element("li", { textContent: "None" })] : pending.map(invitationItem)),
+  );
+}
+
+function invitationItem(invitation) {
+  const revoke = element("button", { type: "button", textContent: "Revoke" });
+  revoke.addEventListener("click", async () => {
+    try {
+      await api(`/api/lists/${current.id}/invitations/${invitation.id}`, { method: "DELETE" });
+      await renderInvitations();
+    } catch (err) {
+      showError(err);
+    }
+  });
+  return element(
+    "li",
+    {},
+    element("span", { className: "role", textContent: invitation.role }),
+    element("span", { textContent: `expires ${new Date(invitation.expires_at).toLocaleString()}` }),
+    revoke,
+  );
+}
