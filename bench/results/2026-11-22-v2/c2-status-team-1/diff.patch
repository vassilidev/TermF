+const STATUS_ERROR = "status must be todo, doing or done";
+const DONE_ERROR = "done must be true or false";
+
+const isStatus = (value: unknown): value is tasks.Status => tasks.STATUSES.includes(value as tasks.Status);
+
+/** The status a body asks for: `status` wins over the deprecated `done` (true is "done", false is "todo"). */
+function statusFromBody(body: any): { status?: tasks.Status } | { error: string } {
+  const hasStatus = Object.hasOwn(body, "status");
+  if (hasStatus && !isStatus(body.status)) return { error: STATUS_ERROR };
+  const hasDone = Object.hasOwn(body, "done");
+  if (hasDone && typeof body.done !== "boolean") return { error: DONE_ERROR };
+  if (hasStatus) return { status: body.status };
+  if (hasDone) return { status: body.done ? "done" : "todo" };
+  return {};
+}
+
 async function readJson(req: any): Promise<any> {
   let text = "";
   for await (const chunk of req) text += chunk;
   return text ? JSON.parse(text) : {};
 }
