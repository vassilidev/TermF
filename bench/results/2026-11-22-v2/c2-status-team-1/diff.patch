+
 export interface Task {
   id: number;
   title: string;
+  status: Status;
+  /** Deprecated, kept for one release: true exactly when `status` is "done". */
   done: boolean;
   created_at: string;
 }
 
 interface Row {
   id: number;
   title: string;
-  done: number;
+  status: Status;
   created_at: string;
 }
 
-const toTask = (row: Row): Task => ({ ...row, done: row.done === 1 });
+const toTask = (row: Row): Task => ({
+  id: row.id,
+  title: row.title,
+  status: row.status,
+  done: row.status === "done",
+  created_at: row.created_at,
