+/** Trims and lowercases a tag name; undefined when it is not a string or not a valid tag afterwards. */
+export function normalizeTag(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const name = value.trim().toLowerCase();
+  return TAG_PATTERN.test(name) ? name : undefined;
+}
+
+/** The normalized, deduplicated, sorted tags, or undefined when `value` is not a valid list of tags. */
+export function normalizeTags(value: unknown): string[] | undefined {
+  if (!Array.isArray(value)) return undefined;
+  const names = new Set<string>();
+  for (const item of value) {
+    const name = normalizeTag(item);
+    if (name === undefined) return undefined;
+    names.add(name);
+  }
+  if (names.size > MAX_TAGS) return undefined;
+  return [...names].sort();
+}
+
+function toTasks(db: Db, rows: Row[]): Task[] {
+  const tagsByTask = new Map<number, string[]>();
+  const links = db
+    .prepare("SELECT task_tags.task_id AS task_id, tags.name AS name FROM task_tags JOIN tags ON tags.id = task_tags.tag_id")
+    .all() as { task_id: number; name: string }[];
+  for (const { task_id, name } of links) {
+    const names = tagsByTask.get(task_id);
+    if (names) names.push(name);
+    else tagsByTask.set(task_id, [name]);
+  }
+  return rows.map((row) => ({
+    ...row,
+    done: row.done === 1,
+    tags: (tagsByTask.get(row.id) ?? []).sort(),
+  }));
+}
+
+/** `done` is "true" or "false" (anything else is ignored); `tag` is a tag name, normalized here. */
+export function listTasks(db: Db, filter: { done?: string; tag?: string } = {}): Task[] {
+  const where: string[] = [];
+  const params: (string | number)[] = [];
+  if (filter.done === "true" || filter.done === "false") {
+    where.push("tasks.done = ?");
+    params.push(filter.done === "true" ? 1 : 0);
+  }
+  if (filter.tag !== undefined) {
+    where.push(
+      "EXISTS (SELECT 1 FROM task_tags JOIN tags ON tags.id = task_tags.tag_id WHERE task_tags.task_id = tasks.id AND tags.name = ?)",
+    );
+    // An invalid name matches no task.
+    params.push(normalizeTag(filter.tag) ?? "");
   }
-  const rows = db.prepare("SELECT * FROM tasks WHERE done = ? ORDER BY id").all(filter.done ? 1 : 0) as Row[];
-  return rows.map(toTask);
+  const sql = `SELECT * FROM tasks${where.length ? ` WHERE ${where.join(" AND ")}` : ""} ORDER BY id`;
+  return toTasks(db, db.prepare(sql).all(...params) as Row[]);
+}
+
+export function listTags(db: Db): { name: string; count: number }[] {
+  return db
+    .prepare(
+      "SELECT tags.name AS name, COUNT(*) AS count FROM tags JOIN task_tags ON task_tags.tag_id = tags.id GROUP BY tags.id ORDER BY tags.name",
