   done: number;
   created_at: string;
 }
 
+/** An error the client caused: `status` and `message` go back in the response. */
+export class HttpError extends Error {
+  status: number;
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+const MAX_TITLE = 200;
+
+/** The trimmed title, or an HttpError 400 when it is missing, not a string, blank or too long. */
+export function validateTitle(title: unknown): string {
+  if (typeof title !== "string" || title.trim() === "") throw new HttpError(400, "title is required");
+  const trimmed = title.trim();
+  if (trimmed.length > MAX_TITLE) throw new HttpError(400, `title must be at most ${MAX_TITLE} characters`);
+  return trimmed;
+}
+
 const toTask = (row: Row): Task => ({ ...row, done: row.done === 1 });
 
 export function listTasks(db: Db, filter: { done?: string } = {}): Task[] {
   if (filter.done === undefined) {
     return (db.prepare("SELECT * FROM tasks ORDER BY id").all() as Row[]).map(toTask);
