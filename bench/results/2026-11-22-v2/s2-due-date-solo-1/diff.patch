+export function createTask(db: Db, title: string, dueDate: string | null = null): Task {
+  const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title, due_date) VALUES (?, ?)").run(title, dueDate);
   return getTask(db, Number(lastInsertRowid))!;
 }
 
