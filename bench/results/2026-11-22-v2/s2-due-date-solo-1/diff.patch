+  db.exec("PRAGMA user_version = 1");
+  db.exec("INSERT INTO tasks (title) VALUES ('old')");
+  migrate(db);
+  assert.equal((db.prepare("SELECT due_date FROM tasks").get() as any).due_date, null);
