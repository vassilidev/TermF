+
+test("PATCH sets, keeps and clears the due date", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Pay rent" });
+  const id = created.body.id;
+  assert.equal((await call("PATCH", `/api/tasks/${id}`, { due_date: "2024-02-29" })).body.due_date, "2024-02-29");
+  const kept = await call("PATCH", `/api/tasks/${id}`, { done: true });
+  assert.equal(kept.body.due_date, "2024-02-29");
+  const cleared = await call("PATCH", `/api/tasks/${id}`, { due_date: null });
+  assert.equal(cleared.status, 200);
+  assert.equal(cleared.body.due_date, null);
+});
+
+test("an invalid due date is a 400 and nothing is saved", async () => {
+  const error = { error: "due_date must be a date in YYYY-MM-DD format" };
+  const bad = ["2026-1-5", "tomorrow", "2026-02-30", "2025-02-29", "2026-13-01", "2026-00-10", "2026-01-00", 20260105, true, ""];
+  for (const due_date of bad) {
+    const res = await call("POST", "/api/tasks", { title: "Bad date", due_date });
+    assert.equal(res.status, 400, JSON.stringify(due_date));
+    assert.deepEqual(res.body, error);
+  }
+  const before = (await call("GET", "/api/tasks")).body.length;
+  await call("POST", "/api/tasks", { title: "Bad date", due_date: "2026-02-30" });
+  assert.equal((await call("GET", "/api/tasks")).body.length, before);
+
+  const created = await call("POST", "/api/tasks", { title: "Keep me", due_date: "2026-05-01" });
+  const patched = await call("PATCH", `/api/tasks/${created.body.id}`, { title: "Changed", due_date: "2026-02-30" });
+  assert.equal(patched.status, 400);
+  assert.deepEqual(patched.body, error);
+  const read = await call("GET", `/api/tasks/${created.body.id}`);
+  assert.equal(read.body.title, "Keep me");
+  assert.equal(read.body.due_date, "2026-05-01");
+});
