@@ -69,5 +69,63 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+test("a task has no due date by default", async () => {
+  const created = await call("POST", "/api/tasks", { title: "No rush" });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.due_date, null);
+});
+
+test("creates a task with a due date", async () => {
+  const created = await call("POST", "/api/tasks", { title: "File taxes", due_date: "2026-04-15" });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.due_date, "2026-04-15");
