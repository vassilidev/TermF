+/** An error whose message is safe to show to the client. */
+class HttpError extends Error {
+  status: number;
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+const MAX_TITLE = 200;
+
+/** Checks a title from a request body and returns it trimmed. */
+function validTitle(value: unknown): string {
+  const title = typeof value === "string" ? value.trim() : "";
+  if (!title) throw new HttpError(400, "title is required");
+  if (title.length > MAX_TITLE) throw new HttpError(400, `title must be at most ${MAX_TITLE} characters`);
+  return title;
+}
+
 /** The HTTP server of the app, not listening yet. `dbPath` is a SQLite file, or `:memory:`. */
 export function createServer(dbPath = ":memory:") {
   const db = openDb(dbPath);
   const server = createHttpServer((req: any, res: any) => {
-    handle(db, req, res).catch((err: Error) => send(res, 500, { error: err.message }));
+    handle(db, req, res).catch((err: unknown) => {
+      if (err instanceof HttpError) return send(res, err.status, { error: err.message });
+      console.error(err);
+      send(res, 500, { error: "internal error" });
+    });
   });
   server.on("close", () => db.close());
   return server;
 }
 
