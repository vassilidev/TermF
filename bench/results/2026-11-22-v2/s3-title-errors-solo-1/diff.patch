diff --git a/test/tasks.test.ts b/test/tasks.test.ts
index 1fa1bd8..d69964c 100644
--- a/test/tasks.test.ts
+++ b/test/tasks.test.ts
@@ -69,5 +69,91 @@ test("lists only the done tasks with ?done=true", async () => {
 test("serves the page", async () => {
   const res = await fetch(base + "/");
   assert.equal(res.status, 200);
   assert.match(await res.text(), /<h1>Tasks<\/h1>/);
 });
+
+async function raw(method: string, path: string, body: string) {
+  const res = await fetch(base + path, { method, headers: { "content-type": "application/json" }, body });
+  return { status: res.status, body: await res.json() };
+}
+
+async function count() {
+  return (await call("GET", "/api/tasks")).body.length;
+}
+
+test("creating a task without a usable title is a 400 and creates nothing", async () => {
+  const before = await count();
+  for (const body of [{}, { title: "" }, { title: "   " }, { title: 42 }, { title: null }, { title: ["a"] }]) {
+    const res = await call("POST", "/api/tasks", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  assert.equal(await count(), before);
+});
+
+test("a title is saved trimmed", async () => {
+  const res = await call("POST", "/api/tasks", { title: "  Water the plants  " });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.title, "Water the plants");
+});
+
+test("a title of 200 characters is accepted, 201 is not", async () => {
+  const ok = await call("POST", "/api/tasks", { title: " " + "a".repeat(200) + " " });
+  assert.equal(ok.status, 201);
+  const before = await count();
+  const tooLong = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(tooLong.status, 400);
+  assert.deepEqual(tooLong.body, { error: "title must be at most 200 characters" });
+  assert.equal(await count(), before);
+});
+
+test("updating with a bad title is a 400 and keeps the task", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Keep me" });
+  const path = `/api/tasks/${created.body.id}`;
+  for (const title of ["", "  ", 5, null]) {
+    const res = await call("PATCH", path, { title });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "title is required" });
+  }
+  const tooLong = await call("PATCH", path, { title: "a".repeat(201) });
+  assert.equal(tooLong.status, 400);
+  assert.deepEqual(tooLong.body, { error: "title must be at most 200 characters" });
+  assert.equal((await call("GET", path)).body.title, "Keep me");
+});
+
+test("updating without a title leaves it alone, and trims a new one", async () => {
+  const created = await call("POST", "/api/tasks", { title: "Same" });
+  const path = `/api/tasks/${created.body.id}`;
+  assert.equal((await call("PATCH", path, { done: true })).body.title, "Same");
+  assert.equal((await call("PATCH", path, { title: "  New  " })).body.title, "New");
+});
+
+test("a body that is not JSON is a 400", async () => {
+  for (const [method, path] of [["POST", "/api/tasks"], ["PATCH", "/api/tasks/1"]]) {
+    for (const body of ["{nope", "null", "[1]"]) {
+      const res = await raw(method, path, body);
+      assert.equal(res.status, 400, `${method} ${body}`);
+      assert.deepEqual(res.body, { error: "invalid JSON body" });
+    }
+  }
+});
+
+test("an unexpected error is a 500 that hides the internal message", async () => {
+  const original = console.error;
+  const logged: unknown[][] = [];
+  console.error = (...args: unknown[]) => void logged.push(args);
+  const broken = createServer();
+  try {
+    await new Promise<void>((resolve) => broken.listen(0, "127.0.0.1", resolve));
+    // Emitting "close" closes the database while the server keeps answering, so every query fails.
+    broken.emit("close");
+    const res = await fetch(`http://127.0.0.1:${(broken.address() as any).port}/api/tasks`);
+    assert.equal(res.status, 500);
+    assert.deepEqual(await res.json(), { error: "internal error" });
+    assert.equal(logged.length, 1);
+  } finally {
+    console.error = original;
+    broken.removeAllListeners("close"); // the database is already closed
+    broken.close();
+  }
+});
