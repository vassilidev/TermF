diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..e292422
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,97 @@
+import { randomBytes, scrypt, timingSafeEqual, createHash } from "node:crypto";
+import { promisify } from "node:util";
+import type { Db } from "./db.ts";
+
+const scryptAsync: (password: string, salt: any, keylen: number) => Promise<any> = promisify(scrypt);
+
+const KEY_LENGTH = 64;
+const SESSION_LIFETIME_MS = 30 * 24 * 60 * 60 * 1000;
+
+export const USERNAME_PATTERN = /^[a-z0-9_]{3,32}$/;
+export const MIN_PASSWORD_LENGTH = 10;
+// scrypt costs memory and time per call: an unbounded password would be a cheap way to hurt the server.
+export const MAX_PASSWORD_LENGTH = 256;
+
+export interface User {
+  id: number;
+  username: string;
+}
+
+/** Salted scrypt hash, stored as `<salt hex>:<hash hex>`. */
+export async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  const hash = await scryptAsync(password, salt, KEY_LENGTH);
+  return `${salt.toString("hex")}:${hash.toString("hex")}`;
+}
+
+/** Constant-time comparison of a password with a stored hash. */
+export async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const [saltHex, hashHex] = stored.split(":");
+  const expected = Buffer.from(hashHex, "hex");
+  const actual = await scryptAsync(password, Buffer.from(saltHex, "hex"), expected.length);
+  return timingSafeEqual(actual, expected);
+}
+
+// Checked against when the username is unknown, so that both failures cost the same time.
+const dummyHash = hashPassword("no such user");
+
+export type CreateResult = { user: User } | { error: "taken" };
+
+export async function createUser(db: Db, username: string, password: string): Promise<CreateResult> {
+  const passwordHash = await hashPassword(password);
+  // From here on nothing awaits, so the check and the insert cannot interleave with another sign-up.
+  if (db.prepare("SELECT 1 FROM users WHERE username = ?").get(username)) return { error: "taken" };
+  try {
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO users (username, password_hash) VALUES (?, ?)")
+      .run(username, passwordHash);
+    return { user: { id: Number(lastInsertRowid), username } };
+  } catch (err) {
+    if (db.prepare("SELECT 1 FROM users WHERE username = ?").get(username)) return { error: "taken" };
+    throw err;
+  }
+}
+
+/** The user for these credentials, or undefined: the caller must not tell the two failures apart. */
+export async function checkCredentials(db: Db, username: string, password: string): Promise<User | undefined> {
+  const row = db.prepare("SELECT id, username, password_hash FROM users WHERE username = ?").get(username) as
+    | { id: number; username: string; password_hash: string }
+    | undefined;
+  const ok = await verifyPassword(password, row ? row.password_hash : await dummyHash);
+  return row && ok ? { id: row.id, username: row.username } : undefined;
+}
+
+const hashToken = (token: string): string => createHash("sha256").update(token).digest("hex");
+
+/** Opens a session and returns its token. Only the SHA-256 of the token is stored. */
+export function createSession(db: Db, userId: number): string {
+  const token = randomBytes(32).toString("base64url");
+  const now = Date.now();
+  db.prepare("DELETE FROM sessions WHERE expires_at <= ?").run(now);
+  db.prepare("INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)").run(
+    hashToken(token),
+    userId,
+    now + SESSION_LIFETIME_MS,
+  );
+  return token;
+}
+
+/** The token of an `Authorization: Bearer <token>` header, or undefined if absent or malformed. */
+export function bearerToken(header: unknown): string | undefined {
+  if (typeof header !== "string") return undefined;
+  return /^Bearer ([A-Za-z0-9_-]{16,128})$/i.exec(header)?.[1];
+}
+
+export function userForToken(db: Db, token: string): User | undefined {
+  return db
+    .prepare(
+      `SELECT users.id AS id, users.username AS username FROM sessions
+       JOIN users ON users.id = sessions.user_id
+       WHERE sessions.token_hash = ? AND sessions.expires_at > ?`,
+    )
+    .get(hashToken(token), Date.now()) as User | undefined;
+}
+
+export function deleteSession(db: Db, token: string): void {
+  db.prepare("DELETE FROM sessions WHERE token_hash = ?").run(hashToken(token));
+}
