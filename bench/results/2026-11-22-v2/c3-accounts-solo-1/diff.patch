+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { startServer } from "./helpers.ts";
+
+const PASSWORD = "correct horse battery";
+let app: Awaited<ReturnType<typeof startServer>>;
+const call: typeof app.call = (...args) => app.call(...args);
+
+before(async () => {
+  app = await startServer();
+});
+
+after(() => app.close());
+
+test("signs up: 201 with the id and the username, nothing else", async () => {
+  const res = await call("POST", "/api/users", { username: "bob", password: PASSWORD });
+  assert.equal(res.status, 201);
+  assert.deepEqual(Object.keys(res.body).sort(), ["id", "username"]);
+  assert.equal(typeof res.body.id, "number");
+  assert.equal(res.body.username, "bob");
+});
+
+test("lowercases the username, and refuses one taken in any case", async () => {
+  const res = await call("POST", "/api/users", { username: "Carol_1", password: PASSWORD });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.username, "carol_1");
+  for (const name of ["carol_1", "CAROL_1", "Carol_1"]) {
+    const again = await call("POST", "/api/users", { username: name, password: PASSWORD });
+    assert.equal(again.status, 409);
+    assert.deepEqual(again.body, { error: "username taken" });
+  }
+});
+
+test("refuses an invalid username", async () => {
+  const bad: unknown[] = ["ab", "a".repeat(33), "has space", "dash-ed", "é_accent", "dot.dot", "", undefined, null, 42, ["abc"]];
+  for (const username of bad) {
+    const res = await call("POST", "/api/users", { username, password: PASSWORD });
+    assert.equal(res.status, 400, JSON.stringify(username));
+    assert.deepEqual(res.body, { error: "invalid username" });
+  }
+  assert.equal((await call("POST", "/api/users", { username: "abc", password: PASSWORD })).status, 201);
+  assert.equal((await call("POST", "/api/users", { username: "a".repeat(32), password: PASSWORD })).status, 201);
+});
+
+test("refuses a short or missing password", async () => {
+  for (const password of ["123456789", "", undefined, 1234567890]) {
+    const res = await call("POST", "/api/users", { username: "shorty", password });
+    assert.equal(res.status, 400);
+    assert.deepEqual(res.body, { error: "password too short" });
+  }
+  assert.equal((await call("POST", "/api/users", { username: "shorty", password: "1234567890" })).status, 201);
+});
+
+test("refuses a malformed body with a 400", async () => {
+  const res = await fetch(app.base + "/api/users", { method: "POST", body: "{nope" });
+  assert.equal(res.status, 400);
+  const array = await fetch(app.base + "/api/users", { method: "POST", body: "[]" });
+  assert.equal(array.status, 400);
+});
+
+test("signs in with any case of the username; a token is opaque and random", async () => {
+  await call("POST", "/api/users", { username: "dave", password: PASSWORD });
+  const first = await call("POST", "/api/sessions", { username: "Dave", password: PASSWORD });
+  const second = await call("POST", "/api/sessions", { username: "dave", password: PASSWORD });
+  assert.equal(first.status, 201);
+  assert.deepEqual(Object.keys(first.body), ["token"]);
+  assert.match(first.body.token, /^[A-Za-z0-9_-]{43,}$/);
+  assert.notEqual(first.body.token, second.body.token);
+});
+
+test("a wrong username and a wrong password get the same 401", async () => {
+  await call("POST", "/api/users", { username: "erin", password: PASSWORD });
+  const wrongPassword = await call("POST", "/api/sessions", { username: "erin", password: "wrong password!" });
+  const wrongUser = await call("POST", "/api/sessions", { username: "nobody", password: PASSWORD });
+  const malformed = await call("POST", "/api/sessions", { username: 1, password: {} });
+  for (const res of [wrongPassword, wrongUser, malformed]) {
+    assert.equal(res.status, 401);
+    assert.deepEqual(res.body, { error: "invalid credentials" });
+  }
+});
+
+test("every task route needs a valid bearer token", async () => {
+  const routes: [string, string, unknown?][] = [
+    ["GET", "/api/tasks"],
+    ["POST", "/api/tasks", { title: "x" }],
+    ["GET", "/api/tasks/1"],
+    ["PATCH", "/api/tasks/1", { done: true }],
+    ["DELETE", "/api/tasks/1"],
+  ];
+  const headers: (string | undefined)[] = [
+    undefined,
+    "",
+    "Bearer",
+    "Bearer ",
+    "Basic dXNlcjpwYXNz",
+    "Bearer not-a-known-token-but-long-enough",
+    "Bearer a b",
+    "Token abcdefghijklmnopqrstuvwxyz",
+  ];
+  for (const [method, path, body] of routes) {
+    for (const authorization of headers) {
+      const res = await fetch(app.base + path, {
+        method,
+        headers: { ...(authorization === undefined ? {} : { authorization }), "content-type": "application/json" },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+      assert.equal(res.status, 401, `${method} ${path} [${authorization}]`);
+      assert.deepEqual(await res.json(), { error: "authentication required" });
+    }
+  }
+});
+
+test("users see and change only their own tasks", async () => {
+  const alice = await app.signUp("iso_alice");
+  const mallory = await app.signUp("iso_mallory");
+  const task = await call("POST", "/api/tasks", { title: "Alice's secret" }, alice);
+  assert.equal(task.status, 201);
+  const path = `/api/tasks/${task.body.id}`;
+
+  assert.deepEqual((await call("GET", "/api/tasks", undefined, mallory)).body, []);
+  assert.equal((await call("GET", "/api/tasks?done=false", undefined, mallory)).body.length, 0);
+
+  const missing = await call("GET", "/api/tasks/999999", undefined, mallory);
+  assert.equal(missing.status, 404);
+  for (const [method, body] of [["GET"], ["PATCH", { title: "pwned", done: true }], ["DELETE"]] as [string, unknown?][]) {
+    const res = await call(method, path, body, mallory);
+    assert.equal(res.status, 404, method);
+    assert.deepEqual(res.body, { error: "task not found" });
+    assert.deepEqual(res.body, missing.body);
+  }
+
+  const intact = await call("GET", path, undefined, alice);
+  assert.equal(intact.status, 200);
+  assert.equal(intact.body.title, "Alice's secret");
+  assert.equal(intact.body.done, false);
+  assert.ok(!("user_id" in intact.body));
+  assert.equal((await call("GET", "/api/tasks", undefined, alice)).body.length, 1);
+});
+
+test("signing out ends the session, and only that one", async () => {
+  await call("POST", "/api/users", { username: "frank", password: PASSWORD });
+  const one = (await call("POST", "/api/sessions", { username: "frank", password: PASSWORD })).body.token;
+  const two = (await call("POST", "/api/sessions", { username: "frank", password: PASSWORD })).body.token;
+  assert.equal((await call("GET", "/api/tasks", undefined, one)).status, 200);
+
+  const out = await call("DELETE", "/api/sessions", undefined, one);
+  assert.equal(out.status, 204);
+  const after = await call("GET", "/api/tasks", undefined, one);
+  assert.equal(after.status, 401);
+  assert.deepEqual(after.body, { error: "authentication required" });
+  assert.equal((await call("GET", "/api/tasks", undefined, two)).status, 200);
+
+  assert.equal((await call("DELETE", "/api/sessions", undefined, one)).status, 401);
+  assert.equal((await call("DELETE", "/api/sessions")).status, 401);
+});
+
+test("no response contains a password or a hash", async () => {
+  const password = "tr4ceable-secret-pw";
+  const created = await call("POST", "/api/users", { username: "grace", password });
+  const session = await call("POST", "/api/sessions", { username: "grace", password });
+  const tasks = await call("GET", "/api/tasks", undefined, session.body.token);
+  for (const res of [created, session, tasks]) {
+    const text = JSON.stringify(res.body);
+    assert.ok(!text.includes(password));
+    assert.ok(!/hash|password/i.test(text));
+  }
+});
+
+test("a body that is too large is refused", async () => {
+  const res = await fetch(app.base + "/api/users", {
+    method: "POST",
+    body: JSON.stringify({ username: "huge", password: "x".repeat(100_000) }),
+  });
+  assert.equal(res.status, 413);
+});
+
+test("stores a salted scrypt hash and only the hash of a token; old tasks are invisible", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "tasks-test-"));
+  const file = join(dir, "tasks.db");
+  try {
+    // A database from before accounts: only the first migration applied, with a task in it.
+    const old = new DatabaseSync(file);
+    old.exec(`CREATE TABLE tasks (
+      id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0,
+      created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')))`);
+    old.exec("PRAGMA user_version = 1");
+    old.prepare("INSERT INTO tasks (title) VALUES (?)").run("Before accounts");
+    old.close();
+
+    const local = await startServer(file);
+    try {
+      const token = await local.signUp("henry");
+      assert.deepEqual((await local.call("GET", "/api/tasks", undefined, token)).body, []);
+      assert.equal((await local.call("GET", "/api/tasks/1", undefined, token)).status, 404);
+      assert.equal((await local.call("DELETE", "/api/tasks/1", undefined, token)).status, 404);
+    } finally {
+      local.close();
+    }
+
+    const db = new DatabaseSync(file);
+    const user = db.prepare("SELECT * FROM users WHERE username = 'henry'").get() as any;
+    assert.match(user.password_hash, /^[0-9a-f]{32}:[0-9a-f]{128}$/);
+    assert.ok(!user.password_hash.includes(PASSWORD));
+    const sessions = db.prepare("SELECT token_hash FROM sessions").all() as any[];
+    assert.equal(sessions.length, 1);
+    assert.match(sessions[0].token_hash, /^[0-9a-f]{64}$/);
+    assert.equal(db.prepare("SELECT title FROM tasks WHERE user_id IS NULL").all().length, 1);
+    db.close();
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("hashing is salted and verification checks the password", async () => {
+  const { hashPassword, verifyPassword } = await import("../src/auth.ts");
+  const a = await hashPassword(PASSWORD);
+  const b = await hashPassword(PASSWORD);
+  assert.notEqual(a, b);
+  assert.ok(await verifyPassword(PASSWORD, a));
+  assert.ok(!(await verifyPassword(PASSWORD + "!", a)));
+});
