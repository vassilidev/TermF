@@ -0,0 +1,35 @@
+import { createServer } from "../src/app.ts";
+
+export interface Reply {
+  status: number;
+  body: any;
+}
+
+/** A server on a random port with an in-memory database (or `dbPath`), and a way to call it. */
+export async function startServer(dbPath = ":memory:") {
+  const server: any = createServer(dbPath);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const base = `http://127.0.0.1:${server.address().port}`;
+
+  async function call(method: string, path: string, body?: unknown, token?: string): Promise<Reply> {
+    const headers: Record<string, string> = {};
+    if (body !== undefined) headers["content-type"] = "application/json";
+    if (token !== undefined) headers.authorization = `Bearer ${token}`;
+    const res = await fetch(base + path, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    return { status: res.status, body: res.status === 204 ? null : await res.json() };
+  }
+
+  /** Creates an account and signs in: the token. */
+  async function signUp(username: string, password = "correct horse battery"): Promise<string> {
+    const created = await call("POST", "/api/users", { username, password });
+    if (created.status !== 201) throw new Error(`sign-up failed: ${created.status}`);
+    const session = await call("POST", "/api/sessions", { username, password });
+    return session.body.token;
+  }
+
+  return { server, base, call, signUp, close: () => server.close() };
+}
