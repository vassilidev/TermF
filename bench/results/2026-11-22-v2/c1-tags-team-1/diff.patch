+  const created = await call("POST", "/api/tasks", { title: "Limits", tags: [...tags, tags[0].toUpperCase()] });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.tags.length, 10);
+});
+
+test("?tag= lists only the tasks with that tag, normalized, and combines with done", async () => {
+  await withApp(async (api) => {
+    const a = await api("POST", "/api/tasks", { title: "A", tags: ["home", "work"] });
+    const b = await api("POST", "/api/tasks", { title: "B", tags: ["home"] });
+    await api("POST", "/api/tasks", { title: "C", tags: ["work"] });
+    await api("POST", "/api/tasks", { title: "D" });
+    await api("PATCH", `/api/tasks/${b.body.id}`, { done: true });
+    const ids = async (query: string) => (await api("GET", `/api/tasks${query}`)).body.map((t: any) => t.title);
+    assert.deepEqual(await ids("?tag=home"), ["A", "B"]);
+    assert.deepEqual(await ids("?tag=%20HOME%20"), ["A", "B"]);
+    assert.deepEqual(await ids("?tag=home&done=true"), ["B"]);
+    assert.deepEqual(await ids("?tag=home&done=false"), ["A"]);
+    assert.deepEqual(await ids("?tag=work&done=true"), []);
+    assert.deepEqual(await ids("?tag=nope"), []);
+    assert.deepEqual(await ids("?tag=not%20valid"), []);
+    assert.deepEqual(await ids("?tag="), []);
+    assert.deepEqual((await api("GET", "/api/tasks?tag=home")).body[0].tags, ["home", "work"]);
+    assert.equal(a.status, 201);
+  });
+});
+
+test("?done=false lists the open tasks and ?done=true the done ones", async () => {
+  await withApp(async (api) => {
+    const open = await api("POST", "/api/tasks", { title: "Open" });
+    const done = await api("POST", "/api/tasks", { title: "Done" });
+    await api("PATCH", `/api/tasks/${done.body.id}`, { done: true });
+    assert.deepEqual((await api("GET", "/api/tasks?done=false")).body.map((t: any) => t.id), [open.body.id]);
+    assert.deepEqual((await api("GET", "/api/tasks?done=true")).body.map((t: any) => t.id), [done.body.id]);
+    assert.equal((await api("GET", "/api/tasks")).body.length, 2);
+  });
+});
+
+test("?done= with another value is a 400", async () => {
+  const res = await call("GET", "/api/tasks?done=maybe");
+  assert.equal(res.status, 400);
+  assert.deepEqual(res.body, { error: "invalid done" });
+});
