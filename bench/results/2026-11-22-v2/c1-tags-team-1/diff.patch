+test("opening a database file made by the first release adds the tag tables and keeps its tasks", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "tasks-v1-"));
+  const path = join(dir, "v1.db");
+  try {
+    // The schema exactly as the first release shipped it (user_version 1).
+    const old = new DatabaseSync(path);
+    old.exec(`CREATE TABLE tasks (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      title TEXT NOT NULL,
+      done INTEGER NOT NULL DEFAULT 0,
+      created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+    )`);
+    old.exec("INSERT INTO tasks (title, done) VALUES ('Old task', 1)");
+    old.exec("PRAGMA user_version = 1");
+    old.close();
+
+    const app = createServer(path);
+    await new Promise<void>((resolve) => app.listen(0, "127.0.0.1", resolve));
+    const root = `http://127.0.0.1:${(app.address() as any).port}`;
+    try {
+      const list = await (await fetch(`${root}/api/tasks`)).json();
+      assert.equal(list.length, 1);
+      assert.equal(list[0].title, "Old task");
+      assert.equal(list[0].done, true);
+      assert.deepEqual(list[0].tags, []);
+      const patched = await fetch(`${root}/api/tasks/${list[0].id}`, {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ tags: ["Legacy"] }),
+      });
+      assert.deepEqual((await patched.json()).tags, ["legacy"]);
+    } finally {
+      await new Promise<void>((resolve) => app.close(() => resolve()));
+    }
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
