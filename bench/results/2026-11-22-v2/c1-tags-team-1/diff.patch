+test("GET /api/tags counts the tasks per tag, sorted by name, and drops unused tags", async () => {
+  await withApp(async (api) => {
+    assert.deepEqual((await api("GET", "/api/tags")).body, []);
+    const a = await api("POST", "/api/tasks", { title: "A", tags: ["work", "home"] });
+    const b = await api("POST", "/api/tasks", { title: "B", tags: ["home"] });
+    assert.deepEqual((await api("GET", "/api/tags")).body, [
+      { name: "home", count: 2 },
+      { name: "work", count: 1 },
+    ]);
+    await api("PATCH", `/api/tasks/${a.body.id}`, { tags: ["home"] });
+    assert.deepEqual((await api("GET", "/api/tags")).body, [{ name: "home", count: 2 }]);
+    assert.equal((await api("DELETE", `/api/tasks/${b.body.id}`)).status, 204);
+    assert.deepEqual((await api("GET", "/api/tags")).body, [{ name: "home", count: 1 }]);
+    await api("PATCH", `/api/tasks/${a.body.id}`, { tags: [] });
+    assert.deepEqual((await api("GET", "/api/tags")).body, []);
+    assert.equal((await api("POST", "/api/tags", {})).status, 405);
+  });
+});
