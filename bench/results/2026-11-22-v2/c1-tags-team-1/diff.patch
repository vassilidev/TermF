+/** Replaces the links of a task with `tags` (already normalized). Run inside a transaction. */
+function setTags(db: Db, taskId: number, tags: string[]): void {
+  db.prepare("DELETE FROM task_tags WHERE task_id = ?").run(taskId);
+  const insertTag = db.prepare("INSERT OR IGNORE INTO tags (name) VALUES (?)");
+  const insertLink = db.prepare("INSERT INTO task_tags (task_id, tag_id) SELECT ?, id FROM tags WHERE name = ?");
+  for (const tag of tags) {
+    insertTag.run(tag);
+    insertLink.run(taskId, tag);
+  }
+}
+
+function inTransaction<T>(db: Db, work: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = work();
+    db.exec("COMMIT");
+    return result;
+  } catch (err) {
+    db.exec("ROLLBACK");
+    throw err;
+  }
