+export function createTask(db: Db, title: string, tags: string[] = []): Task {
+  const id = inTransaction(db, () => {
+    const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title) VALUES (?)").run(title);
+    setTags(db, Number(lastInsertRowid), tags);
+    return Number(lastInsertRowid);
+  });
+  return getTask(db, id)!;
+}
+
+/** `tags`, when given, replaces the whole list and must be normalized; when undefined the tags are left alone. */
+export function updateTask(
+  db: Db,
+  id: number,
+  changes: { title?: string; done?: boolean; tags?: string[] },
+): Task | undefined {
