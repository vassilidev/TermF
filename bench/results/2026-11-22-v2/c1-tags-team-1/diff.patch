+test("deleting a task removes its links to tags", async () => {
+  await withApp(async (api, db) => {
+    const created = await api("POST", "/api/tasks", { title: "Gone", tags: ["a", "b"] });
+    const count = () => (db.prepare("SELECT COUNT(*) AS n FROM task_tags").get() as { n: number }).n;
+    assert.equal(count(), 2);
+    await api("DELETE", `/api/tasks/${created.body.id}`);
+    assert.equal(count(), 0);
+  });
+});
