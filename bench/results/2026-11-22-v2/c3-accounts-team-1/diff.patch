+      const sessions = db.prepare("SELECT * FROM sessions").all() as any[];
+      assert.equal(sessions.length, 1);
+      assert.equal(sessions[0].token_hash, createHash("sha256").update(token).digest("hex"));
+
+      // no column of any table holds the password or the raw token
+      const tables = (db.prepare("SELECT name FROM sqlite_master WHERE type = 'table'").all() as any[]).map((t) => t.name);
+      for (const table of tables) {
