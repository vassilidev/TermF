+});
+
+// ---- AC7: tasks that predate accounts ----
+
+test("tasks created before accounts stay in the database and no user sees them", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "accounts-"));
+  const path = join(dir, "old.db");
+  // a database as the first release left it
+  const old = new DatabaseSync(path);
+  old.exec(`CREATE TABLE tasks (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    title TEXT NOT NULL,
+    done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
+  )`);
+  old.exec("PRAGMA user_version = 1");
+  old.prepare("INSERT INTO tasks (title, done) VALUES (?, ?)").run("legacy task", 1);
+  old.close();
+
+  const legacy = await startServer(path);
+  try {
+    const token = await legacy.signUp("newcomer");
+    assert.deepEqual((await legacy.call("GET", "/api/tasks", undefined, token)).body, []);
+    assert.deepEqual((await legacy.call("GET", "/api/tasks?done=true", undefined, token)).body, []);
+    for (const [method, body] of [["GET", undefined], ["PATCH", { title: "mine now" }], ["DELETE", undefined]] as const) {
+      const res = await legacy.call(method, "/api/tasks/1", body, token);
+      assert.equal(res.status, 404, method);
+      assert.deepEqual(res.body, { error: "task not found" });
+    }
+    const created = await legacy.call("POST", "/api/tasks", { title: "fresh" }, token);
+    assert.equal(created.status, 201);
+    assert.deepEqual((await legacy.call("GET", "/api/tasks", undefined, token)).body.map((t: any) => t.title), ["fresh"]);
+  } finally {
+    await legacy.close();
+  }
+
+  const db = new DatabaseSync(path);
+  try {
+    const { user_version } = db.prepare("PRAGMA user_version").get() as any;
+    assert.equal(user_version, 2);
+    assert.deepEqual({ ...(db.prepare("SELECT title, done, user_id FROM tasks WHERE id = 1").get() as object) }, { title: "legacy task", done: 1, user_id: null });
+  } finally {
+    db.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
