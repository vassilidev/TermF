@@ -0,0 +1,55 @@
+import { createServer } from "../src/app.ts";
+
+export const PASSWORD = "correct horse battery";
+
+export interface Reply {
+  status: number;
+  /** The parsed JSON body, or null when there is none (204). */
+  body: any;
+  /** The body as the server sent it. */
+  text: string;
+}
+
+/** Starts the app on a free port; `dbPath` is a SQLite file or `:memory:`. */
+export async function startServer(dbPath = ":memory:") {
+  const server: any = createServer(dbPath);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const base = `http://127.0.0.1:${server.address().port}`;
+
+  async function request(
+    method: string,
+    path: string,
+    opts: { body?: unknown; raw?: string; headers?: Record<string, string> } = {},
+  ): Promise<Reply> {
+    const raw = opts.raw ?? (opts.body === undefined ? undefined : JSON.stringify(opts.body));
+    const res = await fetch(base + path, {
+      method,
+      headers: { ...(raw === undefined ? {} : { "content-type": "application/json" }), ...opts.headers },
+      body: raw,
+    });
+    const text = await res.text();
+    return { status: res.status, body: text ? JSON.parse(text) : null, text };
+  }
+
+  /** A JSON call; `token` is sent as a Bearer header. */
+  const call = (method: string, path: string, body?: unknown, token?: string) =>
+    request(method, path, { body, headers: token === undefined ? {} : { authorization: `Bearer ${token}` } });
+
+  /** Creates an account and signs in: returns the session token. */
+  async function signUp(username: string, password = PASSWORD): Promise<string> {
+    const created = await call("POST", "/api/users", { username, password });
+    if (created.status !== 201) throw new Error(`sign-up of ${username} answered ${created.status}`);
+    return signIn(username, password);
+  }
+
+  async function signIn(username: string, password = PASSWORD): Promise<string> {
+    const session = await call("POST", "/api/sessions", { username, password });
+    if (session.status !== 201) throw new Error(`sign-in of ${username} answered ${session.status}`);
+    return session.body.token;
+  }
+
+  /** Stops the server (which closes its database) and waits for it. */
+  const close = () => new Promise<void>((resolve) => server.close(() => resolve()));
+
+  return { server, base, request, call, signUp, signIn, close };
+}
