+  assert.equal(res.status, 201);
+  assert.equal(res.body.username, "grace_hopper");
+  assert.equal((await call("POST", "/api/sessions", { username: "GRACE_HOPPER", password: PASSWORD })).status, 201);
+  assert.equal((await call("POST", "/api/sessions", { username: "grace_hopper", password: PASSWORD })).status, 201);
+});
+
+test("a username taken in any case answers 409", async () => {
