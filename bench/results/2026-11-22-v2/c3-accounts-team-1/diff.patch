+    const token: string = session.body.token;
+    const created = await secure.call("POST", "/api/tasks", { title: "stored" }, token);
+    const list = await secure.call("GET", "/api/tasks", undefined, token);
+    const rejected = await secure.call("GET", "/api/tasks", undefined, token + "x");
+    const wrong = await secure.call("POST", "/api/sessions", { username: "hash_one", password: "wrong wrong wrong" });
