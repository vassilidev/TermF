+      // no response holds the password, a hash or a salt
+      const responses = [...signUps, session, created, list, rejected, wrong].map((r) => r.text).join("\n");
+      assert.ok(!responses.includes(password));
+      for (const user of users) {
+        assert.ok(!responses.includes(user.password_hash));
+        assert.ok(!responses.includes(user.password_salt));
+      }
