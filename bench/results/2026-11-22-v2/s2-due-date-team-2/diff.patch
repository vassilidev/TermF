+const DUE_DATE_ERROR = { error: "due_date must be a date in YYYY-MM-DD format" };
+
+/** Absent or null is fine; otherwise a string of exactly YYYY-MM-DD that is a real calendar day. */
+function validDueDate(value: unknown): boolean {
+  if (value === undefined || value === null) return true;
+  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [y, m, d] = value.split("-").map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  date.setUTCFullYear(y); // years 0-99 map to 1900+ in the constructor
+  return date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 && date.getUTCDate() === d;
+}
+
 async function readJson(req: any): Promise<any> {
   let text = "";
   for await (const chunk of req) text += chunk;
   return text ? JSON.parse(text) : {};
 }
