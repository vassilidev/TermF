+/** True for a string that is a real calendar date written YYYY-MM-DD. */
+export function isValidDueDate(value: unknown): value is string {
+  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [year, month, day] = value.split("-").map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  date.setUTCFullYear(year); // years 0000-0099 would otherwise map to 1900-1999
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+export function createTask(db: Db, title: string, due_date: string | null = null): Task {
+  const { lastInsertRowid } = db.prepare("INSERT INTO tasks (title, due_date) VALUES (?, ?)").run(title, due_date);
   return getTask(db, Number(lastInsertRowid))!;
 }
 
-export function updateTask(db: Db, id: number, changes: { title?: string; done?: boolean }): Task | undefined {
+export function updateTask(db: Db, id: number, changes: { title?: string; done?: boolean; due_date?: string | null }): Task | undefined {
   const task = getTask(db, id);
   if (!task) return undefined;
   const title = changes.title ?? task.title;
   const done = changes.done ?? task.done;
-  db.prepare("UPDATE tasks SET title = ?, done = ? WHERE id = ?").run(title, done ? 1 : 0, id);
+  const due_date = "due_date" in changes ? (changes.due_date ?? null) : task.due_date;
+  db.prepare("UPDATE tasks SET title = ?, done = ?, due_date = ? WHERE id = ?").run(title, done ? 1 : 0, due_date, id);
   return getTask(db, id);
 }
 
 export function deleteTask(db: Db, id: number): boolean {
   return db.prepare("DELETE FROM tasks WHERE id = ?").run(id).changes > 0;
