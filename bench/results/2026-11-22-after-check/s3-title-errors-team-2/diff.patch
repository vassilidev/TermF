+const TITLE_REQUIRED = { error: "title is required" };
+
+test("POST without a usable title is a 400 and creates nothing", async () => {
+  const before = (await call("GET", "/api/tasks")).body.length;
+  for (const body of [{}, { title: "" }, { title: "   " }, { title: 123 }, { title: null }]) {
+    const res = await call("POST", "/api/tasks", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.deepEqual(res.body, TITLE_REQUIRED);
+  }
+  assert.equal((await call("GET", "/api/tasks")).body.length, before);
+});
+
+test("title length: 201 characters is a 400, 200 is saved", async () => {
+  const long = await call("POST", "/api/tasks", { title: "a".repeat(201) });
+  assert.equal(long.status, 400);
+  assert.deepEqual(long.body, { error: "title must be at most 200 characters" });
+  const ok = await call("POST", "/api/tasks", { title: "a".repeat(200) });
+  assert.equal(ok.status, 201);
+  const padded = await call("POST", "/api/tasks", { title: ` ${"b".repeat(200)} ` });
+  assert.equal(padded.status, 201);
+});
+
+test("titles are saved trimmed", async () => {
+  const created = await call("POST", "/api/tasks", { title: "  padded " });
+  assert.equal(created.body.title, "padded");
+  const updated = await call("PATCH", `/api/tasks/${created.body.id}`, { title: "  other  " });
+  assert.equal(updated.body.title, "other");
+});
+
+test("PATCH with a bad title is a 400 and the task is unchanged", async () => {
