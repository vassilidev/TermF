+/** Returns the trimmed title, or throws a 400 HttpError. */
+export function validateTitle(value: unknown): string {
+  if (typeof value !== "string" || value.trim() === "") throw new HttpError(400, "title is required");
+  const title = value.trim();
+  if (title.length > MAX_TITLE) throw new HttpError(400, "title must be at most 200 characters");
+  return title;
+}
